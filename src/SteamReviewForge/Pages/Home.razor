        _pendingEditingMode =
            structured
                ? IsGuidedMode
                    ? ReviewEditingMode.GuidedStructured
                    : ReviewEditingMode.UnguidedStructured
                : IsGuidedMode
                    ? ReviewEditingMode.GuidedBbCode
                    : ReviewEditingMode.UnguidedBbCode;

        _showModeSwitchDialog = true;
