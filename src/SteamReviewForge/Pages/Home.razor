            : "steam-rating-star";
    }

    private async Task SetCategoryRatingAsync(
        ReviewCategory category,
        int rating)
    {
        category.Rating = Math.Clamp(
            rating,
            1,
            RatingMaximum);

        await SaveDraftImmediatelyAsync();
    }

    private async Task SetCategoryRatingFromEventAsync(
        ReviewCategory category,
        ChangeEventArgs eventArgs)
    {
        if (int.TryParse(
                eventArgs.Value?.ToString(),
                out var rating))
        {
            await SetCategoryRatingAsync(
                category,
                rating);
        }
    }

    private string GetTextRating(int rating)
    {
        var normalizedRating = Math.Clamp(
            rating,
            1,
            Math.Max(
                1,
                Draft.TextRatingOptions.Count));

        return Draft.TextRatingOptions.Count == 0
            ? "Rating"
            : Draft.TextRatingOptions[
                normalizedRating - 1];
    }

    private bool IsPositiveCategoryRating(
        ReviewCategory category)
    {
        var threshold =
            Draft.RatingSystem switch
            {
                ReviewRatingSystem.TenPoint => 8,
                ReviewRatingSystem.Text =>
                    Math.Max(
                        1,
                        (int)Math.Ceiling(
                            RatingMaximum *
                            0.7d)),
                _ => 4
            };

        return category.Rating >= threshold;
    }

    private async Task AddCategoryAsync()
