    private async Task SelectThemeAsync(
        ChangeEventArgs eventArgs)
    {
        var theme = eventArgs.Value?.ToString();

        if (string.IsNullOrWhiteSpace(theme))
        {
            return;
        }

        _appearance = await JS.InvokeAsync<AppearanceState>(
            "themeManager.setTheme",
            theme);
    }

    private async Task RestoreDraftAsync()
    {
        try
        {
            var loadResult =
                await DraftStorage.LoadAsync();

            if (loadResult.Status == DraftLoadStatus.Empty)
            {
                _saveStatus = "Not saved yet";
                _draftStorageReady = true;
                return;
            }

            if (loadResult.Status is
                DraftLoadStatus.Invalid or
                DraftLoadStatus.Unsupported)
            {
                _draftRecoveryData = loadResult.RawBackup ?? string.Empty;
                _draftRecoveryMessage = loadResult.Message ??
                    "The saved draft could not be restored.";
                _saveStatus = "Draft recovery required";
                _draftStorageReady = false;
                return;
            }

            if (loadResult.Status == DraftLoadStatus.Unavailable)
            {
                _saveStatus = "Draft storage unavailable";
                _draftStorageReady = true;
                return;
            }

            if (loadResult.Draft is null)
            {
                _saveStatus = "Not saved yet";
                _draftStorageReady = true;
                return;
            }

            Draft = loadResult.Draft;
            SelectedTemplate = Draft.Template;

            if (Draft.EditingMode ==
                ReviewEditingMode.GuidedBbCode &&
                !string.IsNullOrWhiteSpace(Draft.RawBbCode))
            {
                CurrentBbCodeStep = BbCodeStep.Composer;
            }

            _saveStatus = loadResult.Status == DraftLoadStatus.Migrated
                ? loadResult.StorageAvailable
                    ? "Draft upgraded and restored"
                    : "Draft restored; storage unavailable"
                : "Draft restored";
            _draftStorageReady = true;
        }
        catch
        {
            _saveStatus = "Draft storage unavailable";
            _draftStorageReady = true;
        }
    }

    private async Task QueueDraftSaveAsync()
    {
        if (!_draftStorageReady)
        {
            return;
        }

        var previousSave = _saveDebounce;

        _saveDebounce =
            new CancellationTokenSource();

        previousSave?.Cancel();
        previousSave?.Dispose();

        var currentSave = _saveDebounce;
        var saveRevision = ++_saveRevision;

        _saveStatus = "Saving…";
        await SetUnsavedChangesAsync(true);

        try
        {
            await Task.Delay(
                500,
                currentSave.Token);

            await DraftStorage.SaveAsync(Draft);

            if (saveRevision == _saveRevision &&
                ReferenceEquals(_saveDebounce, currentSave))
            {
                _saveStatus = "Saved";
                await SetUnsavedChangesAsync(false);
            }
        }
        catch (OperationCanceledException)
        {
            // A newer edit restarted the save delay.
        }
        catch
        {
            if (saveRevision == _saveRevision &&
                ReferenceEquals(_saveDebounce, currentSave))
            {
                _saveStatus =
                    "Draft storage unavailable";
            }
        }
    }

    private async Task SaveDraftImmediatelyAsync()
    {
        if (!_draftStorageReady)
        {
            return;
        }

        _saveDebounce?.Cancel();
        var saveRevision = ++_saveRevision;

        _saveStatus = "Saving…";
        await SetUnsavedChangesAsync(true);

        try
        {
            await DraftStorage.SaveAsync(Draft);

            if (saveRevision == _saveRevision)
            {
                _saveStatus = "Saved";
                await SetUnsavedChangesAsync(false);
            }
        }
        catch
        {
            if (saveRevision == _saveRevision)
            {
                _saveStatus =
                    "Draft storage unavailable";
            }
        }
    }

    private async Task SetUnsavedChangesAsync(bool value)
    {
        if (_hasUnsavedChanges == value)
        {
            return;
        }

        _hasUnsavedChanges = value;

        try
        {
            await JS.InvokeVoidAsync(
                "reviewDraftLifecycle.setUnsavedChanges",
                value);
        }
        catch
        {
            // Saving still proceeds when lifecycle notifications are unavailable.
        }
    }

    private async Task CopyRecoveryDataAsync()
    {
        if (_draftRecoveryData is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "clipboardManager.copyText",
                _draftRecoveryData);
            _recoveryCopyMessage = "Saved draft data copied.";
        }
        catch
        {
            _recoveryCopyMessage =
                "Copy failed. Select the backup data manually.";
        }
    }

    private async Task ResetRecoveredDraftAsync()
    {
        try
        {
            _saveRevision++;

            await DraftStorage.ClearAsync();

            Draft = new ReviewDraft();
            SelectedTemplate = Draft.Template;
            CurrentStep = BuilderStep.Setup;
            CurrentBbCodeStep = BbCodeStep.Setup;
            SelectedBbCodeTemplate = null;
            HasSelectedBbCodeStartingPoint = false;
            _draftRecoveryData = null;
            _draftRecoveryMessage = string.Empty;
            _recoveryCopyMessage = string.Empty;
            _draftStorageReady = true;
            _saveStatus = "Not saved yet";
            await SetUnsavedChangesAsync(false);
        }
        catch
        {
            _recoveryCopyMessage =
                "Unable to clear the saved draft. Your backup remains available.";
        }
    }

