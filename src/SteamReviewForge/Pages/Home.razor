    private async Task AddStructuredComponentAsync(
        StructuredComponent template)
    {
        await AddStructuredComponentAtAsync(
            template,
            Draft.Components.Count);
    }

    [JSInvokable]
    public async Task AddStructuredComponentAtAsync(
        string templateKey,
        int insertionIndex)
    {
        var template = StructuredComponents.FirstOrDefault(
            component =>
                string.Equals(
                    component.Key,
                    templateKey,
                    StringComparison.Ordinal));

        if (template is null)
        {
            return;
        }

        await AddStructuredComponentAtAsync(
            template,
            insertionIndex);

        await InvokeAsync(StateHasChanged);
    }

    private async Task AddStructuredComponentAtAsync(
        StructuredComponent template,
        int insertionIndex)
    {
        var component = new ReviewContentComponent
        {
            Kind = template.Kind,
            Heading = template.Heading,
            Content = template.Content,
            ContentFormat = ReviewTextFormat.Text,
            Rating = RatingMaximum == 10 ? 6 : 3
        };

        Draft.Components.Insert(
            Math.Clamp(
                insertionIndex,
                0,
                Draft.Components.Count),
            component);

        await SaveDraftImmediatelyAsync();
    }

