    private async Task SetCategoryRatingAsync(
        ReviewCategory category,
        int rating)
    {
        category.Rating = Math.Clamp(
            rating,
            1,
            RatingMaximum);

        await SaveDraftImmediatelyAsync();
    }

    private async Task SetCategoryRatingFromEventAsync(
        ReviewCategory category,
        ChangeEventArgs eventArgs)
    {
        if (int.TryParse(
                eventArgs.Value?.ToString(),
                out var rating))
        {
            await SetCategoryRatingAsync(
                category,
                rating);
        }
    }

    private string GetTextRating(int rating)
    {
        var normalizedRating = Math.Clamp(
            rating,
            1,
            Math.Max(
                1,
                Draft.TextRatingOptions.Count));

        return Draft.TextRatingOptions.Count == 0
            ? "Rating"
            : Draft.TextRatingOptions[
                normalizedRating - 1];
    }

    private bool IsPositiveCategoryRating(
        ReviewCategory category)
    {
        var threshold =
            Draft.RatingSystem switch
            {
                ReviewRatingSystem.TenPoint => 8,
                ReviewRatingSystem.Text =>
                    Math.Max(
                        1,
                        (int)Math.Ceiling(
                            RatingMaximum *
                            0.7d)),
                _ => 4
            };

        return category.Rating >= threshold;
    }

    private async Task AddCategoryAsync()
    {
        await AddCategoryAtAsync(
            Draft.Categories.Count);
    }

    private async Task AddStructuredComponentAsync(
        StructuredComponent template)
    {
        await AddStructuredComponentAtAsync(
            template,
            Draft.Components.Count);
    }

    [JSInvokable]
    public async Task AddStructuredComponentAtAsync(
        string templateKey,
        int insertionIndex)
    {
        var template = StructuredComponents.FirstOrDefault(
            component =>
                string.Equals(
                    component.Key,
                    templateKey,
                    StringComparison.Ordinal));

        if (template is null)
        {
            return;
        }

        await AddStructuredComponentAtAsync(
            template,
            insertionIndex);

        await InvokeAsync(StateHasChanged);
    }

    private async Task AddStructuredComponentAtAsync(
        StructuredComponent template,
        int insertionIndex)
    {
        var component = new ReviewContentComponent
        {
            Kind = template.Kind,
            Heading = template.Heading,
            Content = template.Content,
            Rating = RatingMaximum == 10 ? 6 : 3
        };

        Draft.Components.Insert(
            Math.Clamp(
                insertionIndex,
                0,
                Draft.Components.Count),
            component);

        await SaveDraftImmediatelyAsync();
    }

    private async Task SetReviewComponentRatingAsync(
        ReviewContentComponent component,
        int rating)
    {
        component.Rating = Math.Clamp(rating, 1, RatingMaximum);
        await SaveDraftImmediatelyAsync();
    }

    private async Task SetReviewComponentRatingFromEventAsync(
        ReviewContentComponent component,
        ChangeEventArgs eventArgs)
    {
        if (int.TryParse(eventArgs.Value?.ToString(), out var rating))
        {
            await SetReviewComponentRatingAsync(component, rating);
        }
    }

    private void BeginReviewComponentDrag(
        ReviewContentComponent component)
    {
        _draggedReviewComponentId = component.Id;
    }

    private void EndReviewComponentDrag()
    {
        _draggedReviewComponentId = null;
    }

    private async Task DropReviewComponentAsync(
        ReviewContentComponent target)
    {
        if (_draggedReviewComponentId is null ||
            _draggedReviewComponentId == target.Id)
        {
            return;
        }

        var source = Draft.Components.FirstOrDefault(
            component => component.Id == _draggedReviewComponentId);

        if (source is null)
        {
            return;
        }

        var targetIndex = Draft.Components.IndexOf(target);
        Draft.Components.Remove(source);
        Draft.Components.Insert(targetIndex, source);
        _draggedReviewComponentId = null;

        await SaveDraftImmediatelyAsync();
    }

    private async Task MoveReviewComponentAsync(
        ReviewContentComponent component,
        int offset)
    {
        var currentIndex = Draft.Components.IndexOf(component);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.Components.Count)
        {
            return;
        }

        Draft.Components.RemoveAt(currentIndex);
        Draft.Components.Insert(targetIndex, component);
        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveReviewComponentAsync(
        ReviewContentComponent component)
    {
        Draft.Components.Remove(component);
        await SaveDraftImmediatelyAsync();
    }

    private async Task DuplicateReviewComponentAsync(
        ReviewContentComponent component)
    {
        var sourceIndex = Draft.Components.IndexOf(component);

        if (sourceIndex < 0)
        {
            return;
        }

        var duplicate = new ReviewContentComponent
        {
            Kind = component.Kind,
            Heading = component.Heading,
            Content = component.Content,
            Rating = component.Rating
        };

        Draft.Components.Insert(
            sourceIndex + 1,
            duplicate);

        await SaveDraftImmediatelyAsync();
    }

    private string GetReviewComponentsClass() =>
        Draft.Components.Count == 0
            ? "structured-review-components empty"
            : "structured-review-components";

    private string GetReviewComponentClass(
        ReviewContentComponent component)
    {
        var classes = new List<string>
        {
            "structured-review-component"
        };

        if (_draggedReviewComponentId == component.Id)
        {
            classes.Add("dragging");
        }

        if (GetReviewComponentIssues(component).Any(
                issue =>
                    issue.Severity ==
                    ReviewValidationSeverity.Error))
        {
            classes.Add("has-error");
        }

        return string.Join(' ', classes);
    }

    private IEnumerable<ReviewValidationIssue>
        GetReviewComponentIssues(
            ReviewContentComponent component) =>
        GetFieldIssues(GetComponentHeadingField(component))
            .Concat(GetFieldIssues(GetComponentContentField(component)))
            .Concat(GetFieldIssues(GetComponentRatingField(component)));

    private static string GetComponentHeadingField(
        ReviewContentComponent component) =>
        $"ComponentHeading:{component.Id}";

    private static string GetComponentContentField(
        ReviewContentComponent component) =>
        $"ComponentContent:{component.Id}";

    private static string GetComponentRatingField(
        ReviewContentComponent component) =>
        $"ComponentRating:{component.Id}";

    private async Task AddCategoryAtAsync(
        int index)
    {
        var category = new ReviewCategory
        {
            Rating =
                RatingMaximum == 10
                    ? 6
                    : 3
        };

        Draft.Categories.Insert(
            Math.Clamp(
                index,
                0,
                Draft.Categories.Count),
            category);

        await SaveDraftImmediatelyAsync();
    }

    private bool HasTableColumn(
        ReviewTableColumnKind kind)
    {
        return Draft.TableColumns.Any(
            column => column.Kind == kind);
    }

    private static string GetDefaultColumnHeading(
        ReviewTableColumnKind kind)
    {
        return kind switch
        {
            ReviewTableColumnKind.Category =>
                "Category",
            ReviewTableColumnKind.Rating =>
                "Rating",
            ReviewTableColumnKind.Note =>
                "Notes",
            _ => "New Column"
        };
    }

    private string GetConfigurerColumnClass(
        ReviewTableColumn column)
    {
        var classes = new List<string>
        {
            "table-editor-column"
        };

        if (_draggedColumnId == column.Id)
            classes.Add("dragging");

        if (_columnDropTargetId == column.Id &&
            _draggedColumnId != column.Id)
        {
            classes.Add("drag-target");
        }

        return string.Join(' ', classes);
    }

    private string GetConfigurerRowClass(
        ReviewCategory category)
    {
        var classes = new List<string>
        {
            "table-editor-row"
        };

        if (_draggedRowId == category.Id)
            classes.Add("dragging");

        if (_rowDropTargetId == category.Id &&
            _draggedRowId != category.Id)
        {
            classes.Add("drag-target");
        }

        return string.Join(' ', classes);
    }

    private static string GetColumnKindLabel(
        ReviewTableColumnKind kind)
    {
        return kind switch
        {
            ReviewTableColumnKind.Category =>
                "Category data",
            ReviewTableColumnKind.Rating =>
                "Rating data",
            ReviewTableColumnKind.Note =>
                "Notes data",
            _ => "Custom text"
        };
    }

    private string GetRowDragClass(
        ReviewCategory category)
    {
        return _draggedRowId == category.Id
            ? "steam-row-dragging"
            : string.Empty;
    }

    private string GetCustomCellValue(
        ReviewCategory category,
        ReviewTableColumn column)
    {
        return category.CustomCells.TryGetValue(
            column.Id,
            out var value)
            ? value
            : string.Empty;
    }

    private async Task UpdateCustomCellAsync(
        ReviewCategory category,
        ReviewTableColumn column,
        ChangeEventArgs eventArgs)
    {
        category.CustomCells[column.Id] =
            eventArgs.Value?.ToString() ??
            string.Empty;

        await QueueDraftSaveAsync();
    }

    private async Task AddColumnAsync(
        ReviewTableColumnKind kind)
    {
        if (kind != ReviewTableColumnKind.CustomText &&
            HasTableColumn(kind))
        {
            return;
        }

        var column = new ReviewTableColumn
        {
            Heading = GetDefaultColumnHeading(kind),
            Kind = kind
        };

        Draft.TableColumns.Add(column);
        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveColumnAsync(
        ReviewTableColumn column)
    {
        if (Draft.TableColumns.Count == 1)
        {
            return;
        }

        Draft.TableColumns.Remove(column);

        if (column.Kind ==
            ReviewTableColumnKind.CustomText)
        {
            foreach (var category in Draft.Categories)
                category.CustomCells.Remove(column.Id);
        }

        _draggedColumnId = null;
        await SaveDraftImmediatelyAsync();
    }

    private async Task MoveColumnAsync(
        ReviewTableColumn column,
        int offset)
    {
        var currentIndex =
            Draft.TableColumns.IndexOf(column);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.TableColumns.Count)
        {
            return;
        }

        Draft.TableColumns.RemoveAt(currentIndex);
        Draft.TableColumns.Insert(targetIndex, column);

        await SaveDraftImmediatelyAsync();
    }

    private void BeginColumnDrag(
        ReviewTableColumn column)
    {
        _draggedColumnId = column.Id;
        _columnDropTargetId = null;
    }

    private void SetColumnDropTarget(
        ReviewTableColumn column)
    {
        if (_draggedColumnId is not null)
            _columnDropTargetId = column.Id;
    }

    private void EndColumnDrag()
    {
        _draggedColumnId = null;
        _columnDropTargetId = null;
    }

    private async Task DropColumnAsync(
        ReviewTableColumn target)
    {
        if (_draggedColumnId is null ||
            _draggedColumnId == target.Id)
        {
            return;
        }

        var source = Draft.TableColumns.FirstOrDefault(
            column =>
                column.Id == _draggedColumnId);

        if (source is null)
        {
            _draggedColumnId = null;
            return;
        }

        MoveItemToTarget(
            Draft.TableColumns,
            source,
            target);

        _draggedColumnId = null;
        _columnDropTargetId = null;
        await SaveDraftImmediatelyAsync();
    }

    private void BeginRowDrag(
        ReviewCategory category)
    {
        _draggedRowId = category.Id;
        _rowDropTargetId = null;
    }

    private void SetRowDropTarget(
        ReviewCategory category)
    {
        if (_draggedRowId is not null)
            _rowDropTargetId = category.Id;
    }

    private void EndRowDrag()
    {
        _draggedRowId = null;
        _rowDropTargetId = null;
    }

    private async Task DropRowAsync(
        ReviewCategory target)
    {
        if (_draggedRowId is null ||
            _draggedRowId == target.Id)
        {
            return;
        }

        var source = Draft.Categories.FirstOrDefault(
            category =>
                category.Id == _draggedRowId);

        if (source is null)
        {
            _draggedRowId = null;
            return;
        }

        MoveItemToTarget(
            Draft.Categories,
            source,
            target);

        _draggedRowId = null;
        _rowDropTargetId = null;
        await SaveDraftImmediatelyAsync();
    }

    private static void MoveItemToTarget<T>(
        List<T> items,
        T source,
        T target)
    {
        var sourceIndex = items.IndexOf(source);
        var targetIndex = items.IndexOf(target);

        if (sourceIndex < 0 ||
            targetIndex < 0)
        {
            return;
        }

        items.RemoveAt(sourceIndex);
        items.Insert(targetIndex, source);
    }

    private async Task MoveCategoryAsync(
        ReviewCategory category,
        int offset)
    {
        var currentIndex = Draft.Categories.IndexOf(category);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.Categories.Count)
        {
            return;
        }

        Draft.Categories.RemoveAt(currentIndex);
        Draft.Categories.Insert(targetIndex, category);

        await SaveDraftImmediatelyAsync();
    }

