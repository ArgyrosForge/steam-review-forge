                            <input class="steam-inline-input steam-list-item-input"
                                   type="text"
                                   value="@items[itemIndex]"
                                   aria-label="@($"{ariaLabel} item {itemIndex + 1}")"
                                   @oninput="eventArgs => UpdateTextListItemAsync(
                                                 bodyKey,
                                                 itemIndex,
                                                 eventArgs.Value?.ToString() ?? string.Empty)"/>
                            <div class="steam-list-item-controls"
                                 role="group"
                                 aria-label="@($"Reorder or remove {ariaLabel} item {itemIndex + 1}")">
                                <span class="steam-list-drag-handle"
                                      draggable="true"
                                      title="Drag to reorder"
                                      aria-label="@($"Drag {ariaLabel} item {itemIndex + 1} to reorder")"
                                      @ondragstart="() => BeginTextListItemDrag(
                                                            bodyKey,
                                                            itemIndex)"
                                      @ondragend="EndTextListItemDrag">
                                    ⋮⋮
                                </span>
                                <button type="button"
                                        title="Move item up"
                                        aria-label="@($"Move {ariaLabel} item {itemIndex + 1} up")"
                                        disabled="@(itemIndex == 0)"
                                        @onclick="() => MoveTextListItemAsync(
                                                          bodyKey,
                                                          itemIndex,
                                                          -1)">
                                    ↑
                                </button>
                                <button type="button"
                                        title="Move item down"
                                        aria-label="@($"Move {ariaLabel} item {itemIndex + 1} down")"
                                        disabled="@(itemIndex == items.Length - 1)"
                                        @onclick="() => MoveTextListItemAsync(
                                                          bodyKey,
                                                          itemIndex,
                                                          1)">
                                    ↓
                                </button>
                                <button type="button"
                                        title="Remove item"
                                        aria-label="@($"Remove {ariaLabel} item {itemIndex + 1}")"
                                        @onclick="() => RemoveTextListItemAsync(
                                                          bodyKey,
                                                          itemIndex)">
                                    −
                                </button>
                            </div>
                        </div>
                    }

                    <button class="steam-list-add-item"
                            type="button"
                            @onclick="() => AddTextListItemAsync(bodyKey)">
                        + Add item
                    </button>
                </div>
            }
        </div>;

    private static string GetTextFormatButtonClass(
        ReviewTextFormat current,
        ReviewTextFormat target) =>
        current == target
            ? "steam-text-format-button selected"
            : "steam-text-format-button";

    private static string GetComponentBodyKey(
        ReviewContentComponent component) =>
        $"component:{component.Id}";

    private async Task SetTextFormatAsync(
        string bodyKey,
        ReviewTextFormat format)
    {
        var currentFormat = GetBodyFormat(bodyKey);
        var content = GetBodyContent(bodyKey);

        if (currentFormat == format)
        {
            return;
        }

        if (currentFormat == ReviewTextFormat.Text &&
            format != ReviewTextFormat.Text)
        {
            content = string.Join('\n', GetNonEmptyBodyLines(content));
        }
        else if (currentFormat != ReviewTextFormat.Text &&
                 format == ReviewTextFormat.Text)
        {
            content = string.Join('\n', GetNonEmptyBodyLines(content));
        }

        SetBodyContent(bodyKey, content);
        SetBodyFormat(bodyKey, format);
        await SaveDraftImmediatelyAsync();
    }

    private async Task UpdateBodyContentAsync(
        string bodyKey,
        string content)
    {
        SetBodyContent(bodyKey, content);
        await QueueDraftSaveAsync();
    }

    private async Task UpdateTextListItemAsync(
        string bodyKey,
        int itemIndex,
        string value)
    {
        var items = GetListEditorLines(GetBodyContent(bodyKey));

        if (itemIndex < 0 || itemIndex >= items.Length)
        {
            return;
        }

        items[itemIndex] = value;
        SetBodyContent(bodyKey, string.Join('\n', items));
        await QueueDraftSaveAsync();
    }

    private async Task AddTextListItemAsync(string bodyKey)
    {
        var content = GetBodyContent(bodyKey);
        SetBodyContent(
            bodyKey,
            string.IsNullOrEmpty(content)
                ? " "
                : $"{content}\n ");
        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveTextListItemAsync(
        string bodyKey,
        int itemIndex)
    {
        var items = GetListEditorLines(GetBodyContent(bodyKey)).ToList();

        if (itemIndex < 0 || itemIndex >= items.Count)
        {
            return;
        }

        items.RemoveAt(itemIndex);
        SetBodyContent(bodyKey, string.Join('\n', items));
        await SaveDraftImmediatelyAsync();
    }

    private async Task MoveTextListItemAsync(
        string bodyKey,
        int itemIndex,
        int offset)
    {
        var items = GetListEditorLines(GetBodyContent(bodyKey));
        var targetIndex = itemIndex + offset;

        if (itemIndex < 0 || itemIndex >= items.Length ||
            targetIndex < 0 || targetIndex >= items.Length)
        {
            return;
        }

        (items[itemIndex], items[targetIndex]) =
            (items[targetIndex], items[itemIndex]);
        SetBodyContent(bodyKey, string.Join('\n', items));
        await SaveDraftImmediatelyAsync();
    }

    private void BeginTextListItemDrag(
        string bodyKey,
        int itemIndex)
    {
        _draggedTextListBodyKey = bodyKey;
        _draggedTextListItemIndex = itemIndex;
    }

    private void EndTextListItemDrag()
    {
        _draggedTextListBodyKey = null;
        _draggedTextListItemIndex = null;
    }

    private async Task DropTextListItemAsync(
        string bodyKey,
        int targetIndex)
    {
        if (_draggedTextListBodyKey != bodyKey ||
            _draggedTextListItemIndex is not int sourceIndex ||
            sourceIndex == targetIndex)
        {
            return;
        }

        var items = GetListEditorLines(GetBodyContent(bodyKey)).ToList();

        if (sourceIndex < 0 || sourceIndex >= items.Count ||
            targetIndex < 0 || targetIndex >= items.Count)
        {
            EndTextListItemDrag();
            return;
        }

        var item = items[sourceIndex];
        items.RemoveAt(sourceIndex);
        items.Insert(targetIndex, item);
        SetBodyContent(bodyKey, string.Join('\n', items));
        EndTextListItemDrag();
        await SaveDraftImmediatelyAsync();
    }

    private static string[] GetListEditorLines(string content) =>
        string.IsNullOrEmpty(content)
            ? []
            : content.Replace("\r\n", "\n", StringComparison.Ordinal)
                .Replace('\r', '\n')
                .Split('\n');

    private static string[] GetNonEmptyBodyLines(string content) =>
        content.Split(
            ['\r', '\n'],
            StringSplitOptions.RemoveEmptyEntries |
            StringSplitOptions.TrimEntries);

    private ReviewTextFormat GetBodyFormat(string bodyKey)
    {
        return bodyKey switch
        {
            WhatWorksBodyKey => Draft.WhatWorksFormat,
            WhatCouldBeBetterBodyKey => Draft.WhatCouldBeBetterFormat,
            FinalThoughtsBodyKey => Draft.FinalThoughtsFormat,
            _ => GetBodyComponent(bodyKey)?.ContentFormat ??
                 ReviewTextFormat.Text
        };
    }

    private void SetBodyFormat(
        string bodyKey,
        ReviewTextFormat format)
    {
        switch (bodyKey)
        {
            case WhatWorksBodyKey:
                Draft.WhatWorksFormat = format;
                break;
            case WhatCouldBeBetterBodyKey:
                Draft.WhatCouldBeBetterFormat = format;
                break;
            case FinalThoughtsBodyKey:
                Draft.FinalThoughtsFormat = format;
                break;
            default:
                var component = GetBodyComponent(bodyKey);

                if (component is not null)
                {
                    component.ContentFormat = format;
                }

                break;
        }
    }

    private string GetBodyContent(string bodyKey)
    {
        return bodyKey switch
        {
            WhatWorksBodyKey => Draft.WhatWorks,
            WhatCouldBeBetterBodyKey => Draft.WhatCouldBeBetter,
            FinalThoughtsBodyKey => Draft.FinalThoughts,
            _ => GetBodyComponent(bodyKey)?.Content ?? string.Empty
        };
    }

    private void SetBodyContent(string bodyKey, string content)
    {
        switch (bodyKey)
        {
            case WhatWorksBodyKey:
                Draft.WhatWorks = content;
                break;
            case WhatCouldBeBetterBodyKey:
                Draft.WhatCouldBeBetter = content;
                break;
            case FinalThoughtsBodyKey:
                Draft.FinalThoughts = content;
                break;
            default:
                var component = GetBodyComponent(bodyKey);

                if (component is not null)
                {
                    component.Content = content;
                }

                break;
        }
    }

    private ReviewContentComponent? GetBodyComponent(string bodyKey)
    {
        const string prefix = "component:";

        if (!bodyKey.StartsWith(prefix, StringComparison.Ordinal) ||
            !Guid.TryParse(bodyKey[prefix.Length..], out var componentId))
        {
            return null;
        }

        return Draft.Components.FirstOrDefault(
            component => component.Id == componentId);
    }

