                "Set the required metadata and choose a starting point.",
            BbCodeStep.Composer =>
                "Build the review with editable BBCode blocks.",
            BbCodeStep.FinalPreview =>
                "Inspect the finished post before copying it.",
            _ => string.Empty
        };

