        _showTableConfigurer =
            issue.Section == ReviewValidationSection.Format &&
            Draft.DisplayFormat == ReviewDisplayFormat.RatingTable &&
            (issue.Field == nameof(Draft.Categories) ||
             issue.Field.StartsWith(
                 "ColumnHeading:",
                 StringComparison.Ordinal) ||
             issue.Field.StartsWith(
                 "CategoryName:",
                 StringComparison.Ordinal) ||
             issue.Field.StartsWith(
                 "CategoryNote:",
                 StringComparison.Ordinal));

        _pendingValidationField = issue.Field;
