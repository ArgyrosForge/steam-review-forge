            "Add a standard two-column table.",
            "[table]\n" +
            "[tr][th]Name[/th][th]Value[/th][/tr]\n" +
            "[tr][td]First row[/td][td]1[/td][/tr]\n" +
            "[tr][td]Second row[/td][td]2[/td][/tr]\n" +
            "[/table]"),
        new(
            "Borderless table",
            "Add a table without cell borders.",
            "[table noborder=1]\n" +
            "[tr][th]Name[/th][th]Value[/th][/tr]\n" +
            "[tr][td]First row[/td][td]1[/td][/tr]\n" +
            "[tr][td]Second row[/td][td]2[/td][/tr]\n" +
            "[/table]"),
        new(
            "Equal-width table",
            "Fill the width with equal columns.",
            "[table equalcells=1]\n" +
            "[tr][th]Category[/th][th]Rating[/th][/tr]\n" +
            "[tr][td]Gameplay[/td][td]8/10[/td][/tr]\n" +
            "[tr][td]Visuals[/td][td]9/10[/td][/tr]\n" +
            "[/table]")
    ];

    private static readonly TemplateOption[] TemplateOptions =
    [
        new(
            ReviewTemplate.Balanced,
            "BAL",
            "Balanced Review",
            "A standard review with ratings and guided written responses.",
            [
                "Rating table layout",
                "Three starter categories",
                "Strengths and weaknesses"
            ]),

        new(
            ReviewTemplate.QuickTake,
            "QT",
            "Quick Take",
            "A short review focused on the final recommendation.",
            [
                "Minimal verdict layout",
                "No category ratings",
                "One final explanation"
            ]),

        new(
            ReviewTemplate.DeepDive,
            "DD",
            "Deep Dive",
            "A detailed review covering more parts of the game.",
            [
                "Individual section layout",
                "Six starter categories",
                "No additional questionnaire blocks"
            ]),

        new(
            ReviewTemplate.Custom,
            "{}",
            "Full Custom",
            "A mostly blank starting point for building your own review.",
            [
                "One blank category",
                "Empty written responses",
                "Complete manual control"
            ])
    ];

    private ReviewDraft Draft { get; set; } = new();

    private BuilderStep CurrentStep { get; set; } =
        BuilderStep.Setup;

    private BbCodeStep CurrentBbCodeStep { get; set; } =
        BbCodeStep.Setup;

    private ReviewTemplate? SelectedBbCodeTemplate { get; set; }

    private bool HasSelectedBbCodeStartingPoint { get; set; }

    private ReviewTemplate SelectedTemplate { get; set; } =
        ReviewTemplate.Balanced;

    private CancellationTokenSource? _saveDebounce;

    private long _saveRevision;

    private bool _draftStorageReady;

    private string _saveStatus = "Loading draft…";

    private string _copyMessage = string.Empty;

    private string? _draftRecoveryData;

    private string _draftRecoveryMessage = string.Empty;

    private string _recoveryCopyMessage = string.Empty;

    private bool _hasUnsavedChanges;

    private string? _analyzedBbCode;

    private BbCodeAnalysisResult _bbCodeAnalysis = new();

    private AppearanceState _appearance =
        new("main-blue", "dark");

    private ThemeOption[] _themes =
    [
        new("main-blue", "Main Blue"),
        new("nord", "Nord"),
        new("catppuccin-latte", "Catppuccin Latte"),
        new("catppuccin-frappe", "Catppuccin Frappé"),
        new("catppuccin-macchiato", "Catppuccin Macchiato"),
        new("catppuccin-mocha", "Catppuccin Mocha")
    ];

    private bool _showNewReviewDialog;

    private bool _showFormattingHelp;

    private bool _showTableConfigurer;

    private bool _showResetTemplateDialog;

    private bool _showBbCodeViewer;

    private bool _showModeSwitchDialog;

    private ReviewEditingMode? _pendingEditingMode;

    private string? _pendingValidationField;

    private Guid? _draggedRowId;

    private Guid? _draggedColumnId;

    private Guid? _columnDropTargetId;

    private Guid? _rowDropTargetId;

    private Guid? _draggedReviewComponentId;

    private string? _draggedTextListBodyKey;

    private int? _draggedTextListItemIndex;

    private DotNetObjectReference<Home>? _structuredComponentDragReference;

    private string GeneratedBbCode =>
        IsBbCodeMode
            ? Draft.RawBbCode
            : SteamBbCodeGenerator.Generate(Draft);

    private bool HasBbCodeContent =>
        !string.IsNullOrWhiteSpace(GeneratedBbCode);

    private BbCodeAnalysisResult CurrentBbCodeAnalysis
    {
        get
        {
            var bbCode = GeneratedBbCode;

            if (!string.Equals(
                    _analyzedBbCode,
                    bbCode,
                    StringComparison.Ordinal))
            {
                _analyzedBbCode = bbCode;
                _bbCodeAnalysis = SteamBbCodeAnalyzer.Analyze(bbCode);
            }

            return _bbCodeAnalysis;
        }
    }

    private string BuilderLayoutClass
    {
        get
        {
            var layoutClass =
                Draft.EditingMode == ReviewEditingMode.GuidedStructured
                    ? "builder-layout guided-structured-layout"
                    : IsStructuredMode
                    ? "builder-layout structured-layout"
                    : "builder-layout";

            return ShouldWidenWorkflow
                ? $"{layoutClass} wide-workflow-layout"
                : layoutClass;
        }
    }

    private bool ShouldWidenWorkflow =>
        IsUnguidedStructured ||
        (IsGuidedBbCode &&
         CurrentBbCodeStep == BbCodeStep.Setup) ||
        (Draft.EditingMode == ReviewEditingMode.GuidedStructured &&
         CurrentStep is BuilderStep.Setup or BuilderStep.Template);
    
    private ReviewValidationResult CurrentValidation =>
        ReviewDraftValidator.Validate(Draft);

    private bool IsStructuredMode =>
        Draft.EditingMode is
            ReviewEditingMode.GuidedStructured or
            ReviewEditingMode.UnguidedStructured;

    private bool IsBbCodeMode => !IsStructuredMode;

    private bool IsGuidedMode =>
        Draft.EditingMode is
            ReviewEditingMode.GuidedStructured or
            ReviewEditingMode.GuidedBbCode;

    private bool IsUnguidedStructured =>
        Draft.EditingMode ==
        ReviewEditingMode.UnguidedStructured;

    private bool IsStructuredEditorEditable =>
        IsStructuredMode &&
        SetupComplete &&
        CurrentStep != BuilderStep.Setup;

    private bool IsGuidedBbCode =>
        Draft.EditingMode ==
        ReviewEditingMode.GuidedBbCode;

    private bool IsBbCodeEditorEditable =>
        !IsGuidedBbCode ||
        CurrentBbCodeStep == BbCodeStep.Composer;

    private bool ShouldShowBbCodeEditor =>
        IsBbCodeMode;

    private bool IsBbCodeFinalPreview =>
        IsGuidedBbCode &&
        CurrentBbCodeStep == BbCodeStep.FinalPreview;

    private IEnumerable<ReviewValidationIssue> PreviewEditingIssues =>
        IsUnguidedStructured
            ? CurrentValidation.Issues
            : CurrentStep switch
        {
            BuilderStep.Format =>
                CurrentValidation.Issues.Where(
                    issue =>
                        issue.Section ==
                        ReviewValidationSection.Format &&
                        (issue.Field ==
                         nameof(Draft.Categories) ||
                         issue.Field.StartsWith(
                             "ColumnHeading:",
                             StringComparison.Ordinal))),

            BuilderStep.Questions =>
                CurrentValidation.Issues.Where(
                    issue =>
                        issue.Section ==
                        ReviewValidationSection.Questions),

            _ => []
        };

    private MarkupString RenderedPreview =>
        new(
            SteamBbCodePreviewRenderer.Render(
                GeneratedBbCode));

    private bool ShowCategories =>
        Draft.DisplayFormat is
            ReviewDisplayFormat.RatingTable or
            ReviewDisplayFormat.Sections or
            ReviewDisplayFormat.Checklist;

    private bool ShowDetailedQuestions =>
        Draft.DisplayFormat != ReviewDisplayFormat.MinimalVerdict;

    private bool HasEditableIntro =>
        Draft.IncludeTitle;

    private bool HasEditableWritingContent =>
        Draft.IncludeFinalThoughts ||
        (ShowDetailedQuestions &&
         (Draft.IncludeWhatWorks ||
          Draft.IncludeWhatCouldBeBetter));

    private bool HasEditableCategories =>
        ShowCategories &&
        Draft.Categories.Count > 0;

    private bool HasEditableComponents =>
        IsUnguidedStructured &&
        Draft.Components.Count > 0;

    private bool HasRecommendation =>
        Draft.Recommendation is not null;

    private bool SetupComplete =>
        HasRecommendation &&
        !CurrentValidation.HasErrors(
