    }

    private static string GetDefaultColumnHeading(
        ReviewTableColumnKind kind)
    {
        return kind switch
        {
            ReviewTableColumnKind.Category =>
                "Category",
            ReviewTableColumnKind.Rating =>
                "Rating",
            ReviewTableColumnKind.Note =>
                "Notes",
            _ => "New Column"
        };
    }

    private string GetConfigurerColumnClass(
        ReviewTableColumn column)
    {
        var classes = new List<string>
        {
            "table-editor-column"
        };

        if (_draggedColumnId == column.Id)
            classes.Add("dragging");

        if (_columnDropTargetId == column.Id &&
            _draggedColumnId != column.Id)
        {
            classes.Add("drag-target");
        }

        return string.Join(' ', classes);
    }

    private string GetConfigurerRowClass(
        ReviewCategory category)
    {
        var classes = new List<string>
        {
            "table-editor-row"
        };

        if (_draggedRowId == category.Id)
            classes.Add("dragging");

        if (_rowDropTargetId == category.Id &&
            _draggedRowId != category.Id)
        {
            classes.Add("drag-target");
        }

        return string.Join(' ', classes);
    }

    private static string GetColumnKindLabel(
        ReviewTableColumnKind kind)
    {
        return kind switch
        {
            ReviewTableColumnKind.Category =>
                "Category data",
            ReviewTableColumnKind.Rating =>
                "Rating data",
            ReviewTableColumnKind.Note =>
                "Notes data",
