    private RenderFragment RenderFormattedBodyEditor(
        string bodyKey,
        string content,
        ReviewTextFormat format,
        string ariaLabel,
        string placeholder,
        string validationField,
        int rows) =>
        @<div class="steam-formatted-body-editor">
            @if (format == ReviewTextFormat.Text)
            {
                <textarea class="steam-inline-input steam-writing-textarea"
                          rows="@rows"
                          data-validation-field="@validationField"
                          aria-invalid="@(HasFieldError(validationField)
                                              ? "true"
                                              : "false")"
                          aria-label="@ariaLabel"
                          placeholder="@placeholder"
                          value="@content"
                          @oninput="eventArgs => UpdateBodyContentAsync(
                                        bodyKey,
                                        eventArgs.Value?.ToString() ?? string.Empty)"></textarea>
            }
            else
            {
                var items = GetListEditorLines(content);

                <div class="steam-list-item-editor"
                     data-validation-field="@validationField"
                     aria-invalid="@(HasFieldError(validationField)
                                         ? "true"
                                         : "false")">
                    @for (var index = 0; index < items.Length; index++)
                    {
                        var itemIndex = index;

                        <div class="steam-list-item-row"
                             @key="@($"{bodyKey}:{itemIndex}")"
                             @ondragover:preventDefault
                             @ondrop="() => DropTextListItemAsync(
                                                 bodyKey,
                                                 itemIndex)">
                            <span class="steam-list-item-marker"
                                  aria-hidden="true">
                                @(format == ReviewTextFormat.NumberedList
                                    ? $"{itemIndex + 1}."
