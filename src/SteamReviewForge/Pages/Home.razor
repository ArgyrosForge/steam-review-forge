    private async Task DropRowAsync(
        ReviewCategory target)
    {
        if (_draggedRowId is null ||
            _draggedRowId == target.Id)
        {
            return;
        }

        var source = Draft.Categories.FirstOrDefault(
            category =>
                category.Id == _draggedRowId);

        if (source is null)
        {
            _draggedRowId = null;
            return;
        }

        MoveItemToTarget(
            Draft.Categories,
            source,
            target);

        _draggedRowId = null;
        _rowDropTargetId = null;
        await SaveDraftImmediatelyAsync();
    }

    private static void MoveItemToTarget<T>(
        List<T> items,
        T source,
        T target)
    {
        var sourceIndex = items.IndexOf(source);
        var targetIndex = items.IndexOf(target);

        if (sourceIndex < 0 ||
            targetIndex < 0)
        {
            return;
        }

        items.RemoveAt(sourceIndex);
        items.Insert(targetIndex, source);
    }

    private async Task MoveCategoryAsync(
        ReviewCategory category,
        int offset)
    {
        var currentIndex = Draft.Categories.IndexOf(category);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.Categories.Count)
        {
            return;
        }

        Draft.Categories.RemoveAt(currentIndex);
        Draft.Categories.Insert(targetIndex, category);

        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveCategory(
        ReviewCategory category)
    {
        Draft.Categories.Remove(category);

        await SaveDraftImmediatelyAsync();
    }

    private async Task CopyBbCode()
    {
        if (!HasBbCodeContent)
        {
            _copyMessage =
                "Add review content before copying BBCode.";
            return;
        }

        try
        {
            var warningCount =
                CurrentBbCodeAnalysis.Diagnostics.Count;

            await JS.InvokeVoidAsync(
                "clipboardManager.copyText",
                GeneratedBbCode);

            _copyMessage =
                warningCount == 0
                    ? "Copied to clipboard."
                    : $"Copied with {warningCount} BBCode compatibility " +
                      (warningCount == 1 ? "warning." : "warnings.");
        }
        catch
        {
            _copyMessage =
                "Copy failed. Select the BBCode manually.";
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            _structuredComponentDragReference =
                DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "structuredComponentDrag.initialize",
                _structuredComponentDragReference);

            _themes = await JS.InvokeAsync<ThemeOption[]>(
                "themeManager.getThemes");

            _appearance = await JS.InvokeAsync<AppearanceState>(
                "themeManager.get");
            await RestoreDraftAsync();

            StateHasChanged();
        }

        if (_pendingValidationField is null)
        {
            return;
        }

        var field = _pendingValidationField;
        _pendingValidationField = null;

        await JS.InvokeVoidAsync(
            "validationNavigator.focus",
            field);
    }

    public ValueTask DisposeAsync()
    {
        _saveDebounce?.Cancel();
        _saveDebounce?.Dispose();
        _structuredComponentDragReference?.Dispose();

        return ValueTask.CompletedTask;
    }

    private async Task ToggleTheme()
    {
        _appearance = await JS.InvokeAsync<AppearanceState>(
