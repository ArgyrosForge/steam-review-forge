@page "/"

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject ReviewDraftStorageService DraftStorage

@using Microsoft.AspNetCore.Components
@using SteamReviewForge.Models
@using SteamReviewForge.Services

<PageTitle>Steam Review Forge</PageTitle>

<div class="app-shell">
    <header class="app-header">
        <div>
            <h1>Steam Review Forge</h1>
            <p>
                Build a structured review and copy the generated Steam BBCode.
            </p>
        </div>

        <div class="header-actions">
            <span class="save-status"
                  role="status"
                  aria-live="polite">
                @_saveStatus
            </span>

            <button class="button new-review-button"
                    type="button"
                    @onclick="OpenNewReviewDialog">
                New review
            </button>

            <button class="theme-toggle"
                    type="button"
                    title="@ThemeToggleLabel"
                    aria-label="@ThemeToggleLabel"
                    @onclick="ToggleTheme">
                <span aria-hidden="true">@ThemeToggleIcon</span>
            </button>
        </div>
    </header>

    <main class="builder-layout">
        <aside class="panel workflow-panel">
            <div class="panel-heading">
                <h2>Review Builder</h2>
                <p>Complete each step to create your review.</p>
            </div>

            <ol class="step-list">
                <li>
                    <button class="@GetStepClass(BuilderStep.Template)"
                            type="button"
                            @onclick="() => GoToStep(BuilderStep.Template)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Template)
                        </span>

                        <span>
                            <strong>Template</strong>
                            <small>Choose a starting point</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.Setup)"
                            type="button"
                            @onclick="() => GoToStep(BuilderStep.Setup)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Setup)
                        </span>

                        <span>
                            <strong>Setup</strong>
                            <small>Basic review information</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.Format)"
                            type="button"
                            @onclick="() => GoToStep(BuilderStep.Format)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Format)
                        </span>

                        <span>
                            <strong>Format</strong>
                            <small>Layout and category ratings</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.Questions)"
                            type="button"
                            @onclick="() => GoToStep(BuilderStep.Questions)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Questions)
                        </span>

                        <span>
                            <strong>Questions</strong>
                            <small>Write the review content</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.Export)"
                            type="button"
                            @onclick="() => GoToStep(BuilderStep.Export)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Export)
                        </span>

                        <span>
                            <strong>Export</strong>
                            <small>Copy the generated BBCode</small>
                        </span>
                    </button>
                </li>
            </ol>
        </aside>

        <section class="panel editor-panel">
            <div class="panel-heading">
                <h2>@StepTitle</h2>
                <p>@StepDescription</p>
            </div>

            <div class="step-content">
                @if (CurrentStep == BuilderStep.Template)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Choose a review template</h3>

                            <p>
                                Templates provide starter content, categories,
                                and a recommended display format.
                            </p>
                        </div>

                        <div class="template-grid"
                             role="radiogroup"
                             aria-label="Review template">
                            @foreach (var option in TemplateOptions)
                            {
                                <button class="@GetTemplateCardClass(option.Template)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(SelectedTemplate == option.Template
                                                          ? "true"
                                                          : "false")"
                                        @onclick="() => SelectTemplate(option.Template)">
                                    <div class="template-card-header">
                                        <span class="template-code"
                                              aria-hidden="true">
                                            @option.Code
                                        </span>

                                        @if (SelectedTemplate == option.Template)
                                        {
                                            <span class="template-selected">
                                                Selected
                                            </span>
                                        }
                                    </div>

                                    <h4>@option.Name</h4>
                                    <p>@option.Description</p>

                                    <ul>
                                        @foreach (var detail in option.Details)
                                        {
                                            <li>@detail</li>
                                        }
                                    </ul>
                                </button>
                            }
                        </div>

                        <div class="template-note"
                             role="status"
                             aria-live="polite">
                            <strong>@SelectedTemplateName</strong>
                            is currently applied to this review.
                        </div>
                    </section>
                }
                else if (CurrentStep == BuilderStep.Setup)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Review information</h3>

                            <p>
                                Enter the basic information that identifies
                                your review.
                            </p>
                        </div>

                        <div class="field-grid">
                            <div class="@GetFieldClass(nameof(Draft.Title))">
                                <label for="review-title">
                                    Review title
                                </label>

                                <input id="review-title"
                                       type="text"
                                       aria-invalid="@HasFieldError(nameof(Draft.Title))"
                                       @bind="Draft.Title"
                                       @bind:event="oninput"
                                       @bind:after="QueueDraftSaveAsync"/>

                                @foreach (var issue in GetFieldIssues(nameof(Draft.Title)))
                                {
                                    <span class="@GetIssueClass(issue)">
                @issue.Message
            </span>
                                }
                            </div>

                            <div class="@GetFieldClass(nameof(Draft.Summary))">
                                <label for="review-summary">
                                    Summary
                                </label>

                                <input id="review-summary"
                                       type="text"
                                       aria-invalid="@HasFieldError(nameof(Draft.Summary))"
                                       @bind="Draft.Summary"
                                       @bind:event="oninput"
                                       @bind:after="QueueDraftSaveAsync"/>

                                @if (!GetFieldIssues(nameof(Draft.Summary)).Any())
                                {
                                    <span class="field-help">
                A short sentence that summarizes your opinion.
            </span>
                                }

                                @foreach (var issue in GetFieldIssues(nameof(Draft.Summary)))
                                {
                                    <span class="@GetIssueClass(issue)">
                @issue.Message
            </span>
                                }
                            </div>

                            <div class="field">
                                <label for="recommendation">
                                    Recommendation
                                </label>

                                <select id="recommendation"
                                        @bind="Draft.Recommendation"
                                        @bind:after="QueueDraftSaveAsync">
                                    <option value="@ReviewRecommendation.Recommended">
                                        Recommended
                                    </option>

                                    <option value="@ReviewRecommendation.Mixed">
                                        Mixed
                                    </option>

                                    <option value="@ReviewRecommendation.NotRecommended">
                                        Not Recommended
                                    </option>
                                </select>
                            </div>

                            <div class="@GetFieldClass(nameof(Draft.Playtime))">
                                <label for="playtime">
                                    Playtime
                                </label>

                                <input id="playtime"
                                       type="text"
                                       @bind="Draft.Playtime"
                                       @bind:event="oninput"
                                       @bind:after="QueueDraftSaveAsync"/>

                                @if (!GetFieldIssues(nameof(Draft.Playtime)).Any())
                                {
                                    <span class="field-help">
                Example: 35 hours
            </span>
                                }

                                @foreach (var issue in GetFieldIssues(nameof(Draft.Playtime)))
                                {
                                    <span class="@GetIssueClass(issue)">
                @issue.Message
            </span>
                                }
                            </div>
                        </div>
                    </section>
                }
                else if (CurrentStep == BuilderStep.Format)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Display format</h3>

                            <p>
                                Choose how the generated review is structured.
                            </p>
                        </div>

                        <div class="field">
                            <label for="display-format">
                                Review layout
                            </label>

                            <select id="display-format"
                                    @bind="Draft.DisplayFormat"
                                    @bind:after="QueueDraftSaveAsync">
                                <option value="@ReviewDisplayFormat.RatingTable">
                                    Rating Table
                                </option>

                                <option value="@ReviewDisplayFormat.Sections">
                                    Individual Sections
                                </option>

                                <option value="@ReviewDisplayFormat.Checklist">
                                    Checklist
                                </option>

                                <option value="@ReviewDisplayFormat.MinimalVerdict">
                                    Minimal Verdict
                                </option>
                            </select>

                            <span class="field-help">
                                @DisplayFormatDescription
                            </span>
                        </div>
                    </section>

                    @if (ShowCategories)
                    {
                        <section class="editor-section">
                            <div class="section-heading section-heading-row">
                                <div>
                                    <h3>Category ratings</h3>

                                    <p>
                                        Customize each category, score, and note.
                                    </p>
                                </div>

                                <button class="button secondary"
                                        type="button"
                                        @onclick="AddCategory">
                                    Add category
                                </button>
                            </div>

                            <div class="category-list">
                                @foreach (var category in Draft.Categories)
                                {
                                    <div class="category-card"
                                         @key="category.Id">
                                        <div class="category-grid">
                                            <div class="@GetFieldClass(
                                                            $"CategoryName:{category.Id}")">

                                                <label>Category</label>

                                                <input type="text"
                                                       aria-invalid="@HasFieldError(
                                                                         $"CategoryName:{category.Id}")"
                                                       @bind="category.Name"
                                                       @bind:event="oninput"
                                                       @bind:after="QueueDraftSaveAsync"/>

                                                @foreach (var issue in GetFieldIssues(
                                                                  $"CategoryName:{category.Id}"))
                                                {
                                                    <span class="@GetIssueClass(issue)">
                                                        @issue.Message
                                                    </span>
                                                }
                                            </div>

                                            <div class="field rating-field">
                                                <label>Rating</label>

                                                <select @bind="category.Rating"
                                                        @bind:after="QueueDraftSaveAsync">
                                                    <option value="5">5 / 5</option>
                                                    <option value="4">4 / 5</option>
                                                    <option value="3">3 / 5</option>
                                                    <option value="2">2 / 5</option>
                                                    <option value="1">1 / 5</option>
                                                </select>
                                            </div>

                                            <div class="@GetFieldClass(
                                                            $"CategoryNote:{category.Id}")">

                                                <label>Short note</label>

                                                <input type="text"
                                                       @bind="category.Note"
                                                       @bind:event="oninput"
                                                       @bind:after="QueueDraftSaveAsync"/>

                                                @foreach (var issue in GetFieldIssues(
                                                                  $"CategoryNote:{category.Id}"))
                                                {
                                                    <span class="@GetIssueClass(issue)">
                                                        @issue.Message
                                                    </span>
                                                }
                                            </div>

                                            <button class="button danger"
                                                    type="button"
                                                    disabled="@(Draft.Categories.Count <= 1)"
                                                    @onclick="() => RemoveCategory(category)">
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }
                else if (CurrentStep == BuilderStep.Questions)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Written response</h3>

                            <p>
                                Enter one item per line for list-based questions.
                            </p>
                        </div>

                        <div class="field-grid">
                            @if (ShowDetailedQuestions)
                            {
                                <div class="@GetFieldClass(nameof(Draft.WhatWorks))">
                                    <label for="what-works">
                                        What does the game do well?
                                    </label>

                                    <textarea id="what-works"
                                              rows="7"
                                              @bind="Draft.WhatWorks"
                                              @bind:event="oninput"
                                              @bind:after="QueueDraftSaveAsync"></textarea>

                                    @if (!GetFieldIssues(nameof(Draft.WhatWorks)).Any())
                                    {
                                        <span class="field-help">
                    Each nonblank line becomes a separate point.
                </span>
                                    }

                                    @foreach (var issue in GetFieldIssues(
                                                      nameof(Draft.WhatWorks)))
                                    {
                                        <span class="@GetIssueClass(issue)">
                    @issue.Message
                </span>
                                    }
                                </div>

                                <div class="@GetFieldClass(
                                                nameof(Draft.WhatCouldBeBetter))">

                                    <label for="what-could-be-better">
                                        What could be better?
                                    </label>

                                    <textarea id="what-could-be-better"
                                              rows="7"
                                              @bind="Draft.WhatCouldBeBetter"
                                              @bind:event="oninput"
                                              @bind:after="QueueDraftSaveAsync"></textarea>

                                    @if (!GetFieldIssues(
                                                 nameof(Draft.WhatCouldBeBetter)).Any())
                                    {
                                        <span class="field-help">
                    Each nonblank line becomes a separate point.
                </span>
                                    }

                                    @foreach (var issue in GetFieldIssues(
                                                      nameof(Draft.WhatCouldBeBetter)))
                                    {
                                        <span class="@GetIssueClass(issue)">
                    @issue.Message
                </span>
                                    }
                                </div>
                            }

                            <div class="@GetFieldClass(nameof(Draft.FinalThoughts))">
                                <label for="final-thoughts">
                                    @(Draft.DisplayFormat ==
                                    ReviewDisplayFormat.MinimalVerdict
                                        ? "Why?"
                                        : "Final thoughts")
                                </label>

                                <textarea id="final-thoughts"
                                          rows="7"
                                          aria-invalid="@HasFieldError(
                                                            nameof(Draft.FinalThoughts))"
                                          @bind="Draft.FinalThoughts"
                                          @bind:event="oninput"
                                          @bind:after="QueueDraftSaveAsync"></textarea>

                                @foreach (var issue in GetFieldIssues(
                                                  nameof(Draft.FinalThoughts)))
                                {
                                    <span class="@GetIssueClass(issue)">
                @issue.Message
            </span>
                                }
                            </div>
                        </div>
                    </section>
                }
                else if (CurrentStep == BuilderStep.Export)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Your review is ready</h3>

                            <p>
                                Check the generated output before copying it
                                into Steam.
                            </p>
                        </div>

                        <div class="export-summary">
                            <div>
                                <span class="export-label">Title</span>
                                <strong>@DisplayTitle</strong>
                            </div>

                            <div>
                                <span class="export-label">Template</span>
                                <strong>@DisplayTemplateName</strong>
                            </div>

                            <div>
                                <span class="export-label">Format</span>
                                <strong>@DisplayFormatName</strong>
                            </div>

                            <div>
                                <span class="export-label">
                                    Recommendation
                                </span>

                                <strong>@RecommendationName</strong>
                            </div>

                            <div>
                                <span class="export-label">Categories</span>

                                <strong>
                                    @(ShowCategories
                                        ? Draft.Categories.Count
                                        : 0)
                                </strong>
                            </div>
                        </div>

                        <div class="export-notice">
                            Review the complete generated output in the BBCode
                            panel. Copy it when you are ready to paste the
                            review into Steam.
                        </div>

                        <div class="export-actions">
                            <button class="button primary"
                                    type="button"
                                    disabled="@(!CurrentValidation.IsValid)"
                                    @onclick="CopyBbCode">
                                Copy BBCode
                            </button>

                            @if (!string.IsNullOrWhiteSpace(_copyMessage))
                            {
                                <span class="copy-status"
                                      role="status"
                                      aria-live="polite">
                                    @_copyMessage
                                </span>
                            }
                        </div>
                    </section>
                }
            </div>

            <div class="step-navigation">
                <button class="button secondary"
                        type="button"
                        disabled="@(!CanGoBack)"
                        @onclick="PreviousStep">
                    Back
                </button>

                @if (CanGoNext)
                {
                    <button class="button primary"
                            type="button"
                            @onclick="NextStep">
                        @NextButtonLabel
                    </button>
                }
            </div>
        </section>

        <aside class="panel preview-panel">
            <div class="panel-heading">
                <h2>Live output</h2>

                <p>
                    Preview the formatted review or inspect its Steam BBCode.
                </p>
            </div>

            <div class="output-tabs"
                 role="tablist"
                 aria-label="Review output view">
                <button class="@GetOutputTabClass(OutputView.Preview)"
                        type="button"
                        role="tab"
                        aria-selected="@(CurrentOutputView == OutputView.Preview)"
                        @onclick="() => CurrentOutputView = OutputView.Preview">
                    Preview
                </button>

                <button class="@GetOutputTabClass(OutputView.BbCode)"
                        type="button"
                        role="tab"
                        aria-selected="@(CurrentOutputView == OutputView.BbCode)"
                        @onclick="() => CurrentOutputView = OutputView.BbCode">
                    BBCode
                </button>
            </div>

            @if (CurrentOutputView == OutputView.Preview)
            {
                <div class="steam-preview"
                     role="tabpanel"
                     aria-label="Rendered review preview">
                    @RenderedPreview
                </div>
            }
            else
            {
                <textarea class="code-output"
                          rows="36"
                          readonly
                          aria-label="Generated Steam BBCode">@GeneratedBbCode</textarea>
            }
        </aside>
    </main>

    <footer class="app-footer">
        <strong>Unofficial community project.</strong>
        Steam Review Forge is not affiliated with, endorsed by, or sponsored
        by Valve Corporation or Steam.
    </footer>
    @if (_showNewReviewDialog)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseNewReviewDialog">

            <section class="confirmation-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="new-review-dialog-title"
                     aria-describedby="new-review-dialog-description"
                     @onclick:stopPropagation>

                <div class="dialog-content">
                    <h2 id="new-review-dialog-title">
                        Start a new review?
                    </h2>

                    <p id="new-review-dialog-description">
                        Your current saved draft will be permanently cleared.
                        This cannot be undone.
                    </p>
                </div>

                <div class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CloseNewReviewDialog">
                        Keep current review
                    </button>

                    <button class="button danger-solid"
                            type="button"
                            @onclick="ConfirmStartNewReviewAsync">
                        Start new review
                    </button>
                </div>
            </section>
        </div>
    }
</div>

@code {

    private enum BuilderStep
    {
        Template = 1,
        Setup = 2,
        Format = 3,
        Questions = 4,
        Export = 5
    }

    private sealed record TemplateOption(
        ReviewTemplate Template,
        string Code,
        string Name,
        string Description,
        string[] Details);

    private static readonly TemplateOption[] TemplateOptions =
    [
        new(
            ReviewTemplate.Balanced,
            "BAL",
            "Balanced Review",
            "A standard review with ratings and guided written responses.",
            [
                "Rating table layout",
                "Three starter categories",
                "Strengths and weaknesses"
            ]),

        new(
            ReviewTemplate.QuickTake,
            "QT",
            "Quick Take",
            "A short review focused on the final recommendation.",
            [
                "Minimal verdict layout",
                "No category ratings",
                "One final explanation"
            ]),

        new(
            ReviewTemplate.DeepDive,
            "DD",
            "Deep Dive",
            "A detailed review covering more parts of the game.",
            [
                "Individual section layout",
                "Six starter categories",
                "Expanded writing prompts"
            ]),

        new(
            ReviewTemplate.Custom,
            "{}",
            "Full Custom",
            "A mostly blank starting point for building your own review.",
            [
                "One blank category",
                "Empty written responses",
                "Complete manual control"
            ])
    ];

    private ReviewDraft Draft { get; set; } = new();

    private BuilderStep CurrentStep { get; set; } =
        BuilderStep.Template;

    private enum OutputView
    {
        Preview,
        BbCode
    }

    private ReviewTemplate SelectedTemplate { get; set; } =
        ReviewTemplate.Balanced;

    private CancellationTokenSource? _saveDebounce;

    private bool _draftStorageReady;

    private string _saveStatus = "Loading draft…";

    private string _copyMessage = string.Empty;

    private string _theme = "light";

    private bool _showNewReviewDialog;

    private string GeneratedBbCode =>
        SteamBbCodeGenerator.Generate(Draft);
    
    private ReviewValidationResult CurrentValidation =>
        ReviewDraftValidator.Validate(Draft);

    private IEnumerable<ReviewValidationIssue> ValidationErrors =>
        CurrentValidation.Issues.Where(
            issue =>
                issue.Severity ==
                ReviewValidationSeverity.Error);

    private IEnumerable<ReviewValidationIssue> ValidationWarnings =>
        CurrentValidation.Issues.Where(
            issue =>
                issue.Severity ==
                ReviewValidationSeverity.Warning);

    private OutputView CurrentOutputView { get; set; } =
        OutputView.Preview;

    private MarkupString RenderedPreview =>
        new(
            SteamBbCodePreviewRenderer.Render(
                GeneratedBbCode));

    private string GetOutputTabClass(OutputView view)
    {
        return CurrentOutputView == view
            ? "output-tab active"
            : "output-tab";
    }

    private bool ShowCategories =>
        Draft.DisplayFormat is
            ReviewDisplayFormat.RatingTable or
            ReviewDisplayFormat.Sections or
            ReviewDisplayFormat.Checklist;

    private bool ShowDetailedQuestions =>
        Draft.DisplayFormat != ReviewDisplayFormat.MinimalVerdict;

    private bool CanGoBack =>
        (int)CurrentStep > (int)BuilderStep.Template;

    private bool CanGoNext =>
        (int)CurrentStep < (int)BuilderStep.Export;

    private string StepTitle =>
        CurrentStep switch
        {
            BuilderStep.Template => "Review Template",
            BuilderStep.Setup => "Review Setup",
            BuilderStep.Format => "Review Format",
            BuilderStep.Questions => "Review Questionnaire",
            BuilderStep.Export => "Export Review",
            _ => "Review Builder"
        };

    private string StepDescription =>
        CurrentStep switch
        {
            BuilderStep.Template =>
                "Choose a starting point for your review.",

            BuilderStep.Setup =>
                "Enter the basic information for your review.",

            BuilderStep.Format =>
                "Choose a layout and configure category ratings.",

            BuilderStep.Questions =>
                "Answer the guided questions that form the review.",

            BuilderStep.Export =>
                "Review and copy the generated Steam-compatible BBCode.",

            _ => string.Empty
        };

    private string NextButtonLabel =>
        CurrentStep switch
        {
            BuilderStep.Template =>
                "Continue to setup",

            BuilderStep.Setup =>
                "Continue to format",

            BuilderStep.Format =>
                "Continue to questions",

            BuilderStep.Questions =>
                "Generate review",

            _ => "Continue"
        };

    private string SelectedTemplateName =>
        GetTemplateName(SelectedTemplate);

    private string DisplayTemplateName =>
        GetTemplateName(Draft.Template);

    private string DisplayTitle =>
        string.IsNullOrWhiteSpace(Draft.Title)
            ? "Untitled Review"
            : Draft.Title.Trim();

    private string DisplayFormatName =>
        Draft.DisplayFormat switch
        {
            ReviewDisplayFormat.RatingTable =>
                "Rating Table",

            ReviewDisplayFormat.Sections =>
                "Individual Sections",

            ReviewDisplayFormat.Checklist =>
                "Checklist",

            ReviewDisplayFormat.MinimalVerdict =>
                "Minimal Verdict",

            _ => "Unknown"
        };

    private string RecommendationName =>
        Draft.Recommendation switch
        {
            ReviewRecommendation.Recommended =>
                "Recommended",

            ReviewRecommendation.Mixed =>
                "Mixed",

            ReviewRecommendation.NotRecommended =>
                "Not Recommended",

            _ => "Unknown"
        };

    private string DisplayFormatDescription =>
        Draft.DisplayFormat switch
        {
            ReviewDisplayFormat.RatingTable =>
                "Displays ratings and notes in a compact table.",

            ReviewDisplayFormat.Sections =>
                "Displays each category as a separate review section.",

            ReviewDisplayFormat.Checklist =>
                "Displays categories as checked or unchecked review points.",

            ReviewDisplayFormat.MinimalVerdict =>
                "Displays the title, summary, playtime, final thoughts, and recommendation.",

            _ => string.Empty
        };

    private string ThemeToggleIcon =>
        _theme == "dark" ? "☀" : "☾";

    private string ThemeToggleLabel =>
        _theme == "dark"
            ? "Switch to light mode"
            : "Switch to dark mode";

    private async Task SelectTemplate(
        ReviewTemplate template)
    {
        SelectedTemplate = template;

        ReviewTemplateService.Apply(
            Draft,
            SelectedTemplate);

        _copyMessage = string.Empty;

        await SaveDraftImmediatelyAsync();
    }

    private void GoToStep(BuilderStep step)
    {
        CurrentStep = step;
    }

    private void NextStep()
    {
        if (!CanGoNext)
        {
            return;
        }

        CurrentStep =
            (BuilderStep)((int)CurrentStep + 1);
    }

    private void PreviousStep()
    {
        if (!CanGoBack)
        {
            return;
        }

        CurrentStep =
            (BuilderStep)((int)CurrentStep - 1);
    }

    private string GetStepClass(BuilderStep step)
    {
        var classes = new List<string>
        {
            "step-item"
        };

        if (step == CurrentStep)
        {
            classes.Add("active");
        }
        else if ((int)step < (int)CurrentStep)
        {
            classes.Add("visited");
        }
        else
        {
            classes.Add("future");
        }

        var section = GetValidationSection(step);

        if (section.HasValue)
        {
            if (CurrentValidation.HasErrors(section.Value))
            {
                classes.Add("has-error");
            }
            else if (CurrentValidation.HasWarnings(section.Value))
            {
                classes.Add("has-warning");
            }
            else
            {
                classes.Add("complete");
            }
        }
        else if (step == BuilderStep.Template)
        {
            classes.Add("complete");
        }
        else if (step == BuilderStep.Export)
        {
            classes.Add(
                CurrentValidation.IsValid
                    ? "complete"
                    : "has-error");
        }

        return string.Join(' ', classes);
    }

    private static ReviewValidationSection?
    GetValidationSection(BuilderStep step)
    {
        return step switch
        {
            BuilderStep.Setup =>
                ReviewValidationSection.Setup,

            BuilderStep.Format =>
                ReviewValidationSection.Format,

            BuilderStep.Questions =>
                ReviewValidationSection.Questions,

            _ => null
        };
    }

    private string GetStepMarker(BuilderStep step)
    {
        var section = GetValidationSection(step);

        if (section.HasValue)
        {
            if (CurrentValidation.HasErrors(section.Value))
            {
                return "!";
            }

            if (CurrentValidation.HasWarnings(section.Value))
            {
                return "!";
            }

            return "✓";
        }

        if (step == BuilderStep.Template)
        {
            return step == CurrentStep ? "1" : "✓";
        }

        if (step == BuilderStep.Export)
        {
            return CurrentValidation.IsValid ? "✓" : "!";
        }

        return ((int)step).ToString();
    }

    private IEnumerable<ReviewValidationIssue>
        GetFieldIssues(string field)
    {
        return CurrentValidation.ForField(field);
    }

    private bool HasFieldError(string field)
    {
        return GetFieldIssues(field).Any(
            issue =>
                issue.Severity ==
                    ReviewValidationSeverity.Error);
    }

    private string GetFieldClass(string field)
    {
        var issues = GetFieldIssues(field).ToArray();

        if (issues.Any(
                issue =>
                    issue.Severity ==
                        ReviewValidationSeverity.Error))
        {
            return "field full-width has-error";
        }

        if (issues.Any(
                issue =>
                    issue.Severity ==
                        ReviewValidationSeverity.Warning))
        {
            return "field full-width has-warning";
        }

        return "field full-width";
    }

    private static string GetIssueClass(
        ReviewValidationIssue issue)
    {
        return issue.Severity switch
        {
            ReviewValidationSeverity.Error =>
                "field-message error-message",

            ReviewValidationSeverity.Warning =>
                "field-message warning-message",

            _ => "field-message"
        };
    }

    private void GoToFirstError()
    {
        var issue = ValidationErrors.FirstOrDefault();

        if (issue is null)
        {
            return;
        }

        CurrentStep = issue.Section switch
        {
            ReviewValidationSection.Setup =>
                BuilderStep.Setup,

            ReviewValidationSection.Format =>
                BuilderStep.Format,

            ReviewValidationSection.Questions =>
                BuilderStep.Questions,

            _ => CurrentStep
        };
    }

    private string GetTemplateCardClass(
        ReviewTemplate template)
    {
        return SelectedTemplate == template
            ? "template-card selected"
            : "template-card";
    }

    private static string GetTemplateName(
        ReviewTemplate template)
    {
        return template switch
        {
            ReviewTemplate.Balanced =>
                "Balanced Review",

            ReviewTemplate.QuickTake =>
                "Quick Take",

            ReviewTemplate.DeepDive =>
                "Deep Dive",

            ReviewTemplate.Custom =>
                "Full Custom",

            _ => "Unknown"
        };
    }

    private async Task AddCategory()
    {
        Draft.Categories.Add(
            new ReviewCategory());

        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveCategory(
        ReviewCategory category)
    {
        if (Draft.Categories.Count <= 1)
        {
            return;
        }

        Draft.Categories.Remove(category);

        await SaveDraftImmediatelyAsync();
    }

    private async Task CopyBbCode()
    {
        if (!CurrentValidation.IsValid)
        {
            _copyMessage =
                "Complete the required fields before copying.";

            GoToFirstError();
            return;
        }
        try
        {
            await JS.InvokeVoidAsync(
                "clipboardManager.copyText",
                GeneratedBbCode);

            _copyMessage =
                "Copied to clipboard.";
        }
        catch
        {
            _copyMessage =
                "Copy failed. Select the BBCode manually.";
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _theme = await JS.InvokeAsync<string>(
            "themeManager.get");

        await RestoreDraftAsync();

        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _saveDebounce?.Cancel();
        _saveDebounce?.Dispose();

        return ValueTask.CompletedTask;
    }

    private async Task ToggleTheme()
    {
        _theme = await JS.InvokeAsync<string>(
            "themeManager.toggle");
    }

    private async Task RestoreDraftAsync()
    {
        try
        {
            var restoredDraft =
                await DraftStorage.LoadAsync();

            if (restoredDraft is null)
            {
                _saveStatus = "Not saved yet";
                return;
            }

            restoredDraft.Categories ??= [];

            if (restoredDraft.Categories.Count == 0 &&
                restoredDraft.DisplayFormat !=
                ReviewDisplayFormat.MinimalVerdict)
            {
                restoredDraft.Categories.Add(
                    new ReviewCategory());
            }

            Draft = restoredDraft;
            SelectedTemplate = Draft.Template;

            _saveStatus = "Draft restored";
        }
        catch
        {
            _saveStatus = "Draft storage unavailable";
        }
        finally
        {
            _draftStorageReady = true;
        }
    }

    private async Task QueueDraftSaveAsync()
    {
        if (!_draftStorageReady)
        {
            return;
        }

        var previousSave = _saveDebounce;

        _saveDebounce =
            new CancellationTokenSource();

        previousSave?.Cancel();
        previousSave?.Dispose();

        var currentSave = _saveDebounce;

        _saveStatus = "Saving…";

        try
        {
            await Task.Delay(
                500,
                currentSave.Token);

            await DraftStorage.SaveAsync(Draft);

            if (ReferenceEquals(
                    _saveDebounce,
                    currentSave))
            {
                _saveStatus = "Saved";
            }
        }
        catch (OperationCanceledException)
        {
            // A newer edit restarted the save delay.
        }
        catch
        {
            if (ReferenceEquals(
                    _saveDebounce,
                    currentSave))
            {
                _saveStatus =
                    "Draft storage unavailable";
            }
        }
    }

    private async Task SaveDraftImmediatelyAsync()
    {
        if (!_draftStorageReady)
        {
            return;
        }

        _saveDebounce?.Cancel();

        _saveStatus = "Saving…";

        try
        {
            await DraftStorage.SaveAsync(Draft);
            _saveStatus = "Saved";
        }
        catch
        {
            _saveStatus =
                "Draft storage unavailable";
        }
    }

    private void OpenNewReviewDialog()
    {
        _showNewReviewDialog = true;
    }

    private void CloseNewReviewDialog()
    {
        _showNewReviewDialog = false;
    }

    private async Task ConfirmStartNewReviewAsync()
    {
        try
        {
            _saveDebounce?.Cancel();

            await DraftStorage.ClearAsync();

            Draft = new ReviewDraft();
            SelectedTemplate = Draft.Template;

            CurrentStep = BuilderStep.Template;
            CurrentOutputView = OutputView.Preview;

            _copyMessage = string.Empty;
            _saveStatus = "Not saved yet";
            _showNewReviewDialog = false;
        }
        catch
        {
            _saveStatus =
                "Unable to clear saved draft";
        }
    }

}
