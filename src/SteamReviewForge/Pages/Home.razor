    {
        if (!SetupComplete)
        {
            return;
        }

        if (SelectedBbCodeTemplate is { } template)
        {
            ReviewTemplateService.Apply(Draft, template);
            SelectedTemplate = template;
            Draft.RawBbCode =
                SteamBbCodeGenerator.Generate(Draft);
        }
        else
        {
            Draft.RawBbCode = string.Empty;
        }

        CurrentBbCodeStep = BbCodeStep.Composer;

        await SaveDraftImmediatelyAsync();
    }

    private void NextBbCodeStep()
    {
        if (CurrentBbCodeStep == BbCodeStep.Composer &&
                 !string.IsNullOrWhiteSpace(Draft.RawBbCode))
        {
            CurrentBbCodeStep = BbCodeStep.FinalPreview;
        }
    }

    private void PreviousBbCodeStep()
    {
        if (CurrentBbCodeStep > BbCodeStep.Setup)
        {
            CurrentBbCodeStep--;
        }
    }

    private async Task GoToBbCodeStepAsync(BbCodeStep step)
    {
        if (step == BbCodeStep.Setup)
        {
            CurrentBbCodeStep = step;
            return;
        }

        if (!SetupComplete)
        {
            return;
        }

        if (step == BbCodeStep.FinalPreview &&
            string.IsNullOrWhiteSpace(Draft.RawBbCode))
        {
            return;
        }

        if (CurrentBbCodeStep == BbCodeStep.Setup &&
            step == BbCodeStep.Composer)
        {
            if (string.IsNullOrWhiteSpace(Draft.RawBbCode))
            {
                await ApplyBbCodeStartingPointAsync();
            }
            else
            {
                CurrentBbCodeStep = step;
            }

            return;
        }

        CurrentBbCodeStep = step;
    }

