    private async Task UpdateRatingSystemAsync(
        ChangeEventArgs eventArgs)
    {
        if (!Enum.TryParse<ReviewRatingSystem>(
                eventArgs.Value?.ToString(),
                out var ratingSystem))
        {
            return;
        }

        await SetRatingSystemAsync(ratingSystem);
    }

    private async Task SetRatingSystemAsync(
        ReviewRatingSystem ratingSystem)
    {
        if (ratingSystem == Draft.RatingSystem)
        {
            return;
        }

        var previousMaximum = RatingMaximum;
        var nextMaximum =
            ratingSystem switch
            {
                ReviewRatingSystem.TenPoint => 10,
                ReviewRatingSystem.Text =>
                    Math.Max(
                        1,
                        Draft.TextRatingOptions.Count),
                _ => 5
            };

        if (previousMaximum != nextMaximum)
        {
            foreach (var category in Draft.Categories)
            {
                var normalized = previousMaximum <= 1
                    ? 0d
                    : (category.Rating - 1d) /
                      (previousMaximum - 1d);

                category.Rating = Math.Clamp(
                    (int)Math.Round(
                        1d +
                        normalized *
                        (nextMaximum - 1d),
                        MidpointRounding.AwayFromZero),
                    1,
                    nextMaximum);
            }
        }

        Draft.RatingSystem = ratingSystem;

        await SaveDraftImmediatelyAsync();
    }

    private async Task AddTextRatingOptionAsync()
    {
        Draft.TextRatingOptions.Add(
            $"Rating {Draft.TextRatingOptions.Count + 1}");

        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveTextRatingOptionAsync(
        int index)
    {
        if (Draft.TextRatingOptions.Count <= 1 ||
            index < 0 ||
            index >= Draft.TextRatingOptions.Count)
        {
            return;
        }

        Draft.TextRatingOptions.RemoveAt(index);

        foreach (var category in Draft.Categories)
        {
            if (category.Rating > index + 1)
            {
                category.Rating--;
            }
            else if (category.Rating ==
                     index + 1)
            {
                category.Rating = Math.Min(
                    category.Rating,
                    Draft.TextRatingOptions.Count);
            }
        }

        await SaveDraftImmediatelyAsync();
    }

    private async Task UpdateTextRatingOptionAsync(
        int index,
        ChangeEventArgs eventArgs)
    {
        if (index < 0 ||
            index >= Draft.TextRatingOptions.Count)
        {
            return;
        }

        Draft.TextRatingOptions[index] =
            eventArgs.Value?.ToString() ??
            string.Empty;

        await QueueDraftSaveAsync();
    }

