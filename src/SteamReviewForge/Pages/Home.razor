    private async Task UpdateRatingSystemAsync(
        ChangeEventArgs eventArgs)
    {
        if (!Enum.TryParse<ReviewRatingSystem>(
                eventArgs.Value?.ToString(),
                out var ratingSystem) ||
            ratingSystem == Draft.RatingSystem)
        {
            return;
        }

        var previousMaximum = RatingMaximum;
        var nextMaximum =
            ratingSystem switch
            {
                ReviewRatingSystem.TenPoint => 10,
                ReviewRatingSystem.Text =>
                    Math.Max(
                        1,
                        Draft.TextRatingOptions.Count),
                _ => 5
            };

        if (previousMaximum != nextMaximum)
        {
            foreach (var category in Draft.Categories)
            {
                var normalized =
                    (category.Rating - 1d) /
                    (previousMaximum - 1d);

                category.Rating = Math.Clamp(
                    (int)Math.Round(
                        1d +
                        normalized *
                        (nextMaximum - 1d),
                        MidpointRounding.AwayFromZero),
                    1,
                    nextMaximum);
            }
        }

        Draft.RatingSystem = ratingSystem;

        await SaveDraftImmediatelyAsync();
    }

    private async Task AddTextRatingOptionAsync()
    {
