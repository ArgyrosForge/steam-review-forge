    private void BeginReviewComponentDrag(
        ReviewContentComponent component)
    {
        _draggedReviewComponentId = component.Id;
    }

    private void EndReviewComponentDrag()
    {
        _draggedReviewComponentId = null;
    }

    private async Task DropReviewComponentAsync(
        ReviewContentComponent target)
    {
        if (_draggedReviewComponentId is null ||
            _draggedReviewComponentId == target.Id)
        {
            return;
        }

        var source = Draft.Components.FirstOrDefault(
            component => component.Id == _draggedReviewComponentId);

        if (source is null)
        {
            return;
        }

        var targetIndex = Draft.Components.IndexOf(target);
        Draft.Components.Remove(source);
        Draft.Components.Insert(targetIndex, source);
        _draggedReviewComponentId = null;

        await SaveDraftImmediatelyAsync();
    }

    private async Task MoveReviewComponentAsync(
        ReviewContentComponent component,
        int offset)
    {
        var currentIndex = Draft.Components.IndexOf(component);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.Components.Count)
        {
            return;
        }

        Draft.Components.RemoveAt(currentIndex);
        Draft.Components.Insert(targetIndex, component);
        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveReviewComponentAsync(
        ReviewContentComponent component)
    {
        Draft.Components.Remove(component);
        await SaveDraftImmediatelyAsync();
    }

