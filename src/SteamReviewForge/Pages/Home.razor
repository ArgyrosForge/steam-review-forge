                </div>

                <div class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CloseResetTemplateDialog">
                        Keep current edits
                    </button>

                    <button class="button danger-solid"
                            type="button"
                            @onclick="ConfirmResetTemplateAsync">
                        Reset template content
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_showBbCodeViewer)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseBbCodeViewer">
            <section class="bbcode-viewer-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="bbcode-viewer-title"
                     aria-describedby="bbcode-viewer-description"
                     @onkeydown="HandleBbCodeViewerKeyDown"
                     @onclick:stopPropagation>
                <header class="bbcode-viewer-header">
                    <div>
                        <span class="bbcode-viewer-eyebrow">
                            Generated Steam markup
                        </span>
                        <h2 id="bbcode-viewer-title">View BBCode</h2>
                        <p id="bbcode-viewer-description">
                            Review the generated code before copying it to Steam.
                        </p>
                    </div>

                    <button class="bbcode-viewer-close"
                            type="button"
                            aria-label="Close BBCode viewer"
                            @onclick="CloseBbCodeViewer">
                        ×
                    </button>
                </header>

                <textarea class="bbcode-viewer-code"
                          readonly
                          spellcheck="false"
                          aria-label="Generated Steam BBCode"
                          value="@GeneratedBbCode"></textarea>

                @if (!string.IsNullOrWhiteSpace(_copyMessage))
                {
                    <span class="copy-status bbcode-viewer-copy-status"
                          role="status"
                          aria-live="polite">
                        @_copyMessage
                    </span>
                }

                <footer class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CloseBbCodeViewer">
                        Close
                    </button>
                    <button class="button primary"
                            type="button"
                            @onclick="CopyBbCode">
                        Copy BBCode
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_showFormattingHelp)
    {
        <div class="modal-backdrop help-backdrop"
             role="presentation"
             @onclick="CloseFormattingHelp">
            <section class="formatting-help-drawer"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="formatting-help-title"
                     @onkeydown="HandleFormattingHelpKeyDown"
                     @onclick:stopPropagation>
                <header class="formatting-help-header">
                    <div>
                        <span class="help-eyebrow">Steam reference</span>
                        <h2 id="formatting-help-title">
                            Formatting help
                        </h2>
                    </div>

                    <button class="help-close"
                            type="button"
                            aria-label="Close formatting help"
                            @onclick="CloseFormattingHelp">
                        ×
                    </button>
                </header>

                <div class="formatting-help-content">
                    <p>
                        Steam uses BBCode-style tags in reviews. Steam Review
                        Forge generates and previews the tags used by its
                        templates; Steam supports additional formatting too.
                    </p>

                    <dl class="formatting-reference">
                        <div>
                            <dt>Headings</dt>
                            <dd><code>[h1]Heading[/h1]</code></dd>
                        </div>
                        <div>
                            <dt>Emphasis</dt>
                            <dd>
                                <code>[b]Bold[/b]</code>
                                <code>[i]Italic[/i]</code>
                                <code>[u]Underline[/u]</code>
                            </dd>
                        </div>
                        <div>
                            <dt>Lists</dt>
                            <dd>
                                <code>[list][*]Item[/list]</code>
                                <code>[olist][*]Item[/olist]</code>
                            </dd>
                        </div>
                        <div>
                            <dt>Links</dt>
                            <dd>
                                <code>[url=https://…]Text[/url]</code>
                            </dd>
                        </div>
                        <div>
                            <dt>Other useful tags</dt>
                            <dd>
                                <code>[spoiler]Text[/spoiler]</code>
                                <code>[quote]Text[/quote]</code>
                                <code>[hr][/hr]</code>
                            </dd>
                        </div>
                    </dl>

                    <a class="steam-help-link"
                       href="https://steamcommunity.com/comment/Recommendation/formattinghelp"
                       target="_blank"
                       rel="noopener noreferrer">
                        Open Steam's complete formatting guide
                    </a>
                </div>
            </section>
        </div>
    }
</div>

@code {

    private enum BuilderStep
    {
        Setup = 1,
        Template = 2,
        Format = 3,
        Questions = 4
    }

    private enum BbCodeStep
    {
        Setup = 1,
        Composer = 2,
        FinalPreview = 3
    }

    private sealed record TemplateOption(
        ReviewTemplate Template,
        string Code,
        string Name,
        string Description,
        string[] Details);

    private sealed record AppearanceState(
