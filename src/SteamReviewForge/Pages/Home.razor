    private string GetCustomCellValue(
        ReviewCategory category,
        ReviewTableColumn column)
    {
        return category.CustomCells.TryGetValue(
            column.Id,
            out var value)
            ? value
            : string.Empty;
    }

    private async Task UpdateCustomCellAsync(
        ReviewCategory category,
        ReviewTableColumn column,
        ChangeEventArgs eventArgs)
    {
        category.CustomCells[column.Id] =
            eventArgs.Value?.ToString() ??
            string.Empty;

        await QueueDraftSaveAsync();
    }

    private async Task AddColumnAsync(
        ReviewTableColumnKind kind)
    {
        if (kind != ReviewTableColumnKind.CustomText &&
            HasTableColumn(kind))
        {
            return;
        }

        var column = new ReviewTableColumn
        {
            Heading = GetDefaultColumnHeading(kind),
            Kind = kind
        };

        Draft.TableColumns.Add(column);
        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveColumnAsync(
        ReviewTableColumn column)
    {
        if (Draft.TableColumns.Count == 1)
        {
            return;
        }

        Draft.TableColumns.Remove(column);

        if (column.Kind ==
            ReviewTableColumnKind.CustomText)
        {
            foreach (var category in Draft.Categories)
                category.CustomCells.Remove(column.Id);
        }

        _draggedColumnId = null;
        await SaveDraftImmediatelyAsync();
    }

    private async Task MoveColumnAsync(
        ReviewTableColumn column,
        int offset)
    {
        var currentIndex =
            Draft.TableColumns.IndexOf(column);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.TableColumns.Count)
        {
            return;
        }

        Draft.TableColumns.RemoveAt(currentIndex);
        Draft.TableColumns.Insert(targetIndex, column);

        await SaveDraftImmediatelyAsync();
    }

    private void BeginColumnDrag(
        ReviewTableColumn column)
    {
        _draggedColumnId = column.Id;
        _columnDropTargetId = null;
    }

    private void SetColumnDropTarget(
        ReviewTableColumn column)
    {
        if (_draggedColumnId is not null)
            _columnDropTargetId = column.Id;
    }

    private void EndColumnDrag()
    {
        _draggedColumnId = null;
        _columnDropTargetId = null;
    }

    private async Task DropColumnAsync(
        ReviewTableColumn target)
    {
        if (_draggedColumnId is null ||
            _draggedColumnId == target.Id)
        {
            return;
        }

        var source = Draft.TableColumns.FirstOrDefault(
            column =>
                column.Id == _draggedColumnId);

        if (source is null)
        {
            _draggedColumnId = null;
            return;
        }

        MoveItemToTarget(
            Draft.TableColumns,
            source,
            target);

        _draggedColumnId = null;
        _columnDropTargetId = null;
        await SaveDraftImmediatelyAsync();
    }

    private void BeginRowDrag(
        ReviewCategory category)
    {
        _draggedRowId = category.Id;
        _rowDropTargetId = null;
    }

    private void SetRowDropTarget(
        ReviewCategory category)
    {
        if (_draggedRowId is not null)
            _rowDropTargetId = category.Id;
    }

    private void EndRowDrag()
    {
        _draggedRowId = null;
        _rowDropTargetId = null;
