    private async Task ConfirmStartNewReviewAsync()
    {
        try
        {
            _saveDebounce?.Cancel();

            _saveRevision++;

            await DraftStorage.ClearAsync();

            var editingMode = Draft.EditingMode;

            Draft = new ReviewDraft
            {
                EditingMode = editingMode
            };
            SelectedTemplate = Draft.Template;

            CurrentStep = BuilderStep.Setup;
            CurrentBbCodeStep = BbCodeStep.Setup;
            SelectedBbCodeTemplate = null;
            HasSelectedBbCodeStartingPoint = false;

            _copyMessage = string.Empty;
            _saveStatus = "Not saved yet";
            _showNewReviewDialog = false;
            _showFormattingHelp = false;
            _showTableConfigurer = false;
            _showResetTemplateDialog = false;
            await SetUnsavedChangesAsync(false);
        }
        catch
        {
            _saveStatus =
                "Unable to clear saved draft";
        }
    }

