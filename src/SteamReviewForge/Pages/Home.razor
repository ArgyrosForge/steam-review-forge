@page "/"

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject ReviewDraftStorageService DraftStorage

@using Microsoft.AspNetCore.Components
@using SteamReviewForge.Models
@using SteamReviewForge.Services

<PageTitle>Steam Review Forge</PageTitle>

<div class="app-shell">
    <header class="app-header">
        <div class="brand-lockup">
            <span class="brand-mark"
                  aria-hidden="true">&gt;_</span>

            <div class="brand-copy">
                <span class="brand-eyebrow">
                    ARGYROSDEV // REVIEW TOOL
                </span>

                <h1>
                    Steam Review <span>Forge</span>
                </h1>

                <p>
                    Build a structured review and copy the generated Steam BBCode.
                </p>
            </div>
        </div>

        <div class="header-actions">
            <span class="save-status"
                  role="status"
                  aria-live="polite">
                @_saveStatus
            </span>

            <button class="button new-review-button"
                    type="button"
                    @onclick="OpenNewReviewDialog">
                New review
            </button>

            <button class="button help-button"
                    type="button"
                    @onclick="OpenFormattingHelp">
                Formatting help
            </button>

            <button class="theme-toggle"
                    type="button"
                    title="@ThemeToggleLabel"
                    aria-label="@ThemeToggleLabel"
                    @onclick="ToggleTheme">
                <span class="theme-toggle-prompt"
                      aria-hidden="true">&gt;_</span>
                <span>@ColorModeLabel</span>
            </button>
        </div>
    </header>

    <main class="builder-layout">
        <aside class="panel workflow-panel">
            <div class="panel-heading">
                <h2>Review Builder</h2>
                <p>Complete each step to create your review.</p>
            </div>

            <ol class="step-list">
                <li>
                    <button class="@GetStepClass(BuilderStep.Setup)"
                            type="button"
                            @onclick="() => GoToStep(BuilderStep.Setup)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Setup)
                        </span>

                        <span>
                            <strong>Setup</strong>
                            <small>Recommendation and summary</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.Template)"
                            type="button"
                            disabled="@(!SetupComplete)"
                            @onclick="() => GoToStep(BuilderStep.Template)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Template)
                        </span>

                        <span>
                            <strong>Template</strong>
                            <small>Choose a starting point</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.Format)"
                            type="button"
                            disabled="@(!SetupComplete)"
                            @onclick="() => GoToStep(BuilderStep.Format)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Format)
                        </span>

                        <span>
                            <strong>Format</strong>
                            <small>Layout and category ratings</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.Questions)"
                            type="button"
                            disabled="@(!SetupComplete)"
                            @onclick="() => GoToStep(BuilderStep.Questions)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.Questions)
                        </span>

                        <span>
                            <strong>Questions</strong>
                            <small>Write the review content</small>
                        </span>
                    </button>
                </li>

                <li>
                    <button class="@GetStepClass(BuilderStep.FinalPreview)"
                            type="button"
                            disabled="@(!CanOpenFinalPreview)"
                            @onclick="() => GoToStep(BuilderStep.FinalPreview)">
                        <span class="step-number">
                            @GetStepMarker(BuilderStep.FinalPreview)
                        </span>

                        <span>
                            <strong>Final Preview</strong>
                            <small>Review the finished Steam post</small>
                        </span>
                    </button>
                </li>

            </ol>

            <div class="workflow-editor">
            <div class="workflow-editor-heading">
                <h2>@StepTitle</h2>
                <p>@StepDescription</p>
            </div>

            @RenderRatingSystemEditor()

            <div class="step-content">
                @if (CurrentStep == BuilderStep.Template)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Choose a review template</h3>

                            <p>
                                Templates provide starter content, categories,
                                and a recommended display format.
                            </p>
                        </div>

                        <div class="template-title-field">
                            <div class="@GetFieldClass(nameof(Draft.Title))">
                                <label for="review-title">
                                    Review title
                                </label>

                                <input id="review-title"
                                       type="text"
                                       aria-invalid="@HasFieldError(
                                                         nameof(Draft.Title))"
                                       @bind="Draft.Title"
                                       @bind:event="oninput"
                                       @bind:after="QueueDraftSaveAsync"/>

                                @foreach (var issue in GetFieldIssues(
                                                  nameof(Draft.Title)))
                                {
                                    <span class="@GetIssueClass(issue)">
                                        @issue.Message
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="template-grid"
                             role="radiogroup"
                             aria-label="Review template">
                            @foreach (var option in TemplateOptions)
                            {
                                <button class="@GetTemplateCardClass(option.Template)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(SelectedTemplate == option.Template
                                                          ? "true"
                                                          : "false")"
                                        @onclick="() => SelectTemplate(option.Template)">
                                    <div class="template-card-header">
                                        <span class="template-code"
                                              aria-hidden="true">
                                            @option.Code
                                        </span>

                                        @if (SelectedTemplate == option.Template)
                                        {
                                            <span class="template-selected">
                                                Selected
                                            </span>
                                        }
                                    </div>

                                    <h4>@option.Name</h4>
                                    <p>@option.Description</p>

                                    <ul>
                                        @foreach (var detail in option.Details)
                                        {
                                            <li>@detail</li>
                                        }
                                    </ul>
                                </button>
                            }
                        </div>

                        <div class="template-note"
                             role="status"
                             aria-live="polite">
                            <strong>@SelectedTemplateName</strong>
                            is currently applied to this review.
                        </div>
                    </section>
                }
                else if (CurrentStep == BuilderStep.Setup)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Would you recommend this game?</h3>

                            <p>
                                Please describe what you liked or disliked about
                                this game and whether you recommend it to others.
                                Please remember to be polite and follow the
                                Rules and Guidelines.
                            </p>
                        </div>

                        <div class="recommendation-choice"
                             role="radiogroup"
                             aria-label="Recommendation">
                            <button class="@GetRecommendationChoiceClass(
                                               ReviewRecommendation.Recommended)"
                                    type="button"
                                    role="radio"
                                    aria-checked="@(Draft.Recommendation ==
                                                      ReviewRecommendation.Recommended)"
                                    @onclick="() => SelectRecommendationAsync(
                                                        ReviewRecommendation.Recommended)">
                                <span class="recommendation-choice-icon positive"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         focusable="false">
                                        <path d="M8.35 20H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10h3.85v10Zm2-10 3.3-6.25c.3-.57.9-.9 1.54-.82a1.5 1.5 0 0 1 1.3 1.67L15.9 9h3.17a2 2 0 0 1 1.95 2.43l-1.47 6.5A2.65 2.65 0 0 1 16.96 20h-6.61V10Z"/>
                                    </svg>
                                </span>
                                <span>
                                    <strong>Yes</strong>
                                    Recommended
                                </span>
                            </button>

                            <button class="@GetRecommendationChoiceClass(
                                               ReviewRecommendation.NotRecommended)"
                                    type="button"
                                    role="radio"
                                    aria-checked="@(Draft.Recommendation ==
                                                      ReviewRecommendation.NotRecommended)"
                                    @onclick="() => SelectRecommendationAsync(
                                                        ReviewRecommendation.NotRecommended)">
                                <span class="recommendation-choice-icon negative"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         focusable="false">
                                        <path d="M8.35 20H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10h3.85v10Zm2-10 3.3-6.25c.3-.57.9-.9 1.54-.82a1.5 1.5 0 0 1 1.3 1.67L15.9 9h3.17a2 2 0 0 1 1.95 2.43l-1.47 6.5A2.65 2.65 0 0 1 16.96 20h-6.61V10Z"/>
                                    </svg>
                                </span>
                                <span>
                                    <strong>No</strong>
                                    Not Recommended
                                </span>
                            </button>
                        </div>

                        @foreach (var issue in GetFieldIssues(
                                          nameof(Draft.Recommendation)))
                        {
                            <span class="@GetIssueClass(issue)">
                                @issue.Message
                            </span>
                        }

                        @if (HasRecommendation)
                        {
                            <div class="setup-details">
                                <div class="field-grid">
                                    <div class="@GetFieldClass(nameof(Draft.Summary))">
                                        <label for="review-summary">
                                            Short summary
                                        </label>

                                        <input id="review-summary"
                                               type="text"
                                               required
                                               aria-invalid="@HasFieldError(
                                                                 nameof(Draft.Summary))"
                                               placeholder="Summarize your opinion in one sentence"
                                               @bind="Draft.Summary"
                                               @bind:event="oninput"
                                               @bind:after="QueueDraftSaveAsync"/>

                                        @foreach (var issue in GetFieldIssues(
                                                          nameof(Draft.Summary)))
                                        {
                                            <span class="@GetIssueClass(issue)">
                                                @issue.Message
                                            </span>
                                        }
                                    </div>

                                    <div class="@GetFieldClass(nameof(Draft.Playtime))">
                                        <label for="playtime">
                                            Playtime
                                        </label>

                                        <input id="playtime"
                                               type="number"
                                               min="0"
                                               max="@PlaytimeFormatter.MaximumHours"
                                               step="0.1"
                                               inputmode="decimal"
                                               value="@Draft.Playtime"
                                               @oninput="UpdatePlaytimeAsync"/>

                                        <span class="field-help">
                                            Enter hours as a number. Preview
                                            only; not included in BBCode.
                                        </span>

                                        @foreach (var issue in GetFieldIssues(
                                                          nameof(Draft.Playtime)))
                                        {
                                            <span class="@GetIssueClass(issue)">
                                                @issue.Message
                                            </span>
                                        }
                                    </div>

                                    <label class="steam-checkbox full-width">
                                        <input type="checkbox"
                                               @bind="Draft.ReceivedProductForFree"
                                               @bind:after="QueueDraftSaveAsync"/>
                                        <span>
                                            Check this box if you received this
                                            product for free
                                        </span>
                                    </label>
                                </div>
                            </div>
                        }
                    </section>
                }
                else if (CurrentStep == BuilderStep.Format)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Display format</h3>

                            <p>
                                Choose how the generated review is structured.
                            </p>
                        </div>

                        <div class="field">
                            <label for="display-format">
                                Review layout
                            </label>

                            <select id="display-format"
                                    @bind="Draft.DisplayFormat"
                                    @bind:after="QueueDraftSaveAsync">
                                <option value="@ReviewDisplayFormat.RatingTable">
                                    Rating Table
                                </option>

                                <option value="@ReviewDisplayFormat.Sections">
                                    Individual Sections
                                </option>

                                <option value="@ReviewDisplayFormat.Checklist">
                                    Checklist
                                </option>

                                <option value="@ReviewDisplayFormat.MinimalVerdict">
                                    Minimal Verdict
                                </option>
                            </select>

                            <span class="field-help">
                                @DisplayFormatDescription
                            </span>
                        </div>
                    </section>

                    @if (ShowCategories)
                    {
                        <div class="format-editing-note">
                            <strong>Configure the rating table in one place.</strong>
                            Use <strong>Table Editor</strong> to edit
                            columns, row content, ratings, order, and structure.
                            The Steam preview remains read-only for tables.
                        </div>
                    }
                    else
                    {
                        <div class="format-editing-note">
                            Minimal Verdict does not include category sections.
                            Choose another layout to edit category ratings.
                        </div>
                    }
                }
                else if (CurrentStep == BuilderStep.Questions)
                {
                    <div class="format-editing-note">
                        <strong>Write directly in the Steam preview.</strong>
                        Enter one item per line for strengths and weaknesses;
                        the BBCode preview updates as you type.
                    </div>
                }
                else if (CurrentStep == BuilderStep.FinalPreview)
                {
                    <div class="final-preview-note">
                        This is the finalized Steam Review Preview. Editing is
                        disabled here so you can inspect the review exactly as
                        it will appear before copying the BBCode.
                    </div>
                }
            </div>

            <div class="step-navigation">
                <button class="button secondary"
                        type="button"
                        disabled="@(!CanGoBack)"
                        @onclick="PreviousStep">
                    Back
                </button>

                @if (CanGoNext)
                {
                    <button class="button primary"
                            type="button"
                            disabled="@(!CanAdvance)"
                            @onclick="NextStep">
                        @NextButtonLabel
                    </button>
                }
            </div>
            </div>
        </aside>

        <aside class="panel preview-panel">
            <div class="panel-heading preview-panel-heading">
                <div>
                    <h2>
                        @(IsFinalPreview
                            ? "Final Steam Review"
                            : CurrentStep == BuilderStep.Setup
                            ? "Steam setup preview"
                            : HasRecommendation
                            ? "Editable Steam preview"
                            : "Steam preview")
                    </h2>

                    <p>
                        @(IsFinalPreview
                            ? "A read-only preview of the finished review."
                            : CurrentStep == BuilderStep.Setup
                            ? "A basic preview of the Steam review metadata."
                            : HasRecommendation
                            ? "Edit the review directly at any workflow step."
                            : "Choose a recommendation to unlock editing.")
                    </p>
                </div>

                @if (!IsFinalPreview &&
                     CurrentStep != BuilderStep.Setup &&
                     SetupComplete)
                {
                    <div class="preview-editor-actions">
                        @if (Draft.DisplayFormat ==
                             ReviewDisplayFormat.RatingTable)
                        {
                            <button class="button secondary"
                                    type="button"
                                    @onclick="OpenTableConfigurer">
                                Table Editor
                            </button>
                        }

                        <button class="button secondary"
                                type="button"
                                @onclick="OpenResetTemplateDialog">
                            Reset
                        </button>
                    </div>
                }
            </div>

            @if (!IsFinalPreview &&
                 PreviewEditingIssues.Any())
            {
                <div class="preview-validation"
                     role="status"
                     aria-live="polite">
                    <strong>Review these editor items:</strong>

                    <ul>
                        @foreach (var issue in PreviewEditingIssues)
                        {
                            <li>@issue.Message</li>
                        }
                    </ul>
                </div>
            }

            <div class="@SteamPreviewClass"
                 aria-label="Rendered review preview">
                <div class="steam-review-page">
                    <article class="steam-review-card">
                        <header class="steam-review-header">
                            <span class="@SteamRecommendationIconClass"
                                  aria-hidden="true">
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <path d="M8.35 20H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10h3.85v10Zm2-10 3.3-6.25c.3-.57.9-.9 1.54-.82a1.5 1.5 0 0 1 1.3 1.67L15.9 9h3.17a2 2 0 0 1 1.95 2.43l-1.47 6.5A2.65 2.65 0 0 1 16.96 20h-6.61V10Z"/>
                                </svg>
                            </span>

                            <span class="steam-review-verdict">
                                <strong>@RecommendationName</strong>
                                <small>@SteamPlaytimeLabel</small>
                            </span>
                        </header>

                        <div class="steam-review-content">
                            <div class="steam-review-date">
                                Posted: @SteamPreviewDate
                            </div>

                            @if (Draft.ReceivedProductForFree)
                            {
                                <div class="steam-product-disclosure">
                                    Product received for free
                                </div>
                            }

                            @if (CurrentStep == BuilderStep.Setup)
                            {
                                <p class="steam-setup-summary">
                                    @Draft.Summary
                                </p>
                            }
                            else if (HasRecommendation &&
                                 !IsFinalPreview)
                            {
                                <div class="steam-intro-editor">
                                    <h1 class="steam-editable-title">
                                        <input class="steam-inline-input steam-title-input"
                                               type="text"
                                               aria-label="Review title"
                                               @bind="Draft.Title"
                                               @bind:event="oninput"
                                               @bind:after="QueueDraftSaveAsync"/>
                                    </h1>

                                    <input class="steam-inline-input steam-summary-input"
                                           type="text"
                                           aria-label="Short review summary"
                                           placeholder="Summarize your opinion in one sentence"
                                           @bind="Draft.Summary"
                                           @bind:event="oninput"
                                           @bind:after="QueueDraftSaveAsync"/>
                                </div>

                                <hr />

                                @if (Draft.DisplayFormat ==
                                     ReviewDisplayFormat.RatingTable)
                                {
                                    @RenderedCategoriesPreview
                                }
                                else if (Draft.DisplayFormat ==
                                         ReviewDisplayFormat.Sections)
                                {
                                    <div class="steam-editable-sections">
                                        @foreach (var category in Draft.Categories)
                                        {
                                            <section class="steam-editable-section"
                                                     @key="category.Id"
                                                     @ondragover:preventDefault
                                                     @ondrop="() => DropRowAsync(category)">
                                                @RenderCategoryControls(category)

                                                <input class="steam-inline-input steam-section-heading-input"
                                                       type="text"
                                                       aria-label="Section name"
                                                       aria-invalid="@HasFieldError(
                                                                         $"CategoryName:{category.Id}")"
                                                       @bind="category.Name"
                                                       @bind:event="oninput"
                                                       @bind:after="QueueDraftSaveAsync"/>

                                                @RenderRatingEditor(category)

                                                <textarea class="steam-inline-input steam-inline-textarea"
                                                          rows="2"
                                                          aria-label="@($"{category.Name} note")"
                                                          @bind="category.Note"
                                                          @bind:event="oninput"
                                                          @bind:after="QueueDraftSaveAsync"></textarea>

                                            </section>
                                        }

                                        <div class="steam-add-category-row">
                                            @RenderAddCategoryControl()
                                        </div>
                                    </div>
                                }
                                else if (Draft.DisplayFormat ==
                                         ReviewDisplayFormat.Checklist)
                                {
                                    <div class="steam-editable-checklist">
                                        @foreach (var category in Draft.Categories)
                                        {
                                            <section class="steam-editable-check-item"
                                                     @key="category.Id"
                                                     @ondragover:preventDefault
                                                     @ondrop="() => DropRowAsync(category)">
                                                <span class="steam-check-marker"
                                                      aria-hidden="true">
                                                    @(IsPositiveCategoryRating(category)
                                                        ? "☑"
                                                        : "☐")
                                                </span>

                                                <div class="steam-check-edit-content">
                                                    <input class="steam-inline-input steam-category-name"
                                                           type="text"
                                                           aria-label="Checklist category name"
                                                           aria-invalid="@HasFieldError(
                                                                             $"CategoryName:{category.Id}")"
                                                           @bind="category.Name"
                                                           @bind:event="oninput"
                                                           @bind:after="QueueDraftSaveAsync"/>

                                                    @RenderRatingEditor(category)

                                                    <input class="steam-inline-input"
                                                           type="text"
                                                           aria-label="@($"{category.Name} note")"
                                                           @bind="category.Note"
                                                           @bind:event="oninput"
                                                           @bind:after="QueueDraftSaveAsync"/>

                                                </div>

                                                @RenderCategoryControls(category)
                                            </section>
                                        }

                                        <div class="steam-add-category-row">
                                            @RenderAddCategoryControl()
                                        </div>
                                    </div>
                                }

                                <hr />

                                <div class="steam-writing-editor">
                                    @if (ShowDetailedQuestions)
                                    {
                                        <label>
                                            <span>What Works</span>
                                            <textarea class="steam-inline-input steam-writing-textarea"
                                                      rows="5"
                                                      placeholder="Enter one strength per line"
                                                      @bind="Draft.WhatWorks"
                                                      @bind:event="oninput"
                                                      @bind:after="QueueDraftSaveAsync"></textarea>
                                        </label>

                                        <label>
                                            <span>What Could Be Better</span>
                                            <textarea class="steam-inline-input steam-writing-textarea"
                                                      rows="5"
                                                      placeholder="Enter one weakness per line"
                                                      @bind="Draft.WhatCouldBeBetter"
                                                      @bind:event="oninput"
                                                      @bind:after="QueueDraftSaveAsync"></textarea>
                                        </label>
                                    }

                                    <label>
                                        <span>
                                            @(Draft.DisplayFormat ==
                                              ReviewDisplayFormat.MinimalVerdict
                                                ? "Why?"
                                                : "Final Thoughts")
                                        </span>
                                        <textarea class="steam-inline-input steam-writing-textarea"
                                                  rows="6"
                                                  aria-invalid="@HasFieldError(
                                                                    nameof(Draft.FinalThoughts))"
                                                  @bind="Draft.FinalThoughts"
                                                  @bind:event="oninput"
                                                  @bind:after="QueueDraftSaveAsync"></textarea>
                                    </label>

                                </div>
                            }
                            else
                            {
                                @RenderedPreview
                            }
                        </div>
                    </article>
                </div>
            </div>
        </aside>

        <aside class="panel bbcode-panel">
            <div class="panel-heading output-panel-heading">
                <div>
                    <h2>BBCode Preview</h2>

                    @if (ValidationErrors.Any())
                    {
                        <p class="bbcode-validation-note">
                            @ValidationErrors.Count() required
                            @(ValidationErrors.Count() == 1 ? "item" : "items")
                            still incomplete.
                        </p>
                    }
                    else
                    {
                        <p>Generated code updates as you edit.</p>
                    }
                </div>

                <button class="button primary"
                        type="button"
                        @onclick="CopyBbCode">
                    Copy BBCode
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_copyMessage))
            {
                <span class="copy-status bbcode-copy-status"
                      role="status"
                      aria-live="polite">
                    @_copyMessage
                </span>
            }

            <textarea class="code-output"
                      rows="36"
                      readonly
                      aria-label="Generated Steam BBCode">@GeneratedBbCode</textarea>
        </aside>
    </main>

    <footer class="app-footer">
        <strong>Unofficial community project.</strong>
        Steam Review Forge is not affiliated with, endorsed by, or sponsored
        by Valve Corporation or Steam.
    </footer>
    @if (_showNewReviewDialog)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseNewReviewDialog">

            <section class="confirmation-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="new-review-dialog-title"
                     aria-describedby="new-review-dialog-description"
                     @onclick:stopPropagation>

                <div class="dialog-content">
                    <h2 id="new-review-dialog-title">
                        Start a new review?
                    </h2>

                    <p id="new-review-dialog-description">
                        Your current saved draft will be permanently cleared.
                        This cannot be undone.
                    </p>
                </div>

                <div class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CloseNewReviewDialog">
                        Keep current review
                    </button>

                    <button class="button danger-solid"
                            type="button"
                            @onclick="ConfirmStartNewReviewAsync">
                        Start new review
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_showTableConfigurer)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseTableConfigurer">
            <section class="table-configurer-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="table-configurer-title"
                     @onclick:stopPropagation>
                <header class="table-configurer-header">
                    <div>
                        <span class="help-eyebrow">Rating table</span>
                        <h2 id="table-configurer-title">
                            Table Editor
                        </h2>
                    </div>

                    <button class="help-close"
                            type="button"
                            aria-label="Close Table Editor"
                            @onclick="CloseTableConfigurer">
                        ×
                    </button>
                </header>

                <div class="table-configurer-content">
                    <p>
                        Manage every part of the rating table here. Drag items
                        to reorder them, or use the controls on the right.
                    </p>

                    <div class="table-editor-toolbar">
                        <label class="table-editor-rating-system">
                            <span>Rating system</span>

                            <select value="@Draft.RatingSystem"
                                    @onchange="UpdateRatingSystemAsync">
                                <option value="@ReviewRatingSystem.TenPoint">
                                    1–10 Numbers
                                </option>

                                <option value="@ReviewRatingSystem.FivePoint">
                                    1–5 Numbers
                                </option>

                                <option value="@ReviewRatingSystem.FiveStars">
                                    1–5 Stars
                                </option>

                                <option value="@ReviewRatingSystem.Text">
                                    Text Rating
                                </option>
                            </select>
                        </label>

                        <div>
                            @foreach (var columnKind in MissingBuiltInColumns)
                            {
                                <button type="button"
                                        @onclick="() => AddColumnAsync(columnKind)">
                                    + @GetDefaultColumnHeading(columnKind)
                                </button>
                            }

                        </div>
                    </div>

                    <div class="steam-preview finalized table-editor-shell"
                         aria-label="Editable rating table">
                        <div class="steam-review-page">
                            <article class="steam-review-card">
                                <div class="steam-review-content">
                                    <div class="table-editor-scroll">
                                        <table class="preview-table table-editor">
                                            <thead>
                                                <tr>
                                                    <th class="table-editor-row-number">
                                                        #
                                                    </th>

                                                    @foreach (var column in Draft.TableColumns)
                                                    {
                                                        <th class="@GetConfigurerColumnClass(column)"
                                                            @key="column.Id"
                                                            draggable="true"
                                                            data-table-drag-handle
                                                            title="Drag to reorder column"
                                                            data-drag-preview="column"
                                                            @ondragstart="() => BeginColumnDrag(column)"
                                                            @ondragend="EndColumnDrag"
                                                            @ondragover:preventDefault
                                                            @ondragenter="() => SetColumnDropTarget(column)"
                                                            @ondrop="() => DropColumnAsync(column)">
                                                            <span class="table-configurer-drag-rail horizontal"
                                                                  aria-hidden="true">
                                                            </span>

                                                            <input type="text"
                                                                   aria-label="@($"{GetColumnKindLabel(column.Kind)} column heading")"
                                                                   aria-invalid="@HasFieldError(
                                                                                     $"ColumnHeading:{column.Id}")"
                                                                   @bind="column.Heading"
                                                                   @bind:event="oninput"
                                                                   @bind:after="QueueDraftSaveAsync"/>

                                                            <div class="table-configurer-actions"
                                                                 role="group"
                                                                 aria-label="@($"{column.Heading} column actions")">
                                                                <button type="button"
                                                                        title="Move column left"
                                                                        aria-label="@($"Move {column.Heading} column left")"
                                                                        disabled="@(Draft.TableColumns.IndexOf(column) == 0)"
                                                                        @onclick="() => MoveColumnAsync(column, -1)">
                                                                    ←
                                                                </button>

                                                                <button type="button"
                                                                        title="Move column right"
                                                                        aria-label="@($"Move {column.Heading} column right")"
                                                                        disabled="@(Draft.TableColumns.IndexOf(column) ==
                                                                                    Draft.TableColumns.Count - 1)"
                                                                        @onclick="() => MoveColumnAsync(column, 1)">
                                                                    →
                                                                </button>

                                                                <button class="remove"
                                                                        type="button"
                                                                        title="Remove column"
                                                                        aria-label="@($"Remove {column.Heading} column")"
                                                                disabled="@(Draft.TableColumns.Count == 1)"
                                                                @onclick="() => RemoveColumnAsync(column)">
                                                                    Remove column
                                                                </button>
                                                            </div>
                                                        </th>
                                                    }

                                                    <th class="table-editor-actions-heading"
                                                        aria-label="Table actions">
                                                        <button type="button"
                                                                @onclick="() => AddColumnAsync(
                                                                                    ReviewTableColumnKind.CustomText)">
                                                            + Column
                                                        </button>

                                                        <button type="button"
                                                                @onclick="AddCategoryAsync">
                                                            + Row
                                                        </button>
                                                    </th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var category in Draft.Categories)
                                                {
                                                    <tr @key="category.Id"
                                                        class="@GetConfigurerRowClass(category)"
                                                        data-drag-preview="row"
                                                        @ondragover:preventDefault
                                                        @ondragenter="() => SetRowDropTarget(category)"
                                                        @ondrop="() => DropRowAsync(category)">
                                                        <th class="table-editor-row-number"
                                                            draggable="true"
                                                            data-table-drag-handle
                                                            title="Drag to reorder row"
                                                            aria-label="@($"Drag row {Draft.Categories.IndexOf(category) + 1}")"
                                                            @ondragstart="() => BeginRowDrag(category)"
                                                            @ondragend="EndRowDrag">
                                                            <span class="table-configurer-drag-rail"
                                                                  aria-hidden="true">
                                                            </span>

                                                            @(Draft.Categories.IndexOf(category) + 1)
                                                        </th>

                                                        @foreach (var column in Draft.TableColumns)
                                                        {
                                                            <td @key="column.Id">
                                                                @RenderConfigurerCell(
                                                                    category,
                                                                    column)
                                                            </td>
                                                        }

                                                        <td class="table-configurer-actions table-editor-row-actions"
                                                            aria-label="@($"{category.Name} row actions")">
                                                            <button type="button"
                                                                    title="Move row up"
                                                                    aria-label="@($"Move {category.Name} row up")"
                                                                    disabled="@(Draft.Categories.IndexOf(category) == 0)"
                                                                    @onclick="() => MoveCategoryAsync(category, -1)">
                                                                ↑
                                                            </button>

                                                            <button type="button"
                                                                    title="Move row down"
                                                                    aria-label="@($"Move {category.Name} row down")"
                                                                    disabled="@(Draft.Categories.IndexOf(category) ==
                                                                                Draft.Categories.Count - 1)"
                                                                    @onclick="() => MoveCategoryAsync(category, 1)">
                                                                ↓
                                                            </button>

                                                            <button class="remove"
                                                                    type="button"
                                                                    title="Remove row"
                                                                    aria-label="@($"Remove {category.Name} row")"
                                                                    @onclick="() => RemoveCategory(category)">
                                                                Remove row
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>

                <footer class="dialog-actions">
                    <button class="button primary"
                            type="button"
                            @onclick="CloseTableConfigurer">
                        Done
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_showResetTemplateDialog)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseResetTemplateDialog">
            <section class="confirmation-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="reset-template-dialog-title"
                     aria-describedby="reset-template-dialog-description"
                     @onclick:stopPropagation>
                <div class="dialog-content">
                    <h2 id="reset-template-dialog-title">
                        Reset to @SelectedTemplateName?
                    </h2>

                    <p id="reset-template-dialog-description">
                        This restores the template layout, columns, rows, and
                        guided writing. Your Setup information, review title,
                        and rating system will be preserved.
                    </p>
                </div>

                <div class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CloseResetTemplateDialog">
                        Keep current edits
                    </button>

                    <button class="button danger-solid"
                            type="button"
                            @onclick="ConfirmResetTemplateAsync">
                        Reset template content
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_showFormattingHelp)
    {
        <div class="modal-backdrop help-backdrop"
             role="presentation"
             @onclick="CloseFormattingHelp">
            <section class="formatting-help-drawer"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="formatting-help-title"
                     @onkeydown="HandleFormattingHelpKeyDown"
                     @onclick:stopPropagation>
                <header class="formatting-help-header">
                    <div>
                        <span class="help-eyebrow">Steam reference</span>
                        <h2 id="formatting-help-title">
                            Formatting help
                        </h2>
                    </div>

                    <button class="help-close"
                            type="button"
                            aria-label="Close formatting help"
                            @onclick="CloseFormattingHelp">
                        ×
                    </button>
                </header>

                <div class="formatting-help-content">
                    <p>
                        Steam uses BBCode-style tags in reviews. Steam Review
                        Forge generates and previews the tags used by its
                        templates; Steam supports additional formatting too.
                    </p>

                    <dl class="formatting-reference">
                        <div>
                            <dt>Headings</dt>
                            <dd><code>[h1]Heading[/h1]</code></dd>
                        </div>
                        <div>
                            <dt>Emphasis</dt>
                            <dd>
                                <code>[b]Bold[/b]</code>
                                <code>[i]Italic[/i]</code>
                                <code>[u]Underline[/u]</code>
                            </dd>
                        </div>
                        <div>
                            <dt>Lists</dt>
                            <dd>
                                <code>[list][*]Item[/list]</code>
                                <code>[olist][*]Item[/olist]</code>
                            </dd>
                        </div>
                        <div>
                            <dt>Links</dt>
                            <dd>
                                <code>[url=https://…]Text[/url]</code>
                            </dd>
                        </div>
                        <div>
                            <dt>Other useful tags</dt>
                            <dd>
                                <code>[spoiler]Text[/spoiler]</code>
                                <code>[quote]Text[/quote]</code>
                                <code>[hr][/hr]</code>
                            </dd>
                        </div>
                    </dl>

                    <a class="steam-help-link"
                       href="https://steamcommunity.com/comment/Recommendation/formattinghelp"
                       target="_blank"
                       rel="noopener noreferrer">
                        Open Steam's complete formatting guide
                    </a>
                </div>
            </section>
        </div>
    }
</div>

@code {

    private enum BuilderStep
    {
        Setup = 1,
        Template = 2,
        Format = 3,
        Questions = 4,
        FinalPreview = 5
    }

    private sealed record TemplateOption(
        ReviewTemplate Template,
        string Code,
        string Name,
        string Description,
        string[] Details);

    private sealed record AppearanceState(
        string Theme,
        string ColorMode);

    private static readonly TemplateOption[] TemplateOptions =
    [
        new(
            ReviewTemplate.Balanced,
            "BAL",
            "Balanced Review",
            "A standard review with ratings and guided written responses.",
            [
                "Rating table layout",
                "Three starter categories",
                "Strengths and weaknesses"
            ]),

        new(
            ReviewTemplate.QuickTake,
            "QT",
            "Quick Take",
            "A short review focused on the final recommendation.",
            [
                "Minimal verdict layout",
                "No category ratings",
                "One final explanation"
            ]),

        new(
            ReviewTemplate.DeepDive,
            "DD",
            "Deep Dive",
            "A detailed review covering more parts of the game.",
            [
                "Individual section layout",
                "Six starter categories",
                "Expanded writing prompts"
            ]),

        new(
            ReviewTemplate.Custom,
            "{}",
            "Full Custom",
            "A mostly blank starting point for building your own review.",
            [
                "One blank category",
                "Empty written responses",
                "Complete manual control"
            ])
    ];

    private ReviewDraft Draft { get; set; } = new();

    private BuilderStep CurrentStep { get; set; } =
        BuilderStep.Setup;

    private ReviewTemplate SelectedTemplate { get; set; } =
        ReviewTemplate.Balanced;

    private CancellationTokenSource? _saveDebounce;

    private bool _draftStorageReady;

    private string _saveStatus = "Loading draft…";

    private string _copyMessage = string.Empty;

    private AppearanceState _appearance =
        new("main-blue", "dark");

    private bool _showNewReviewDialog;

    private bool _showFormattingHelp;

    private bool _showTableConfigurer;

    private bool _showResetTemplateDialog;

    private Guid? _draggedRowId;

    private Guid? _draggedColumnId;

    private Guid? _columnDropTargetId;

    private Guid? _rowDropTargetId;

    private string GeneratedBbCode =>
        CurrentStep == BuilderStep.Setup
            ? SteamBbCodeGenerator.GenerateSetupPreview(Draft)
            : SteamBbCodeGenerator.Generate(Draft);
    
    private ReviewValidationResult CurrentValidation =>
        ReviewDraftValidator.Validate(Draft);

    private IEnumerable<ReviewValidationIssue> ValidationErrors =>
        CurrentValidation.Issues.Where(
            issue =>
                issue.Severity ==
                ReviewValidationSeverity.Error);

    private IEnumerable<ReviewValidationIssue> PreviewEditingIssues =>
        CurrentStep switch
        {
            BuilderStep.Format =>
                CurrentValidation.Issues.Where(
                    issue =>
                        issue.Section ==
                        ReviewValidationSection.Format &&
                        (issue.Field ==
                         nameof(Draft.Categories) ||
                         issue.Field.StartsWith(
                             "ColumnHeading:",
                             StringComparison.Ordinal))),

            BuilderStep.Questions =>
                CurrentValidation.Issues.Where(
                    issue =>
                        issue.Section ==
                        ReviewValidationSection.Questions),

            _ => []
        };

    private MarkupString RenderedPreview =>
        new(
            SteamBbCodePreviewRenderer.Render(
                GeneratedBbCode));

    private MarkupString RenderedCategoriesPreview =>
        new(
            SteamBbCodePreviewRenderer.Render(
                SteamBbCodeGenerator.GenerateCategories(
                    Draft)));

    private bool ShowCategories =>
        Draft.DisplayFormat is
            ReviewDisplayFormat.RatingTable or
            ReviewDisplayFormat.Sections or
            ReviewDisplayFormat.Checklist;

    private bool ShowDetailedQuestions =>
        Draft.DisplayFormat != ReviewDisplayFormat.MinimalVerdict;

    private bool HasRecommendation =>
        Draft.Recommendation is not null;

    private bool SetupComplete =>
        HasRecommendation &&
        !CurrentValidation.HasErrors(
            ReviewValidationSection.Setup);

    private bool IsFinalPreview =>
        CurrentStep == BuilderStep.FinalPreview;

    private bool CanOpenFinalPreview =>
        SetupComplete &&
        CurrentValidation.IsValid;

    private string SteamPreviewClass =>
        CurrentStep switch
        {
            BuilderStep.Setup =>
                "steam-preview basic",

            BuilderStep.FinalPreview =>
                "steam-preview finalized",

            _ when Draft.DisplayFormat ==
                   ReviewDisplayFormat.RatingTable =>
                "steam-preview table-readonly",

            _ => "steam-preview"
        };

    private bool CanGoBack =>
        (int)CurrentStep > (int)BuilderStep.Setup;

    private bool CanGoNext =>
        (int)CurrentStep < (int)BuilderStep.FinalPreview;

    private bool CanAdvance =>
        CurrentStep switch
        {
            BuilderStep.Setup => SetupComplete,
            BuilderStep.Template =>
                !CurrentValidation.HasErrors(
                    ReviewValidationSection.Template),
            BuilderStep.Questions => CanOpenFinalPreview,
            _ => true
        };

    private string StepTitle =>
        CurrentStep switch
        {
            BuilderStep.Template => "Review Template",
            BuilderStep.Setup => "Review Setup",
            BuilderStep.Format => "Review Format",
            BuilderStep.Questions => "Review Questionnaire",
            BuilderStep.FinalPreview => "Final Preview",
            _ => "Review Builder"
        };

    private string StepDescription =>
        CurrentStep switch
        {
            BuilderStep.Template =>
                "Choose a starting point for your review.",

            BuilderStep.Setup =>
                "Set the Steam metadata and required summary.",

            BuilderStep.Format =>
                "Choose a layout and configure category ratings.",

            BuilderStep.Questions =>
                "Answer the guided questions that form the review.",

            BuilderStep.FinalPreview =>
                "Inspect the completed read-only Steam review.",

            _ => string.Empty
        };

    private string NextButtonLabel =>
        CurrentStep switch
        {
            BuilderStep.Setup =>
                "Continue to template",

            BuilderStep.Template =>
                "Continue to format",

            BuilderStep.Format =>
                "Continue to questions",

            BuilderStep.Questions =>
                "Open final preview",

            _ => "Continue"
        };

    private string SelectedTemplateName =>
        GetTemplateName(SelectedTemplate);

    private string RecommendationName =>
        Draft.Recommendation switch
        {
            ReviewRecommendation.Recommended =>
                "Recommended",

            ReviewRecommendation.NotRecommended =>
                "Not Recommended",

            _ => "Recommendation not selected"
        };

    private string SteamRecommendationIconClass =>
        Draft.Recommendation switch
        {
            ReviewRecommendation.Recommended =>
                "steam-recommendation-icon",

            ReviewRecommendation.NotRecommended =>
                "steam-recommendation-icon negative",

            _ => "steam-recommendation-icon pending"
        };

    private string SteamPlaytimeLabel
    {
        get
        {
            var playtime = string.IsNullOrWhiteSpace(Draft.Playtime)
                ? "0"
                : Draft.Playtime.Trim();

            return $"{playtime} hrs on record";
        }
    }

    private async Task UpdatePlaytimeAsync(
        ChangeEventArgs eventArgs)
    {
        Draft.Playtime = PlaytimeFormatter.Normalize(
            eventArgs.Value?.ToString());

        await QueueDraftSaveAsync();
    }

    private async Task SelectRecommendationAsync(
        ReviewRecommendation recommendation)
    {
        Draft.Recommendation = recommendation;
        _copyMessage = string.Empty;

        await SaveDraftImmediatelyAsync();
    }

    private string GetRecommendationChoiceClass(
        ReviewRecommendation recommendation)
    {
        return Draft.Recommendation == recommendation
            ? "recommendation-option selected"
            : "recommendation-option";
    }

    private string SteamPreviewDate =>
        DateTime.Today.ToString("MMMM d, yyyy");

    private string DisplayFormatDescription =>
        Draft.DisplayFormat switch
        {
            ReviewDisplayFormat.RatingTable =>
                "Displays ratings and notes in a compact table.",

            ReviewDisplayFormat.Sections =>
                "Displays each category as a separate review section.",

            ReviewDisplayFormat.Checklist =>
                "Displays categories as checked or unchecked review points.",

            ReviewDisplayFormat.MinimalVerdict =>
                "Displays the title, summary, and final thoughts as a compact verdict.",

            _ => string.Empty
        };

    private string RatingSystemDescription =>
        Draft.RatingSystem switch
        {
            ReviewRatingSystem.TenPoint =>
                "Scores each category from 1 through 10.",

            ReviewRatingSystem.FivePoint =>
                "Scores each category from 1 through 5.",

            ReviewRatingSystem.FiveStars =>
                "Displays a five-star rating for each category.",

            ReviewRatingSystem.Text =>
                "Uses the customizable text options below.",

            _ => string.Empty
        };

    private int RatingMaximum =>
        Draft.RatingSystem switch
        {
            ReviewRatingSystem.TenPoint => 10,
            ReviewRatingSystem.Text =>
                Math.Max(
                    1,
                    Draft.TextRatingOptions.Count),
            _ => 5
        };

    private IEnumerable<ReviewTableColumnKind>
        MissingBuiltInColumns =>
        new[]
        {
            ReviewTableColumnKind.Category,
            ReviewTableColumnKind.Rating,
            ReviewTableColumnKind.Note
        }.Where(kind => !HasTableColumn(kind));

    private async Task UpdateRatingSystemAsync(
        ChangeEventArgs eventArgs)
    {
        if (!Enum.TryParse<ReviewRatingSystem>(
                eventArgs.Value?.ToString(),
                out var ratingSystem) ||
            ratingSystem == Draft.RatingSystem)
        {
            return;
        }

        var previousMaximum = RatingMaximum;
        var nextMaximum =
            ratingSystem switch
            {
                ReviewRatingSystem.TenPoint => 10,
                ReviewRatingSystem.Text =>
                    Math.Max(
                        1,
                        Draft.TextRatingOptions.Count),
                _ => 5
            };

        if (previousMaximum != nextMaximum)
        {
            foreach (var category in Draft.Categories)
            {
                var normalized =
                    (category.Rating - 1d) /
                    (previousMaximum - 1d);

                category.Rating = Math.Clamp(
                    (int)Math.Round(
                        1d +
                        normalized *
                        (nextMaximum - 1d),
                        MidpointRounding.AwayFromZero),
                    1,
                    nextMaximum);
            }
        }

        Draft.RatingSystem = ratingSystem;

        await SaveDraftImmediatelyAsync();
    }

    private async Task AddTextRatingOptionAsync()
    {
        Draft.TextRatingOptions.Add(
            $"Rating {Draft.TextRatingOptions.Count + 1}");

        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveTextRatingOptionAsync(
        int index)
    {
        if (Draft.TextRatingOptions.Count <= 1 ||
            index < 0 ||
            index >= Draft.TextRatingOptions.Count)
        {
            return;
        }

        Draft.TextRatingOptions.RemoveAt(index);

        foreach (var category in Draft.Categories)
        {
            if (category.Rating > index + 1)
            {
                category.Rating--;
            }
            else if (category.Rating ==
                     index + 1)
            {
                category.Rating = Math.Min(
                    category.Rating,
                    Draft.TextRatingOptions.Count);
            }
        }

        await SaveDraftImmediatelyAsync();
    }

    private async Task UpdateTextRatingOptionAsync(
        int index,
        ChangeEventArgs eventArgs)
    {
        if (index < 0 ||
            index >= Draft.TextRatingOptions.Count)
        {
            return;
        }

        Draft.TextRatingOptions[index] =
            eventArgs.Value?.ToString() ??
            string.Empty;

        await QueueDraftSaveAsync();
    }

    private string ColorModeLabel =>
        _appearance.ColorMode == "dark"
            ? "DARK"
            : "LIGHT";

    private string ThemeToggleLabel =>
        _appearance.ColorMode == "dark"
            ? "Switch to light mode"
            : "Switch to dark mode";

    private async Task SelectTemplate(
        ReviewTemplate template)
    {
        SelectedTemplate = template;

        ReviewTemplateService.Apply(
            Draft,
            SelectedTemplate);

        _copyMessage = string.Empty;

        await SaveDraftImmediatelyAsync();
    }

    private void GoToStep(BuilderStep step)
    {
        if (step != BuilderStep.Setup &&
            !SetupComplete)
        {
            return;
        }

        if (step == BuilderStep.FinalPreview &&
            !CanOpenFinalPreview)
        {
            return;
        }

        CurrentStep = step;
    }

    private void NextStep()
    {
        if (!CanGoNext)
        {
            return;
        }

        if (!CanAdvance)
        {
            return;
        }

        CurrentStep =
            (BuilderStep)((int)CurrentStep + 1);
    }

    private void PreviousStep()
    {
        if (!CanGoBack)
        {
            return;
        }

        CurrentStep =
            (BuilderStep)((int)CurrentStep - 1);
    }

    private string GetStepClass(BuilderStep step)
    {
        var classes = new List<string>
        {
            "step-item"
        };

        if (step == CurrentStep)
        {
            classes.Add("active");
        }
        else if ((int)step < (int)CurrentStep)
        {
            classes.Add("visited");
        }
        else
        {
            classes.Add("future");
        }

        if ((int)step >= (int)CurrentStep)
        {
            return string.Join(' ', classes);
        }

        var section = GetValidationSection(step);

        if (section.HasValue)
        {
            if (CurrentValidation.HasErrors(section.Value))
            {
                classes.Add("has-error");
            }
            else if (CurrentValidation.HasWarnings(section.Value))
            {
                classes.Add("has-warning");
            }
            else
            {
                classes.Add("complete");
            }
        }
        return string.Join(' ', classes);
    }

    private static ReviewValidationSection?
        GetValidationSection(BuilderStep step)
    {
        return step switch
        {
            BuilderStep.Setup =>
                ReviewValidationSection.Setup,

            BuilderStep.Template =>
                ReviewValidationSection.Template,

            BuilderStep.Format =>
                ReviewValidationSection.Format,

            BuilderStep.Questions =>
                ReviewValidationSection.Questions,

            _ => null
        };
    }

    private string GetStepMarker(BuilderStep step)
    {
        if ((int)step >= (int)CurrentStep)
        {
            return ((int)step).ToString();
        }

        var section = GetValidationSection(step);

        if (section.HasValue &&
            (CurrentValidation.HasErrors(section.Value) ||
             CurrentValidation.HasWarnings(section.Value)))
        {
            return "!";
        }

        return "✓";
    }

    private IEnumerable<ReviewValidationIssue>
        GetFieldIssues(string field)
    {
        return CurrentValidation.ForField(field);
    }

    private IEnumerable<ReviewValidationIssue>
        GetCategoryIssues(ReviewCategory category)
    {
        return GetFieldIssues(
                $"CategoryName:{category.Id}")
            .Concat(
                GetFieldIssues(
                    $"CategoryNote:{category.Id}"));
    }

    private bool HasFieldError(string field)
    {
        return GetFieldIssues(field).Any(
            issue =>
                issue.Severity ==
                    ReviewValidationSeverity.Error);
    }

    private string GetFieldClass(string field)
    {
        var issues = GetFieldIssues(field).ToArray();

        if (issues.Any(
                issue =>
                    issue.Severity ==
                        ReviewValidationSeverity.Error))
        {
            return "field full-width has-error";
        }

        if (issues.Any(
                issue =>
                    issue.Severity ==
                        ReviewValidationSeverity.Warning))
        {
            return "field full-width has-warning";
        }

        return "field full-width";
    }

    private static string GetIssueClass(
        ReviewValidationIssue issue)
    {
        return issue.Severity switch
        {
            ReviewValidationSeverity.Error =>
                "field-message error-message",

            ReviewValidationSeverity.Warning =>
                "field-message warning-message",

            _ => "field-message"
        };
    }

    private string GetTemplateCardClass(
        ReviewTemplate template)
    {
        return SelectedTemplate == template
            ? "template-card selected"
            : "template-card";
    }

    private static string GetTemplateName(
        ReviewTemplate template)
    {
        return template switch
        {
            ReviewTemplate.Balanced =>
                "Balanced Review",

            ReviewTemplate.QuickTake =>
                "Quick Take",

            ReviewTemplate.DeepDive =>
                "Deep Dive",

            ReviewTemplate.Custom =>
                "Full Custom",

            _ => "Unknown"
        };
    }

    private RenderFragment RenderRatingSystemEditor() =>
        @<section class="persistent-rating-system">
            <div class="field">
                <label for="rating-system">
                    Rating system
                </label>

                <select id="rating-system"
                        value="@Draft.RatingSystem"
                        @onchange="UpdateRatingSystemAsync">
                    <option value="@ReviewRatingSystem.TenPoint">
                        1–10 Numbers
                    </option>

                    <option value="@ReviewRatingSystem.FivePoint">
                        1–5 Numbers
                    </option>

                    <option value="@ReviewRatingSystem.FiveStars">
                        1–5 Stars
                    </option>

                    <option value="@ReviewRatingSystem.Text">
                        Text Rating
                    </option>
                </select>

                <span class="field-help">
                    @RatingSystemDescription
                </span>
            </div>

            @if (Draft.RatingSystem ==
                 ReviewRatingSystem.Text)
            {
                <div class="text-rating-options">
                    <div class="text-rating-options-heading">
                        <strong>Text rating options</strong>

                        <button class="button secondary"
                                type="button"
                                @onclick="AddTextRatingOptionAsync">
                            Add option
                        </button>
                    </div>

                    @for (var optionIndex = 0;
                          optionIndex <
                          Draft.TextRatingOptions.Count;
                          optionIndex++)
                    {
                        var index = optionIndex;

                        <div class="text-rating-option"
                             @key="index">
                            <input type="text"
                                   aria-label="@($"Text rating option {index + 1}")"
                                   aria-invalid="@HasFieldError(
                                                     $"TextRatingOption:{index}")"
                                   value="@Draft.TextRatingOptions[index]"
                                   @oninput="eventArgs =>
                                       UpdateTextRatingOptionAsync(
                                           index,
                                           eventArgs)"/>

                            <button class="button danger"
                                    type="button"
                                    disabled="@(Draft.TextRatingOptions.Count <= 1)"
                                    aria-label="@($"Remove text rating option {index + 1}")"
                                    @onclick="() =>
                                        RemoveTextRatingOptionAsync(index)">
                                −
                            </button>

                            @foreach (var issue in GetFieldIssues(
                                              $"TextRatingOption:{index}"))
                            {
                                <span class="@GetIssueClass(issue)">
                                    @issue.Message
                                </span>
                            }
                        </div>
                    }
                </div>
            }
        </section>;

    private RenderFragment RenderConfigurerCell(
        ReviewCategory category,
        ReviewTableColumn column) =>
        @<div class="table-configurer-cell">
            @switch (column.Kind)
            {
                case ReviewTableColumnKind.Category:
                    <input type="text"
                           aria-label="Category name"
                           aria-invalid="@HasFieldError(
                                             $"CategoryName:{category.Id}")"
                           @bind="category.Name"
                           @bind:event="oninput"
                           @bind:after="QueueDraftSaveAsync"/>
                    break;

                case ReviewTableColumnKind.Rating:
                    @RenderRatingEditor(category)
                    break;

                case ReviewTableColumnKind.Note:
                    <input type="text"
                           aria-label="@($"{category.Name} note")"
                           @bind="category.Note"
                           @bind:event="oninput"
                           @bind:after="QueueDraftSaveAsync"/>
                    break;

                case ReviewTableColumnKind.CustomText:
                    <input type="text"
                           aria-label="@($"{column.Heading} for {category.Name}")"
                           value="@GetCustomCellValue(category, column)"
                           @oninput="eventArgs =>
                               UpdateCustomCellAsync(
                                   category,
                                   column,
                                   eventArgs)"/>
                    break;
            }
        </div>;

    private RenderFragment RenderRatingEditor(
        ReviewCategory category) =>
        @<div class="steam-rating-editor"
              aria-label="@($"{category.Name} rating")">
            @if (Draft.RatingSystem ==
                 ReviewRatingSystem.Text)
            {
                <select class="steam-rating-select"
                        aria-label="@($"{category.Name} text rating")"
                        value="@category.Rating"
                        @onchange="eventArgs =>
                            SetCategoryRatingFromEventAsync(
                                category,
                                eventArgs)">
                    @foreach (var score in Enumerable.Range(
                                      1,
                                      RatingMaximum))
                    {
                        <option value="@score">
                            @GetTextRating(score)
                        </option>
                    }
                </select>
            }
            else if (Draft.RatingSystem ==
                     ReviewRatingSystem.FiveStars)
            {
                <div class="steam-rating-choices"
                     role="radiogroup"
                     aria-label="@($"{category.Name} rating")">
                    @foreach (var score in Enumerable.Range(1, 5))
                    {
                        <button class="@GetRatingChoiceClass(
                                           category.Rating,
                                           score)"
                                type="button"
                                role="radio"
                                aria-checked="@(category.Rating == score)"
                                aria-label="@($"Set {category.Name} rating to {score} out of 5")"
                                @onclick="() => SetCategoryRatingAsync(
                                                    category,
                                                    score)">
                            ★
                        </button>
                    }
                </div>
            }
            else
            {
                <input class="steam-rating-number-input"
                       type="number"
                       min="1"
                       max="@RatingMaximum"
                       step="1"
                       inputmode="numeric"
                       aria-label="@($"{category.Name} rating from 1 to {RatingMaximum}")"
                       value="@category.Rating"
                       @oninput="eventArgs =>
                           SetCategoryRatingFromEventAsync(
                               category,
                               eventArgs)"/>
            }
        </div>;

    private RenderFragment RenderCategoryControls(
        ReviewCategory category,
        bool isTableRow = false) =>
        @<div class="steam-category-editor-gutter"
              draggable="@isTableRow"
              @ondragstart="() => BeginRowDrag(category)"
              @ondragend="EndRowDrag">
            <div class="steam-category-controls"
                 role="group"
                 aria-label="@($"Reorder or remove {category.Name}")">
                <button class="steam-category-control move"
                        type="button"
                        title="Move category up"
                        aria-label="@($"Move {category.Name} up")"
                        disabled="@(Draft.Categories.IndexOf(category) == 0)"
                        @onclick="() => MoveCategoryAsync(category, -1)">
                    ↑
                </button>

                <button class="steam-category-control move"
                        type="button"
                        title="Move category down"
                        aria-label="@($"Move {category.Name} down")"
                        disabled="@(Draft.Categories.IndexOf(category) ==
                                    Draft.Categories.Count - 1)"
                        @onclick="() => MoveCategoryAsync(category, 1)">
                    ↓
                </button>

                <button class="steam-category-control remove"
                        type="button"
                        title="Remove category"
                        aria-label="@($"Remove category {category.Name}")"
                        @onclick="() => RemoveCategory(category)">
                    −
                </button>
            </div>

            @foreach (var issue in GetCategoryIssues(category))
            {
                <span class="@GetCategoryValidationClass(issue)">
                    @issue.Message
                </span>
            }
        </div>;

    private RenderFragment RenderRowInsertControl(
        ReviewCategory category) =>
        @<button class="steam-row-insert"
                 type="button"
                 title="Insert row above"
                 aria-label="@($"Insert row above {category.Name}")"
                 @onclick="() => AddCategoryAtAsync(
                                     Draft.Categories.IndexOf(category))">
            +
        </button>;

    private static string GetCategoryValidationClass(
        ReviewValidationIssue issue)
    {
        return issue.Severity ==
               ReviewValidationSeverity.Warning
            ? "category-gutter-validation warning"
            : "category-gutter-validation error";
    }

    private RenderFragment RenderAddCategoryControl() =>
        @<button class="steam-category-control add"
                 type="button"
                 title="Add category"
                 aria-label="Add category after the last category"
                 @onclick="AddCategoryAsync">
            +
        </button>;

    private static string GetRatingChoiceClass(
        int rating,
        int score)
    {
        return score <= rating
            ? "steam-rating-star selected"
            : "steam-rating-star";
    }

    private async Task SetCategoryRatingAsync(
        ReviewCategory category,
        int rating)
    {
        category.Rating = Math.Clamp(
            rating,
            1,
            RatingMaximum);

        await SaveDraftImmediatelyAsync();
    }

    private async Task SetCategoryRatingFromEventAsync(
        ReviewCategory category,
        ChangeEventArgs eventArgs)
    {
        if (int.TryParse(
                eventArgs.Value?.ToString(),
                out var rating))
        {
            await SetCategoryRatingAsync(
                category,
                rating);
        }
    }

    private string GetTextRating(int rating)
    {
        var normalizedRating = Math.Clamp(
            rating,
            1,
            Math.Max(
                1,
                Draft.TextRatingOptions.Count));

        return Draft.TextRatingOptions.Count == 0
            ? "Rating"
            : Draft.TextRatingOptions[
                normalizedRating - 1];
    }

    private bool IsPositiveCategoryRating(
        ReviewCategory category)
    {
        var threshold =
            Draft.RatingSystem switch
            {
                ReviewRatingSystem.TenPoint => 8,
                ReviewRatingSystem.Text =>
                    Math.Max(
                        1,
                        (int)Math.Ceiling(
                            RatingMaximum *
                            0.7d)),
                _ => 4
            };

        return category.Rating >= threshold;
    }

    private async Task AddCategoryAsync()
    {
        await AddCategoryAtAsync(
            Draft.Categories.Count);
    }

    private async Task AddCategoryAtAsync(
        int index)
    {
        var category = new ReviewCategory
        {
            Rating =
                RatingMaximum == 10
                    ? 6
                    : 3
        };

        Draft.Categories.Insert(
            Math.Clamp(
                index,
                0,
                Draft.Categories.Count),
            category);

        await SaveDraftImmediatelyAsync();
    }

    private bool HasTableColumn(
        ReviewTableColumnKind kind)
    {
        return Draft.TableColumns.Any(
            column => column.Kind == kind);
    }

    private static string GetDefaultColumnHeading(
        ReviewTableColumnKind kind)
    {
        return kind switch
        {
            ReviewTableColumnKind.Category =>
                "Category",
            ReviewTableColumnKind.Rating =>
                "Rating",
            ReviewTableColumnKind.Note =>
                "Notes",
            _ => "New Column"
        };
    }

    private string GetConfigurerColumnClass(
        ReviewTableColumn column)
    {
        var classes = new List<string>
        {
            "table-editor-column"
        };

        if (_draggedColumnId == column.Id)
            classes.Add("dragging");

        if (_columnDropTargetId == column.Id &&
            _draggedColumnId != column.Id)
        {
            classes.Add("drag-target");
        }

        return string.Join(' ', classes);
    }

    private string GetConfigurerRowClass(
        ReviewCategory category)
    {
        var classes = new List<string>
        {
            "table-editor-row"
        };

        if (_draggedRowId == category.Id)
            classes.Add("dragging");

        if (_rowDropTargetId == category.Id &&
            _draggedRowId != category.Id)
        {
            classes.Add("drag-target");
        }

        return string.Join(' ', classes);
    }

    private static string GetColumnKindLabel(
        ReviewTableColumnKind kind)
    {
        return kind switch
        {
            ReviewTableColumnKind.Category =>
                "Category data",
            ReviewTableColumnKind.Rating =>
                "Rating data",
            ReviewTableColumnKind.Note =>
                "Notes data",
            _ => "Custom text"
        };
    }

    private string GetRowDragClass(
        ReviewCategory category)
    {
        return _draggedRowId == category.Id
            ? "steam-row-dragging"
            : string.Empty;
    }

    private string GetCustomCellValue(
        ReviewCategory category,
        ReviewTableColumn column)
    {
        return category.CustomCells.TryGetValue(
            column.Id,
            out var value)
            ? value
            : string.Empty;
    }

    private async Task UpdateCustomCellAsync(
        ReviewCategory category,
        ReviewTableColumn column,
        ChangeEventArgs eventArgs)
    {
        category.CustomCells[column.Id] =
            eventArgs.Value?.ToString() ??
            string.Empty;

        await QueueDraftSaveAsync();
    }

    private async Task AddColumnAsync(
        ReviewTableColumnKind kind)
    {
        if (kind != ReviewTableColumnKind.CustomText &&
            HasTableColumn(kind))
        {
            return;
        }

        var column = new ReviewTableColumn
        {
            Heading = GetDefaultColumnHeading(kind),
            Kind = kind
        };

        Draft.TableColumns.Add(column);
        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveColumnAsync(
        ReviewTableColumn column)
    {
        if (Draft.TableColumns.Count == 1)
        {
            return;
        }

        Draft.TableColumns.Remove(column);

        if (column.Kind ==
            ReviewTableColumnKind.CustomText)
        {
            foreach (var category in Draft.Categories)
                category.CustomCells.Remove(column.Id);
        }

        _draggedColumnId = null;
        await SaveDraftImmediatelyAsync();
    }

    private async Task MoveColumnAsync(
        ReviewTableColumn column,
        int offset)
    {
        var currentIndex =
            Draft.TableColumns.IndexOf(column);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.TableColumns.Count)
        {
            return;
        }

        Draft.TableColumns.RemoveAt(currentIndex);
        Draft.TableColumns.Insert(targetIndex, column);

        await SaveDraftImmediatelyAsync();
    }

    private void BeginColumnDrag(
        ReviewTableColumn column)
    {
        _draggedColumnId = column.Id;
        _columnDropTargetId = null;
    }

    private void SetColumnDropTarget(
        ReviewTableColumn column)
    {
        if (_draggedColumnId is not null)
            _columnDropTargetId = column.Id;
    }

    private void EndColumnDrag()
    {
        _draggedColumnId = null;
        _columnDropTargetId = null;
    }

    private async Task DropColumnAsync(
        ReviewTableColumn target)
    {
        if (_draggedColumnId is null ||
            _draggedColumnId == target.Id)
        {
            return;
        }

        var source = Draft.TableColumns.FirstOrDefault(
            column =>
                column.Id == _draggedColumnId);

        if (source is null)
        {
            _draggedColumnId = null;
            return;
        }

        MoveItemToTarget(
            Draft.TableColumns,
            source,
            target);

        _draggedColumnId = null;
        _columnDropTargetId = null;
        await SaveDraftImmediatelyAsync();
    }

    private void BeginRowDrag(
        ReviewCategory category)
    {
        _draggedRowId = category.Id;
        _rowDropTargetId = null;
    }

    private void SetRowDropTarget(
        ReviewCategory category)
    {
        if (_draggedRowId is not null)
            _rowDropTargetId = category.Id;
    }

    private void EndRowDrag()
    {
        _draggedRowId = null;
        _rowDropTargetId = null;
    }

    private async Task DropRowAsync(
        ReviewCategory target)
    {
        if (_draggedRowId is null ||
            _draggedRowId == target.Id)
        {
            return;
        }

        var source = Draft.Categories.FirstOrDefault(
            category =>
                category.Id == _draggedRowId);

        if (source is null)
        {
            _draggedRowId = null;
            return;
        }

        MoveItemToTarget(
            Draft.Categories,
            source,
            target);

        _draggedRowId = null;
        _rowDropTargetId = null;
        await SaveDraftImmediatelyAsync();
    }

    private static void MoveItemToTarget<T>(
        List<T> items,
        T source,
        T target)
    {
        var sourceIndex = items.IndexOf(source);
        var targetIndex = items.IndexOf(target);

        if (sourceIndex < 0 ||
            targetIndex < 0)
        {
            return;
        }

        items.RemoveAt(sourceIndex);
        items.Insert(targetIndex, source);
    }

    private async Task MoveCategoryAsync(
        ReviewCategory category,
        int offset)
    {
        var currentIndex = Draft.Categories.IndexOf(category);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 ||
            targetIndex < 0 ||
            targetIndex >= Draft.Categories.Count)
        {
            return;
        }

        Draft.Categories.RemoveAt(currentIndex);
        Draft.Categories.Insert(targetIndex, category);

        await SaveDraftImmediatelyAsync();
    }

    private async Task RemoveCategory(
        ReviewCategory category)
    {
        Draft.Categories.Remove(category);

        await SaveDraftImmediatelyAsync();
    }

    private async Task CopyBbCode()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "clipboardManager.copyText",
                GeneratedBbCode);

            _copyMessage =
                "Copied to clipboard.";
        }
        catch
        {
            _copyMessage =
                "Copy failed. Select the BBCode manually.";
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _appearance = await JS.InvokeAsync<AppearanceState>(
            "themeManager.get");
        await RestoreDraftAsync();

        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _saveDebounce?.Cancel();
        _saveDebounce?.Dispose();

        return ValueTask.CompletedTask;
    }

    private async Task ToggleTheme()
    {
        _appearance = await JS.InvokeAsync<AppearanceState>(
            "themeManager.toggleColorMode");
    }

    private async Task RestoreDraftAsync()
    {
        try
        {
            var restoredDraft =
                await DraftStorage.LoadAsync();

            if (restoredDraft is null)
            {
                _saveStatus = "Not saved yet";
                return;
            }

            restoredDraft.Categories ??= [];

            if (restoredDraft.Categories.Count == 0 &&
                restoredDraft.DisplayFormat !=
                ReviewDisplayFormat.MinimalVerdict)
            {
                restoredDraft.Categories.Add(
                    new ReviewCategory());
            }

            Draft = restoredDraft;
            SelectedTemplate = Draft.Template;

            _saveStatus = "Draft restored";
        }
        catch
        {
            _saveStatus = "Draft storage unavailable";
        }
        finally
        {
            _draftStorageReady = true;
        }
    }

    private async Task QueueDraftSaveAsync()
    {
        if (!_draftStorageReady)
        {
            return;
        }

        var previousSave = _saveDebounce;

        _saveDebounce =
            new CancellationTokenSource();

        previousSave?.Cancel();
        previousSave?.Dispose();

        var currentSave = _saveDebounce;

        _saveStatus = "Saving…";

        try
        {
            await Task.Delay(
                500,
                currentSave.Token);

            await DraftStorage.SaveAsync(Draft);

            if (ReferenceEquals(
                    _saveDebounce,
                    currentSave))
            {
                _saveStatus = "Saved";
            }
        }
        catch (OperationCanceledException)
        {
            // A newer edit restarted the save delay.
        }
        catch
        {
            if (ReferenceEquals(
                    _saveDebounce,
                    currentSave))
            {
                _saveStatus =
                    "Draft storage unavailable";
            }
        }
    }

    private async Task SaveDraftImmediatelyAsync()
    {
        if (!_draftStorageReady)
        {
            return;
        }

        _saveDebounce?.Cancel();

        _saveStatus = "Saving…";

        try
        {
            await DraftStorage.SaveAsync(Draft);
            _saveStatus = "Saved";
        }
        catch
        {
            _saveStatus =
                "Draft storage unavailable";
        }
    }

    private void OpenNewReviewDialog()
    {
        _showNewReviewDialog = true;
    }

    private void CloseNewReviewDialog()
    {
        _showNewReviewDialog = false;
    }

    private void OpenTableConfigurer()
    {
        _showTableConfigurer = true;
    }

    private void CloseTableConfigurer()
    {
        _showTableConfigurer = false;
        _draggedColumnId = null;
        _draggedRowId = null;
        _columnDropTargetId = null;
        _rowDropTargetId = null;
    }

    private void OpenResetTemplateDialog()
    {
        _showResetTemplateDialog = true;
    }

    private void CloseResetTemplateDialog()
    {
        _showResetTemplateDialog = false;
    }

    private async Task ConfirmResetTemplateAsync()
    {
        ReviewTemplateService.Apply(
            Draft,
            SelectedTemplate);

        _showResetTemplateDialog = false;
        _showTableConfigurer = false;
        _copyMessage = string.Empty;

        await SaveDraftImmediatelyAsync();
    }

    private void OpenFormattingHelp()
    {
        _showFormattingHelp = true;
    }

    private void CloseFormattingHelp()
    {
        _showFormattingHelp = false;
    }

    private void HandleFormattingHelpKeyDown(
        KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            CloseFormattingHelp();
        }
    }

    private async Task ConfirmStartNewReviewAsync()
    {
        try
        {
            _saveDebounce?.Cancel();

            await DraftStorage.ClearAsync();

            Draft = new ReviewDraft();
            SelectedTemplate = Draft.Template;

            CurrentStep = BuilderStep.Setup;

            _copyMessage = string.Empty;
            _saveStatus = "Not saved yet";
            _showNewReviewDialog = false;
            _showFormattingHelp = false;
            _showTableConfigurer = false;
            _showResetTemplateDialog = false;
        }
        catch
        {
            _saveStatus =
                "Unable to clear saved draft";
        }
    }

}
