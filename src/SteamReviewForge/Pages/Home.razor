@page "/"

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject ReviewDraftStorageService DraftStorage

@using Microsoft.AspNetCore.Components
@using SteamReviewForge.Models
@using SteamReviewForge.Services

<PageTitle>Steam Review Forge</PageTitle>

<div class="app-shell">
    <header class="app-header">
        <div class="brand-lockup">
            <span class="brand-mark"
                  aria-hidden="true">&gt;_</span>

            <div class="brand-copy">
                <span class="brand-eyebrow">
                    ARGYROSDEV // REVIEW TOOL
                </span>

                <h1>
                    Steam Review <span>Forge</span>
                </h1>

                <p>
                    Build a structured review and copy the generated Steam BBCode.
                </p>
            </div>
        </div>

        @RenderHeaderProgressPath()

        <div class="header-actions">
            <span class="save-status"
                  role="status"
                  aria-live="polite">
                @_saveStatus
            </span>

            <button class="button new-review-button"
                    type="button"
                    @onclick="OpenNewReviewDialog">
                New review
            </button>

            <button class="button help-button"
                    type="button"
                    @onclick="OpenFormattingHelp">
                Formatting help
            </button>

            <label class="theme-selector">
                <span>Theme</span>
                <select aria-label="Color theme"
                        value="@_appearance.Theme"
                        @onchange="SelectThemeAsync">
                    @foreach (var theme in _themes)
                    {
                        <option value="@theme.Id">@theme.Name</option>
                    }
                </select>
            </label>

            <button class="theme-toggle"
                    type="button"
                    title="@ThemeToggleLabel"
                    aria-label="@ThemeToggleLabel"
                    @onclick="ToggleTheme">
                <span class="theme-toggle-prompt"
                      aria-hidden="true">&gt;_</span>
                <span>@ColorModeLabel</span>
            </button>
        </div>
    </header>

    <main class="@BuilderLayoutClass">
        <div class="workflow-column">
        <aside class="panel workflow-navigation-panel">
            <div class="panel-heading">
                <h2>Review Builder</h2>
                <p>Choose how you want to build and edit your review.</p>
            </div>

            <section class="editor-mode-switcher"
                     aria-label="Review editor mode">
                <div class="editor-mode-summary">
                    <span>Editing mode</span>
                    <strong>@EditingModeName</strong>
                </div>

                <div class="editor-mode-axis"
                     role="group"
                     aria-label="Editor type">
                    <button class="@GetModeButtonClass(IsStructuredMode)"
                            type="button"
                            aria-pressed="@IsStructuredMode"
                            @onclick="() => RequestEditorTypeSwitch(true)">
                        Structured
                    </button>
                    <button class="@GetModeButtonClass(IsBbCodeMode)"
                            type="button"
                            aria-pressed="@IsBbCodeMode"
                            @onclick="() => RequestEditorTypeSwitch(false)">
                        BBCode
                    </button>
                </div>

                <div class="editor-mode-axis"
                     role="group"
                     aria-label="Guidance level">
                    <button class="@GetModeButtonClass(IsGuidedMode)"
                            type="button"
                            aria-pressed="@IsGuidedMode"
                            @onclick="() => SelectGuidanceModeAsync(true)">
                        Guided
                    </button>
                    <button class="@GetModeButtonClass(!IsGuidedMode)"
                            type="button"
                            aria-pressed="@(!IsGuidedMode)"
                            @onclick="() => SelectGuidanceModeAsync(false)">
                        Unguided
                    </button>
                </div>
            </section>

        </aside>

        <aside class="panel workflow-options-panel">
            @if (Draft.EditingMode == ReviewEditingMode.GuidedStructured)
            {
            <div class="workflow-editor">
            <div class="workflow-editor-heading">
                <h2>@StepTitle</h2>
                <p>@StepDescription</p>
            </div>

            @if (CurrentStep == BuilderStep.Setup)
            {
                @RenderRatingSystemEditor()
            }

            <div class="step-content">
                @if (CurrentStep == BuilderStep.Template)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Choose a review template</h3>

                            <p>
                                Templates provide starter content, categories,
                                and a recommended display format.
                            </p>
                        </div>

                        @if (Draft.IncludeTitle)
                        {
                        <div class="template-title-field">
                            <div class="@GetFieldClass(nameof(Draft.Title))">
                                <label for="review-title">
                                    Review title
                                </label>

                                <input id="review-title"
                                       type="text"
                                       data-validation-field="@nameof(Draft.Title)"
                                       aria-invalid="@HasFieldError(
                                                         nameof(Draft.Title))"
                                       @bind="Draft.Title"
                                       @bind:event="oninput"
                                       @bind:after="QueueDraftSaveAsync"/>

                                @foreach (var issue in GetFieldIssues(
                                                  nameof(Draft.Title)))
                                {
                                    <span class="@GetIssueClass(issue)">
                                        @issue.Message
                                    </span>
                                }
                            </div>
                        </div>
                        }

                        <div class="template-grid"
                             role="radiogroup"
                             aria-label="Review template">
                            @foreach (var option in TemplateOptions)
                            {
                                <button class="@GetTemplateCardClass(option.Template)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(SelectedTemplate == option.Template
                                                          ? "true"
                                                          : "false")"
                                        @onclick="() => SelectTemplate(option.Template)">
                                    <div class="template-card-header">
                                        <span class="template-code"
                                              aria-hidden="true">
                                            @option.Code
                                        </span>

                                        @if (SelectedTemplate == option.Template)
                                        {
                                            <span class="template-selected">
                                                Selected
                                            </span>
                                        }
                                    </div>

                                    <h4>@option.Name</h4>
                                    <p>@option.Description</p>

                                    <ul>
                                        @foreach (var detail in option.Details)
                                        {
                                            <li>@detail</li>
                                        }
                                    </ul>
                                </button>
                            }
                        </div>

                        <div class="template-note"
                             role="status"
                             aria-live="polite">
                            <strong>@SelectedTemplateName</strong>
                            is currently applied to this review.
                        </div>
                    </section>
                }
                else if (CurrentStep == BuilderStep.Setup)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Would you recommend this game?</h3>

                            <p>
                                Please describe what you liked or disliked about
                                this game and whether you recommend it to others.
                                Please remember to be polite and follow the
                                Rules and Guidelines.
                            </p>
                        </div>

                        <div class="recommendation-choice"
                             role="radiogroup"
                             aria-label="Recommendation"
                             data-validation-field="@nameof(Draft.Recommendation)">
                            <button class="@GetRecommendationChoiceClass(
                                               ReviewRecommendation.Recommended)"
                                    type="button"
                                    role="radio"
                                    aria-checked="@(Draft.Recommendation ==
                                                      ReviewRecommendation.Recommended)"
                                    @onclick="() => SelectRecommendationAsync(
                                                        ReviewRecommendation.Recommended)">
                                <span class="recommendation-choice-icon positive"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         focusable="false">
                                        <path d="M8.35 20H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10h3.85v10Zm2-10 3.3-6.25c.3-.57.9-.9 1.54-.82a1.5 1.5 0 0 1 1.3 1.67L15.9 9h3.17a2 2 0 0 1 1.95 2.43l-1.47 6.5A2.65 2.65 0 0 1 16.96 20h-6.61V10Z"/>
                                    </svg>
                                </span>
                                <span>
                                    <strong>Yes</strong>
                                    Recommended
                                </span>
                            </button>

                            <button class="@GetRecommendationChoiceClass(
                                               ReviewRecommendation.NotRecommended)"
                                    type="button"
                                    role="radio"
                                    aria-checked="@(Draft.Recommendation ==
                                                      ReviewRecommendation.NotRecommended)"
                                    @onclick="() => SelectRecommendationAsync(
                                                        ReviewRecommendation.NotRecommended)">
                                <span class="recommendation-choice-icon negative"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         focusable="false">
                                        <path d="M8.35 20H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10h3.85v10Zm2-10 3.3-6.25c.3-.57.9-.9 1.54-.82a1.5 1.5 0 0 1 1.3 1.67L15.9 9h3.17a2 2 0 0 1 1.95 2.43l-1.47 6.5A2.65 2.65 0 0 1 16.96 20h-6.61V10Z"/>
                                    </svg>
                                </span>
                                <span>
                                    <strong>No</strong>
                                    Not Recommended
                                </span>
                            </button>
                        </div>

                        @foreach (var issue in GetFieldIssues(
                                          nameof(Draft.Recommendation)))
                        {
                            <span class="@GetIssueClass(issue)">
                                @issue.Message
                            </span>
                        }

                        @if (HasRecommendation)
                        {
                            <div class="setup-details">
                                <div class="field-grid">
                                    <div class="@GetFieldClass(nameof(Draft.Playtime))">
                                        <label for="playtime">
                                            Playtime
                                        </label>

                                        <input id="playtime"
                                               type="number"
                                               data-validation-field="@nameof(Draft.Playtime)"
                                               min="0"
                                               max="@PlaytimeFormatter.MaximumHours"
                                               step="0.1"
                                               inputmode="decimal"
                                               value="@Draft.Playtime"
                                               @oninput="UpdatePlaytimeAsync"/>

                                        <span class="field-help">
                                            Enter hours as a number. Preview
                                            only; not included in BBCode.
                                        </span>

                                        @foreach (var issue in GetFieldIssues(
                                                          nameof(Draft.Playtime)))
                                        {
                                            <span class="@GetIssueClass(issue)">
                                                @issue.Message
                                            </span>
                                        }
                                    </div>

                                    <div class="steam-metadata-options full-width">
                                        <label class="steam-checkbox">
                                            <input type="checkbox"
                                                   @bind="Draft.ReceivedProductForFree"
                                                   @bind:after="QueueDraftSaveAsync"/>
                                            <span>
                                                Check this box if you received this
                                                product for free
                                            </span>
                                        </label>

                                        <label class="steam-checkbox">
                                            <input type="checkbox"
                                                   @bind="Draft.IsEarlyAccessReview"
                                                   @bind:after="QueueDraftSaveAsync"/>
                                            <span>Early Access Review</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                    </section>
                }
                else if (CurrentStep == BuilderStep.Format)
                {
                    <section class="editor-section">
                        <div class="section-heading">
                            <h3>Display format</h3>

                            <p>
                                Choose how the generated review is structured.
                            </p>
                        </div>

                        <div class="field">
                            <label for="display-format">
                                Review layout
                            </label>

                            <select id="display-format"
                                    @bind="Draft.DisplayFormat"
                                    @bind:after="QueueDraftSaveAsync">
                                <option value="@ReviewDisplayFormat.RatingTable">
                                    Rating Table
                                </option>

                                <option value="@ReviewDisplayFormat.Sections">
                                    Individual Sections
                                </option>

                                <option value="@ReviewDisplayFormat.Checklist">
                                    Checklist
                                </option>

                                <option value="@ReviewDisplayFormat.MinimalVerdict">
                                    Minimal Verdict
                                </option>
                            </select>

                            <span class="field-help">
                                @DisplayFormatDescription
                            </span>
                        </div>
                    </section>

                    @if (ShowCategories)
                    {
                        <div class="format-editing-note">
                            <strong>Configure the rating table in one place.</strong>
                            Use <strong>Table Editor</strong> to edit
                            columns, row content, ratings, order, and structure.
                            The Steam preview remains read-only for tables.
                        </div>
                    }
                    else
                    {
                        <div class="format-editing-note">
                            Minimal Verdict does not include category sections.
                            Choose another layout to edit category ratings.
                        </div>
                    }
                }
                else if (CurrentStep == BuilderStep.Questions)
                {
                    <div class="format-editing-note">
                        <strong>Write directly in the Steam preview.</strong>
                        Enter one item per line for strengths and weaknesses;
                        the BBCode preview updates as you type.
                    </div>
                }
            </div>

            <div class="step-navigation">
                <button class="button secondary"
                        type="button"
                        disabled="@(!CanGoBack)"
                        @onclick="PreviousStep">
                    Back
                </button>

                @if (CanGoNext)
                {
                    <button class="button primary"
                            type="button"
                            disabled="@(!CanAdvance)"
                            aria-describedby="@(!CanAdvance
                                                   ? "header-progress-status"
                                                   : null)"
                            @onclick="NextStep">
                        @NextButtonLabel
                    </button>
                }
            </div>
            </div>
            }
            else if (IsUnguidedStructured)
            {
                <div class="workflow-editor unguided-structured-editor">
                    <div class="workflow-editor-heading">
                        <h2>Complete Review Editor</h2>
                        <p>
                            Configure the review here, then write directly in
                            the Steam preview without step gates.
                        </p>
                    </div>

                    @RenderRatingSystemEditor()

                    <section class="editor-section unguided-controls">
                        <div class="@GetFieldClass(nameof(Draft.Recommendation))">
                            <label>Recommendation</label>
                            <div class="compact-choice-row"
                                 role="radiogroup"
                                 aria-label="Recommendation"
                                 data-validation-field="@nameof(Draft.Recommendation)">
                                <button class="@GetRecommendationChoiceClass(
                                                   ReviewRecommendation.Recommended)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(Draft.Recommendation ==
                                                          ReviewRecommendation.Recommended)"
                                        @onclick="() => SelectRecommendationAsync(
                                                            ReviewRecommendation.Recommended)">
                                    Recommended
                                </button>
                                <button class="@GetRecommendationChoiceClass(
                                                   ReviewRecommendation.NotRecommended)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(Draft.Recommendation ==
                                                          ReviewRecommendation.NotRecommended)"
                                        @onclick="() => SelectRecommendationAsync(
                                                            ReviewRecommendation.NotRecommended)">
                                    Not Recommended
                                </button>
                            </div>

                            @foreach (var issue in GetFieldIssues(
                                              nameof(Draft.Recommendation)))
                            {
                                <span class="@GetIssueClass(issue)">
                                    @issue.Message
                                </span>
                            }
                        </div>

                        <div class="field">
                            <label for="unguided-template">Starter template</label>
                            <select id="unguided-template"
                                    value="@SelectedTemplate"
                                    @onchange="UpdateTemplateFromEventAsync">
                                @foreach (var option in TemplateOptions)
                                {
                                    <option value="@option.Template">
                                        @option.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label for="unguided-format">Review layout</label>
                            <select id="unguided-format"
                                    @bind="Draft.DisplayFormat"
                                    @bind:after="QueueDraftSaveAsync">
                                <option value="@ReviewDisplayFormat.RatingTable">Rating Table</option>
                                <option value="@ReviewDisplayFormat.Sections">Individual Sections</option>
                                <option value="@ReviewDisplayFormat.Checklist">Checklist</option>
                                <option value="@ReviewDisplayFormat.MinimalVerdict">Minimal Verdict</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="unguided-playtime">Playtime</label>
                            <input id="unguided-playtime"
                                   type="number"
                                   min="0"
                                   max="@PlaytimeFormatter.MaximumHours"
                                   step="0.1"
                                   inputmode="decimal"
                                   value="@Draft.Playtime"
                                   @oninput="UpdatePlaytimeAsync"/>
                        </div>

                        <div class="steam-metadata-options">
                            <label class="steam-checkbox">
                                <input type="checkbox"
                                       @bind="Draft.ReceivedProductForFree"
                                       @bind:after="QueueDraftSaveAsync"/>
                                <span>Product received for free</span>
                            </label>

                            <label class="steam-checkbox">
                                <input type="checkbox"
                                       @bind="Draft.IsEarlyAccessReview"
                                       @bind:after="QueueDraftSaveAsync"/>
                                <span>Early Access Review</span>
                            </label>
                        </div>

                        @if (!IsStructuredEditorEditable)
                        {
                            <div id="unguided-structured-setup-requirements"
                                 class="@UnguidedStructuredSetupStatusClass"
                                 role="status"
                                 aria-live="polite">
                                <strong>
                                    @(SetupComplete
                                        ? "Ready to open editor"
                                        : "Editor locked")
                                </strong>
                                <span>@UnguidedStructuredSetupMessage</span>
                            </div>

                            <div class="unguided-editor-gate-actions">
                                <button class="button primary"
                                        type="button"
                                        disabled="@(!SetupComplete)"
                                        aria-describedby="unguided-structured-setup-requirements"
                                        @onclick="OpenUnguidedStructuredEditor">
                                    Open editor
                                </button>
                            </div>
                        }
                    </section>

                    @if (IsStructuredEditorEditable)
                    {
                    <section class="editor-section structured-component-section">
                        <div class="section-heading">
                            <h3>Review components</h3>
                            <p>
                                Drag a component into the Steam preview, or
                                select it to add with touch or keyboard.
                            </p>
                        </div>

                        <div class="structured-component-grid">
                            @foreach (var component in StructuredComponents)
                            {
                                <button type="button"
                                        draggable="true"
                                        data-structured-component-card
                                        data-structured-component-key="@component.Key"
                                        @onclick="() => AddStructuredComponentAsync(component)">
                                    <strong>@component.Name</strong>
                                    <span>@component.Description</span>
                                </button>
                            }
                        </div>
                    </section>
                    }
                </div>
            }
            else
            {
                @RenderBbCodeWorkflow()
            }
        </aside>
        </div>

        <aside class="panel preview-panel @(IsBbCodeMode
                                                ? "steam-sized-preview-panel"
                                                : null)">
            <div class="panel-heading preview-panel-heading">
                <div>
                    <h2>
                        @(IsBbCodeMode
                            ? "Final Preview"
                            : IsStructuredEditorEditable
                            ? "Editable Steam preview"
                            : "Steam preview")
                    </h2>

                    <p>
                        @(IsBbCodeMode
                            ? "See the finished Steam review update as you write."
                            : IsStructuredEditorEditable
                            ? "Edit the review directly at any workflow step."
                            : StructuredEditorLockMessage)
                    </p>
                </div>

                @if (IsStructuredMode)
                {
                    <div class="preview-editor-actions">
                        @if (IsStructuredMode &&
                             !IsFinalPreview &&
                             IsStructuredEditorEditable)
                        {
                            @if (Draft.DisplayFormat ==
                                 ReviewDisplayFormat.RatingTable)
                            {
                                <button class="button secondary"
                                        type="button"
                                        @onclick="OpenTableConfigurer">
                                    Table Editor
                                </button>
                            }

                            <button class="button secondary"
                                    type="button"
                                    @onclick="OpenResetTemplateDialog">
                                Reset
                            </button>
                        }

                    </div>
                }
            </div>

            @if (IsStructuredMode &&
                 !IsStructuredEditorEditable)
            {
                <div id="structured-editor-lock-message"
                     class="bbcode-editor-lock-notice structured-editor-lock-notice"
                     role="status"
                     aria-live="polite">
                    <strong>Editable preview locked</strong>
                    <span>@StructuredEditorLockMessage</span>
                </div>
            }

            @if (IsStructuredMode &&
                 IsStructuredEditorEditable &&
                 !IsFinalPreview &&
                 PreviewEditingIssues.Any())
            {
                <div class="preview-validation"
                     role="region"
                     aria-labelledby="preview-validation-title"
                     aria-live="polite">
                    <strong id="preview-validation-title">
                        Review these editor items:
                    </strong>

                    <ul>
                        @foreach (var issue in PreviewEditingIssues)
                        {
                            <li>
                                <button class="validation-link"
                                        type="button"
                                        @onclick="() => NavigateToValidationIssue(issue)">
                                    @issue.Message
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (CurrentBbCodeAnalysis.HasWarnings)
            {
                @RenderBbCodeCompatibilityWarnings("preview-bbcode-compatibility")
            }

            <div class="@PrimarySteamPreviewClass"
                 aria-label="Rendered review preview"
                 aria-describedby="@(ShouldBlurPrimaryPreview
                                          ? PrimaryPreviewLockMessageId
                                          : null)">
                <div class="steam-review-page">
                    <article class="steam-review-card">
                        <header class="steam-review-header">
                            <span class="@SteamRecommendationIconClass"
                                  aria-hidden="true">
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <path d="M8.35 20H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10h3.85v10Zm2-10 3.3-6.25c.3-.57.9-.9 1.54-.82a1.5 1.5 0 0 1 1.3 1.67L15.9 9h3.17a2 2 0 0 1 1.95 2.43l-1.47 6.5A2.65 2.65 0 0 1 16.96 20h-6.61V10Z"/>
                                </svg>
                            </span>

                            <span class="steam-review-verdict">
                                <strong>@RecommendationName</strong>
                                @if (!string.IsNullOrWhiteSpace(Draft.Playtime))
                                {
                                    <small>@SteamPlaytimeLabel</small>
                                }
                            </span>
                        </header>

                        <div class="steam-review-content">
                            @if (Draft.IsEarlyAccessReview)
                            {
                                <div class="steam-early-access-review">
                                    Early Access Review
                                </div>
                            }

                            <div class="steam-review-date">
                                Posted: @SteamPreviewDate
                            </div>

                            @if (Draft.ReceivedProductForFree)
                            {
                                <div class="steam-product-disclosure">
                                    Product received for free
                                </div>
                            }

                            @if (IsBbCodeMode)
                            {
                                @RenderedPreview
                            }
                            else if (IsStructuredEditorEditable &&
                                 !IsFinalPreview)
                            {
                                @if (HasEditableIntro)
                                {
                                    <div class="steam-intro-editor">
                                        @if (Draft.IncludeTitle)
                                        {
                                            <div class="steam-removable-block">
                                                <h1 class="steam-editable-title">
                                                    <input class="steam-inline-input steam-title-input"
                                                           type="text"
                                                           data-validation-field="@nameof(Draft.Title)"
                                                           aria-label="Review title"
                                                           @bind="Draft.Title"
                                                           @bind:event="oninput"
                                                           @bind:after="QueueDraftSaveAsync"/>
                                                </h1>

                                                <button class="steam-remove-block"
                                                        type="button"
                                                        title="Remove review title"
                                                        aria-label="Remove review title"
                                                        @onclick="RemoveTitleAsync">
                                                    ×
                                                </button>
                                            </div>
                                        }

                                    </div>
                                }

                                @if (HasEditableIntro &&
                                     HasEditableCategories &&
                                     Draft.IncludeCategoryDivider)
                                {
                                    <div class="steam-removable-divider">
                                        <hr />
                                        <button type="button"
                                                title="Remove divider before review format"
                                                aria-label="Remove divider before review format"
                                                @onclick="RemoveCategoryDividerAsync">
                                            ×
                                        </button>
                                    </div>
                                }

                                @if (Draft.DisplayFormat ==
                                     ReviewDisplayFormat.RatingTable)
                                {
                                    @if (Draft.Categories.Count > 0)
                                    {
                                        <div class="steam-removable-block steam-removable-table">
                                            <div class="preview-table-wrapper steam-editable-table-wrapper">
                                                <table class="@GetEditableRatingTableClass()">
                                                    <thead>
                                                        <tr>
                                                            @foreach (var column in Draft.TableColumns)
                                                            {
                                                                <th class="@GetEditableTableColumnClass(column)"
                                                                    @key="column.Id">
                                                                    <input class="steam-inline-input steam-table-heading-input"
                                                                           type="text"
                                                                           data-validation-field="@($"ColumnHeading:{column.Id}")"
                                                                           aria-label="@($"{GetColumnKindLabel(column.Kind)} column heading")"
                                                                           aria-invalid="@HasFieldError($"ColumnHeading:{column.Id}")"
                                                                           @bind="column.Heading"
                                                                           @bind:event="oninput"
                                                                           @bind:after="QueueDraftSaveAsync"/>

                                                                    <button class="steam-remove-column"
                                                                            type="button"
                                                                            title="Remove column"
                                                                            aria-label="@($"Remove {column.Heading} column")"
                                                                            disabled="@(Draft.TableColumns.Count == 1)"
                                                                            @onclick="() => RemoveColumnAsync(column)">
                                                                        ×
                                                                    </button>
                                                                </th>
                                                            }

                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        @foreach (var category in Draft.Categories)
                                                        {
                                                            <tr @key="category.Id"
                                                                @ondragover:preventDefault
                                                                @ondrop="() => DropRowAsync(category)">
                                                                @foreach (var column in Draft.TableColumns)
                                                                {
                                                                    <td class="@GetEditableTableColumnClass(column)"
                                                                        @key="column.Id">
                                                                        @RenderEditableTableCell(category, column)
                                                                    </td>
                                                                }

                                                            </tr>
                                                        }
                                                    </tbody>

                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="@Draft.TableColumns.Count">
                                                                <div class="steam-table-footer-actions">
                                                                    <button class="steam-category-control add"
                                                                            type="button"
                                                                            aria-label="Add rating table row"
                                                                            @onclick="AddCategoryAsync">
                                                                        +
                                                                    </button>

                                                                    <div class="steam-table-footer-right">
                                                                        @RenderTableCellWidthToggle(
                                                                            "Rating table")

                                                                        <div class="steam-table-destructive-actions">
                                                                            <button class="steam-remove-table"
                                                                                    type="button"
                                                                                    title="Remove the entire rating table"
                                                                                    aria-label="Remove rating table"
                                                                                    aria-describedby="remove-rating-table-warning"
                                                                                    @onclick="RemoveAllCategoriesAsync">
                                                                                <span aria-hidden="true">×</span>
                                                                                <span>Remove table</span>
                                                                            </button>
                                                                            <span id="remove-rating-table-warning"
                                                                                  class="steam-remove-table-warning"
                                                                                  role="tooltip">
                                                                                Removes the entire rating table, including every row and column value.
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="steam-empty-block">
                                            <span>Rating table removed.</span>
                                            <button type="button"
                                                    @onclick="AddCategoryAsync">
                                                Add category
                                            </button>
                                        </div>
                                    }
                                }
                                else if (Draft.DisplayFormat ==
                                         ReviewDisplayFormat.Sections)
                                {
                                    <div class="steam-editable-sections">
                                        @foreach (var category in Draft.Categories)
                                        {
                                            <section class="steam-editable-section"
                                                     @key="category.Id"
                                                     @ondragover:preventDefault
                                                     @ondrop="() => DropRowAsync(category)">
                                                <div class="steam-editable-section-header">
                                                    <input class="steam-inline-input steam-section-heading-input"
                                                           type="text"
                                                           data-validation-field="@($"CategoryName:{category.Id}")"
                                                           aria-label="Section name"
                                                           aria-invalid="@HasFieldError(
                                                                             $"CategoryName:{category.Id}")"
                                                           @bind="category.Name"
                                                           @bind:event="oninput"
                                                           @bind:after="QueueDraftSaveAsync"/>

                                                    @RenderCategoryControls(category)
                                                </div>

                                                @RenderRatingEditor(category)

                                                <textarea class="steam-inline-input steam-inline-textarea"
                                                          rows="2"
                                                          data-validation-field="@($"CategoryNote:{category.Id}")"
                                                          aria-label="@($"{category.Name} note")"
                                                          @bind="category.Note"
                                                          @bind:event="oninput"
                                                          @bind:after="QueueDraftSaveAsync"></textarea>

                                            </section>
                                        }

                                        <div class="steam-add-category-row">
                                            @RenderAddCategoryControl()
                                        </div>
                                    </div>
                                }
                                else if (Draft.DisplayFormat ==
                                         ReviewDisplayFormat.Checklist)
                                {
                                    <div class="steam-editable-checklist">
                                        @foreach (var category in Draft.Categories)
                                        {
                                            <section class="steam-editable-check-item"
                                                     @key="category.Id"
                                                     @ondragover:preventDefault
                                                     @ondrop="() => DropRowAsync(category)">
                                                <span class="steam-check-marker"
                                                      aria-hidden="true">
                                                    @(IsPositiveCategoryRating(category)
                                                        ? "☑"
                                                        : "☐")
                                                </span>

                                                <div class="steam-check-edit-content">
                                                    <div class="steam-check-edit-heading">
                                                        <input class="steam-inline-input steam-category-name"
                                                               type="text"
                                                               data-validation-field="@($"CategoryName:{category.Id}")"
                                                               aria-label="Checklist category name"
                                                               aria-invalid="@HasFieldError(
                                                                                 $"CategoryName:{category.Id}")"
                                                               @bind="category.Name"
                                                               @bind:event="oninput"
                                                               @bind:after="QueueDraftSaveAsync"/>

                                                        @RenderCategoryControls(category)
                                                    </div>

                                                    @RenderRatingEditor(category)

                                                    <input class="steam-inline-input"
                                                           type="text"
                                                           data-validation-field="@($"CategoryNote:{category.Id}")"
                                                           aria-label="@($"{category.Name} note")"
                                                           @bind="category.Note"
                                                           @bind:event="oninput"
                                                           @bind:after="QueueDraftSaveAsync"/>

                                                </div>
                                            </section>
                                        }

                                        <div class="steam-add-category-row">
                                            @RenderAddCategoryControl()
                                        </div>
                                    </div>
                                }

                                @if (IsUnguidedStructured &&
                                     Draft.Components.Count > 0 &&
                                     (HasEditableIntro || HasEditableCategories) &&
                                     Draft.IncludeComponentDivider)
                                {
                                    <div class="steam-removable-divider">
                                        <hr />
                                        <button type="button"
                                                title="Remove divider before review components"
                                                aria-label="Remove divider before review components"
                                                @onclick="RemoveComponentDividerAsync">
                                            ×
                                        </button>
                                    </div>
                                }

                                @if (IsUnguidedStructured)
                                {
                                    <div class="@GetReviewComponentsClass()"
                                         data-structured-component-list>
                                        @for (var index = 0;
                                              index <= Draft.Components.Count;
                                              index++)
                                        {
                                            var insertionIndex = index;

                                            <div class="structured-component-insert-target"
                                                 data-structured-component-insert-target
                                                 data-insertion-index="@insertionIndex"
                                                 aria-hidden="true">
                                                <span>Insert component here</span>
                                            </div>

                                            if (index == Draft.Components.Count)
                                            {
                                                continue;
                                            }

                                            var component = Draft.Components[index];

                                            <section class="@GetReviewComponentClass(component)"
                                                     @key="component.Id"
                                                     @ondragover:preventDefault
                                                     @ondrop="() => DropReviewComponentAsync(component)">
                                                <div class="structured-review-component-header">
                                                    <input class="steam-inline-input steam-section-heading-input"
                                                           type="text"
                                                           data-validation-field="@GetComponentHeadingField(component)"
                                                           aria-invalid="@(HasFieldError(GetComponentHeadingField(component))
                                                                               ? "true"
                                                                               : "false")"
                                                           aria-label="Component heading"
                                                           @bind="component.Heading"
                                                           @bind:event="oninput"
                                                           @bind:after="QueueDraftSaveAsync"/>

                                                    <div class="structured-review-component-controls"
                                                         role="group"
                                                         aria-label="@($"Format, reorder, duplicate, or remove {component.Heading}")"
                                                         draggable="true"
                                                         @ondragstart="() => BeginReviewComponentDrag(component)"
                                                         @ondragend="EndReviewComponentDrag">
                                                        @RenderTextFormatControls(
                                                            GetComponentBodyKey(component),
                                                            component.ContentFormat,
                                                            component.Heading)
                                                        <span aria-hidden="true">⋮⋮</span>
                                                        <button type="button"
                                                                title="Move component up"
                                                                aria-label="Move component up"
                                                                disabled="@(Draft.Components.IndexOf(component) == 0)"
                                                                @onclick="() => MoveReviewComponentAsync(component, -1)">
                                                            ↑
                                                        </button>
                                                        <button type="button"
                                                                title="Move component down"
                                                                aria-label="Move component down"
                                                                disabled="@(Draft.Components.IndexOf(component) == Draft.Components.Count - 1)"
                                                                @onclick="() => MoveReviewComponentAsync(component, 1)">
                                                            ↓
                                                        </button>
                                                        <button type="button"
                                                                title="Duplicate component"
                                                                aria-label="@($"Duplicate {component.Heading}")"
                                                                @onclick="() => DuplicateReviewComponentAsync(component)">
                                                            ⧉
                                                        </button>
                                                        <button type="button"
                                                                title="Remove component"
                                                                aria-label="@($"Remove {component.Heading}")"
                                                                @onclick="() => RemoveReviewComponentAsync(component)">
                                                            −
                                                        </button>
                                                    </div>
                                                </div>

                                                @foreach (var issue in GetFieldIssues(
                                                                  GetComponentHeadingField(component)))
                                                {
                                                    <span class="@GetIssueClass(issue)">
                                                        @issue.Message
                                                    </span>
                                                }

                                                @if (component.Kind ==
                                                     ReviewContentComponentKind.Rating)
                                                {
                                                    @RenderComponentRatingEditor(component)

                                                    @foreach (var issue in GetFieldIssues(
                                                                      GetComponentRatingField(component)))
                                                    {
                                                        <span class="@GetIssueClass(issue)">
                                                            @issue.Message
                                                        </span>
                                                    }
                                                }

                                                @RenderFormattedBodyEditor(
                                                    GetComponentBodyKey(component),
                                                    component.Content,
                                                    component.ContentFormat,
                                                    $"{component.Heading} content",
                                                    "Write this component",
                                                    GetComponentContentField(component),
                                                    5)

                                                @foreach (var issue in GetFieldIssues(
                                                                  GetComponentContentField(component)))
                                                {
                                                    <span class="@GetIssueClass(issue)">
                                                        @issue.Message
                                                    </span>
                                                }
                                            </section>
                                        }
                                    </div>
                                }

                                @if (HasEditableWritingContent)
                                {
                                    @if ((HasEditableIntro ||
                                          HasEditableCategories ||
                                          HasEditableComponents) &&
                                         Draft.IncludeWritingDivider)
                                    {
                                        <div class="steam-removable-divider">
                                            <hr />
                                            <button type="button"
                                                    title="Remove divider before guided writing"
                                                    aria-label="Remove divider before guided writing"
                                                    @onclick="RemoveWritingDividerAsync">
                                                ×
                                            </button>
                                        </div>
                                    }

                                    <div class="steam-writing-editor">
                                    @if (ShowDetailedQuestions &&
                                         Draft.IncludeWhatWorks)
                                    {
                                        <div class="steam-removable-block">
                                        <div class="steam-writing-block">
                                            <div class="steam-writing-header">
                                                <input class="steam-inline-input steam-writing-heading-input"
                                                       type="text"
                                                       aria-label="What Works heading"
                                                       @bind="Draft.WhatWorksHeading"
                                                       @bind:event="oninput"
                                                       @bind:after="QueueDraftSaveAsync"/>
                                                <div class="steam-writing-header-controls">
                                                    @RenderTextFormatControls(
                                                        WhatWorksBodyKey,
                                                        Draft.WhatWorksFormat,
                                                        Draft.WhatWorksHeading)
                                                    <button class="steam-remove-block"
                                                            type="button"
                                                            title="Remove What Works"
                                                            aria-label="Remove What Works"
                                                            @onclick="RemoveWhatWorksAsync">
                                                        ×
                                                    </button>
                                                </div>
                                            </div>
                                            @RenderFormattedBodyEditor(
                                                WhatWorksBodyKey,
                                                Draft.WhatWorks,
                                                Draft.WhatWorksFormat,
                                                "What Works content",
                                                "Write what works",
                                                nameof(Draft.WhatWorks),
                                                5)
                                        </div>
                                        </div>
                                    }

                                    @if (ShowDetailedQuestions &&
                                         Draft.IncludeWhatCouldBeBetter)
                                    {
                                        <div class="steam-removable-block">
                                        <div class="steam-writing-block">
                                            <div class="steam-writing-header">
                                                <input class="steam-inline-input steam-writing-heading-input"
                                                       type="text"
                                                       aria-label="What Could Be Better heading"
                                                       @bind="Draft.WhatCouldBeBetterHeading"
                                                       @bind:event="oninput"
                                                       @bind:after="QueueDraftSaveAsync"/>
                                                <div class="steam-writing-header-controls">
                                                    @RenderTextFormatControls(
                                                        WhatCouldBeBetterBodyKey,
                                                        Draft.WhatCouldBeBetterFormat,
                                                        Draft.WhatCouldBeBetterHeading)
                                                    <button class="steam-remove-block"
                                                            type="button"
                                                            title="Remove What Could Be Better"
                                                            aria-label="Remove What Could Be Better"
                                                            @onclick="RemoveWhatCouldBeBetterAsync">
                                                        ×
                                                    </button>
                                                </div>
                                            </div>
                                            @RenderFormattedBodyEditor(
                                                WhatCouldBeBetterBodyKey,
                                                Draft.WhatCouldBeBetter,
                                                Draft.WhatCouldBeBetterFormat,
                                                "What Could Be Better content",
                                                "Write what could be better",
                                                nameof(Draft.WhatCouldBeBetter),
                                                5)
                                        </div>
                                        </div>
                                    }

                                    @if (Draft.IncludeFinalThoughts)
                                    {
                                    <div class="steam-removable-block">
                                    <div class="steam-writing-block">
                                        <div class="steam-writing-header">
                                            <input class="steam-inline-input steam-writing-heading-input"
                                                   type="text"
                                                   aria-label="Final Thoughts heading"
                                                   @bind="Draft.FinalThoughtsHeading"
                                                   @bind:event="oninput"
                                                   @bind:after="QueueDraftSaveAsync"/>
                                            <div class="steam-writing-header-controls">
                                                @RenderTextFormatControls(
                                                    FinalThoughtsBodyKey,
                                                    Draft.FinalThoughtsFormat,
                                                    Draft.FinalThoughtsHeading)
                                                <button class="steam-remove-block"
                                                        type="button"
                                                        title="Remove final thoughts"
                                                        aria-label="Remove final thoughts"
                                                        @onclick="RemoveFinalThoughtsAsync">
                                                    ×
                                                </button>
                                            </div>
                                        </div>
                                        @RenderFormattedBodyEditor(
                                            FinalThoughtsBodyKey,
                                            Draft.FinalThoughts,
                                            Draft.FinalThoughtsFormat,
                                            "Final Thoughts content",
                                            "Write your final thoughts",
                                            nameof(Draft.FinalThoughts),
                                            6)
                                    </div>
                                    </div>
                                    }

                                    </div>
                                }
                            }
                            else
                            {
                                @RenderedPreview
                            }
                        </div>
                    </article>
                </div>
            </div>
        </aside>

        @if (IsStructuredMode)
        {
        <aside class="panel final-preview-panel steam-sized-preview-panel">
            <div class="panel-heading preview-panel-heading">
                <div>
                    <h2>Final Preview</h2>
                    <p>The read-only Steam post updates as you edit.</p>
                </div>

                <div class="preview-editor-actions">
                    <button class="button secondary"
                            type="button"
                            disabled="@(!HasBbCodeContent)"
                            aria-describedby="@(!HasBbCodeContent
                                                   ? "header-progress-status"
                                                   : null)"
                            @onclick="OpenBbCodeViewer">
                        View BBCode
                    </button>

                    <button class="button primary"
                            type="button"
                            disabled="@(!HasBbCodeContent)"
                            aria-describedby="@(!HasBbCodeContent
                                                   ? "header-progress-status"
                                                   : null)"
                            @onclick="CopyBbCode">
                        Copy BBCode
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_copyMessage))
            {
                <span class="copy-status preview-copy-status"
                      role="status"
                      aria-live="polite">
                    @_copyMessage
                </span>
            }

            @if (CurrentBbCodeAnalysis.HasWarnings)
            {
                @RenderBbCodeCompatibilityWarnings(
                    "final-preview-bbcode-compatibility")
            }

            <div class="steam-preview finalized"
                 aria-label="Final rendered review preview">
                <div class="steam-review-page">
                    <article class="steam-review-card">
                        <header class="steam-review-header">
                            <span class="@SteamRecommendationIconClass"
                                  aria-hidden="true">
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <path d="M8.35 20H4.5A1.5 1.5 0 0 1 3 18.5v-7A1.5 1.5 0 0 1 4.5 10h3.85v10Zm2-10 3.3-6.25c.3-.57.9-.9 1.54-.82a1.5 1.5 0 0 1 1.3 1.67L15.9 9h3.17a2 2 0 0 1 1.95 2.43l-1.47 6.5A2.65 2.65 0 0 1 16.96 20h-6.61V10Z"/>
                                </svg>
                            </span>

                            <span class="steam-review-verdict">
                                <strong>@RecommendationName</strong>
                                @if (!string.IsNullOrWhiteSpace(Draft.Playtime))
                                {
                                    <small>@SteamPlaytimeLabel</small>
                                }
                            </span>
                        </header>

                        <div class="steam-review-content">
                            @if (Draft.IsEarlyAccessReview)
                            {
                                <div class="steam-early-access-review">
                                    Early Access Review
                                </div>
                            }

                            <div class="steam-review-date">
                                Posted: @SteamPreviewDate
                            </div>

                            @if (Draft.ReceivedProductForFree)
                            {
                                <div class="steam-product-disclosure">
                                    Product received for free
                                </div>
                            }

                            @RenderedPreview
                        </div>
                    </article>
                </div>
            </div>
        </aside>
        }

        @if (ShouldShowBbCodeEditor)
        {
            <aside class="panel bbcode-panel">
                <div class="panel-heading output-panel-heading">
                    <div>
                        <h2>BBCode Editor</h2>
                        <p>Write or insert Steam BBCode here.</p>
                    </div>

                    <div class="output-panel-actions">
                        <button class="button secondary"
                                type="button"
                                disabled="@(!IsBbCodeEditorEditable)"
                                aria-describedby="@(!IsBbCodeEditorEditable
                                                       ? "bbcode-editor-lock-message"
                                                       : null)"
                                @onclick="UndoBbCodeAsync">
                            Undo
                        </button>
                        <button class="button danger"
                                type="button"
                                disabled="@(!IsBbCodeEditorEditable || string.IsNullOrEmpty(Draft.RawBbCode))"
                                title="@(string.IsNullOrEmpty(Draft.RawBbCode)
                                            ? "Nothing to clear"
                                            : !IsBbCodeEditorEditable
                                                ? "Return to Composer to clear BBCode"
                                                : "Clear all BBCode")"
                                aria-describedby="@(!IsBbCodeEditorEditable
                                                       ? "bbcode-editor-lock-message"
                                                       : null)"
                                @onclick="ClearBbCodeAsync">
                            Clear Code
                        </button>
                        <button class="button secondary"
                                type="button"
                                disabled="@(!HasBbCodeContent)"
                                aria-describedby="@(!HasBbCodeContent
                                                       ? "header-progress-status"
                                                       : null)"
                                @onclick="OpenBbCodeViewer">
                            View BBCode
                        </button>
                        <button class="button primary"
                                type="button"
                                disabled="@(!HasBbCodeContent)"
                                aria-describedby="@(!HasBbCodeContent
                                                       ? "header-progress-status"
                                                       : null)"
                                @onclick="CopyBbCode">
                            Copy BBCode
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_copyMessage))
                {
                    <span class="copy-status bbcode-copy-status"
                          role="status"
                          aria-live="polite">
                        @_copyMessage
                    </span>
                }

                @if (CurrentBbCodeAnalysis.HasWarnings)
                {
                    @RenderBbCodeCompatibilityWarnings("editor-bbcode-compatibility")
                }

                @if (IsGuidedBbCode &&
                     !IsBbCodeEditorEditable)
                {
                    <div id="bbcode-editor-lock-message"
                         class="bbcode-editor-lock-notice"
                         role="status"
                         aria-live="polite">
                        <strong>Editor locked</strong>
                        <span>@BbCodeEditorLockMessage</span>
                    </div>
                }

                <div class="@BbCodeEditorSurfaceClass">
                    <textarea id="raw-bbcode-editor"
                              class="code-output bbcode-editor"
                              rows="36"
                              readonly="@(!IsBbCodeEditorEditable)"
                              aria-label="Steam BBCode editor"
                              aria-describedby="@(IsGuidedBbCode &&
                                                   !IsBbCodeEditorEditable
                                                       ? "bbcode-editor-lock-message"
                                                       : null)"
                              placeholder="Write or paste Steam BBCode here…"
                              @onfocus="InitializeBbCodeUndoAsync"
                              @bind="Draft.RawBbCode"
                              @bind:event="oninput"
                              @bind:after="QueueDraftSaveAsync"></textarea>

                    @if (ShouldBlurBbCodeEditor)
                    {
                        <span class="bbcode-editor-locked-overlay"
                              aria-hidden="true">
                            Editor locked — complete setup
                        </span>
                    }
                </div>
            </aside>
        }
    </main>

    <footer class="app-footer">
        <strong>Unofficial community project.</strong>
        Steam Review Forge is not affiliated with, endorsed by, or sponsored
        by Valve Corporation or Steam.
    </footer>
    @if (_draftRecoveryData is not null)
    {
        <div class="modal-backdrop recovery-backdrop"
             role="presentation">
            <section class="confirmation-dialog recovery-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="draft-recovery-title"
                     aria-describedby="draft-recovery-description">
                <div class="dialog-content">
                    <h2 id="draft-recovery-title">
                        Saved draft needs recovery
                    </h2>
                    <p id="draft-recovery-description">
                        @_draftRecoveryMessage
                        Your saved data will not be overwritten until you reset it.
                    </p>

                    <label class="recovery-data-field">
                        <span>Saved draft backup</span>
                        <textarea readonly
                                  rows="8"
                                  aria-label="Saved draft backup data">@_draftRecoveryData</textarea>
                    </label>

                    @if (!string.IsNullOrWhiteSpace(_recoveryCopyMessage))
                    {
                        <span class="copy-status"
                              role="status"
                              aria-live="polite">
                            @_recoveryCopyMessage
                        </span>
                    }
                </div>

                <div class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CopyRecoveryDataAsync">
                        Copy saved data
                    </button>
                    <button class="button danger-solid"
                            type="button"
                            @onclick="ResetRecoveredDraftAsync">
                        Reset saved draft
                    </button>
                </div>
            </section>
        </div>
    }
    @if (_showModeSwitchDialog)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CancelEditorTypeSwitch">
            <section class="confirmation-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="mode-switch-dialog-title"
                     aria-describedby="mode-switch-dialog-description"
                     @onclick:stopPropagation>
                <div class="dialog-content">
                    <h2 id="mode-switch-dialog-title">
                        Start over in the other editor?
                    </h2>
                    <p id="mode-switch-dialog-description">
                        Structured review fields and freeform BBCode cannot be
                        converted back and forth safely. Switching editor type
                        starts a fresh review. Your current guidance choice is
                        preserved.
                    </p>
                </div>

                <div class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CancelEditorTypeSwitch">
                        Keep current review
                    </button>
                    <button class="button danger-solid"
                            type="button"
                            @onclick="ConfirmEditorTypeSwitchAsync">
                        Start fresh
                    </button>
                </div>
            </section>
        </div>
    }
    @if (_showNewReviewDialog)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseNewReviewDialog">

            <section class="confirmation-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="new-review-dialog-title"
                     aria-describedby="new-review-dialog-description"
                     @onclick:stopPropagation>

                <div class="dialog-content">
                    <h2 id="new-review-dialog-title">
                        Start a new review?
                    </h2>

                    <p id="new-review-dialog-description">
                        Your current saved draft will be permanently cleared.
                        This cannot be undone.
                    </p>
                </div>

                <div class="dialog-actions">
                    <button class="button secondary"
                            type="button"
                            @onclick="CloseNewReviewDialog">
                        Keep current review
                    </button>

                    <button class="button danger-solid"
                            type="button"
                            @onclick="ConfirmStartNewReviewAsync">
                        Start new review
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_showTableConfigurer)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseTableConfigurer">
            <section class="table-configurer-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="table-configurer-title"
                     @onclick:stopPropagation>
                <header class="table-configurer-header">
                    <div>
                        <span class="help-eyebrow">Rating table</span>
                        <h2 id="table-configurer-title">
                            Table Editor
                        </h2>
                    </div>

                    <button class="help-close"
                            type="button"
                            aria-label="Close Table Editor"
                            @onclick="CloseTableConfigurer">
                        ×
                    </button>
                </header>

                <div class="table-configurer-content">
                    <p>
                        Manage every part of the rating table here. Drag items
                        to reorder them, or use the controls on the right.
                    </p>

                    <div class="table-editor-toolbar">
                        <label class="table-editor-rating-system">
                            <span>Rating system</span>

                            <select value="@Draft.RatingSystem"
                                    @onchange="UpdateRatingSystemAsync">
                                <option value="@ReviewRatingSystem.TenPoint">
                                    1–10 Numbers
                                </option>

                                <option value="@ReviewRatingSystem.FivePoint">
                                    1–5 Numbers
                                </option>

                                <option value="@ReviewRatingSystem.FiveStars">
                                    1–5 Stars
                                </option>

                                <option value="@ReviewRatingSystem.Text">
                                    Text Rating
                                </option>
                            </select>
                        </label>

                        <div>
                            @RenderTableCellWidthToggle("Table Editor")

                            @foreach (var columnKind in MissingBuiltInColumns)
                            {
                                <button type="button"
                                        @onclick="() => AddColumnAsync(columnKind)">
                                    + @GetDefaultColumnHeading(columnKind)
                                </button>
                            }

                        </div>
                    </div>

                    <div class="steam-preview finalized table-editor-shell"
                         aria-label="Editable rating table">
                        <div class="steam-review-page">
                            <article class="steam-review-card">
                                <div class="steam-review-content">
                                    <div class="table-editor-scroll">
                                        <table class="@GetTableEditorClass()">
                                            <thead>
                                                <tr>
                                                    <th class="table-editor-row-number">
                                                        #
                                                    </th>

                                                    @foreach (var column in Draft.TableColumns)
                                                    {
                                                        <th class="@GetConfigurerColumnClass(column)"
                                                            @key="column.Id"
                                                            draggable="true"
                                                            data-table-drag-handle
                                                            title="Drag to reorder column"
                                                            data-drag-preview="column"
                                                            @ondragstart="() => BeginColumnDrag(column)"
                                                            @ondragend="EndColumnDrag"
                                                            @ondragover:preventDefault
                                                            @ondragenter="() => SetColumnDropTarget(column)"
                                                            @ondrop="() => DropColumnAsync(column)">
                                                            <span class="table-configurer-drag-rail horizontal"
                                                                  aria-hidden="true">
                                                            </span>

                                                            <input type="text"
                                                                   data-validation-field="@($"ColumnHeading:{column.Id}")"
                                                                   aria-label="@($"{GetColumnKindLabel(column.Kind)} column heading")"
                                                                   aria-invalid="@HasFieldError(
                                                                                     $"ColumnHeading:{column.Id}")"
                                                                   @bind="column.Heading"
                                                                   @bind:event="oninput"
                                                                   @bind:after="QueueDraftSaveAsync"/>

                                                            <div class="table-configurer-actions"
                                                                 role="group"
                                                                 aria-label="@($"{column.Heading} column actions")">
                                                                <button type="button"
                                                                        title="Move column left"
                                                                        aria-label="@($"Move {column.Heading} column left")"
                                                                        disabled="@(Draft.TableColumns.IndexOf(column) == 0)"
                                                                        @onclick="() => MoveColumnAsync(column, -1)">
                                                                    ←
                                                                </button>

                                                                <button type="button"
                                                                        title="Move column right"
                                                                        aria-label="@($"Move {column.Heading} column right")"
                                                                        disabled="@(Draft.TableColumns.IndexOf(column) ==
                                                                                    Draft.TableColumns.Count - 1)"
                                                                        @onclick="() => MoveColumnAsync(column, 1)">
                                                                    →
                                                                </button>

                                                                <button class="remove"
                                                                        type="button"
                                                                        title="Remove column"
                                                                        aria-label="@($"Remove {column.Heading} column")"
                                                                disabled="@(Draft.TableColumns.Count == 1)"
                                                                @onclick="() => RemoveColumnAsync(column)">
                                                                    Remove column
                                                                </button>
                                                            </div>
                                                        </th>
                                                    }

                                                    <th class="table-editor-actions-heading"
                                                        aria-label="Table actions">
                                                        <button type="button"
                                                                @onclick="() => AddColumnAsync(
                                                                                    ReviewTableColumnKind.CustomText)">
                                                            + Column
                                                        </button>

                                                        <button type="button"
                                                                data-validation-field="@nameof(Draft.Categories)"
                                                                @onclick="AddCategoryAsync">
                                                            + Row
                                                        </button>
                                                    </th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var category in Draft.Categories)
                                                {
                                                    <tr @key="category.Id"
                                                        class="@GetConfigurerRowClass(category)"
                                                        data-drag-preview="row"
                                                        @ondragover:preventDefault
                                                        @ondragenter="() => SetRowDropTarget(category)"
                                                        @ondrop="() => DropRowAsync(category)">
                                                        <th class="table-editor-row-number"
                                                            draggable="true"
                                                            data-table-drag-handle
                                                            title="Drag to reorder row"
                                                            aria-label="@($"Drag row {Draft.Categories.IndexOf(category) + 1}")"
                                                            @ondragstart="() => BeginRowDrag(category)"
                                                            @ondragend="EndRowDrag">
                                                            <span class="table-configurer-drag-rail"
                                                                  aria-hidden="true">
                                                            </span>

                                                            @(Draft.Categories.IndexOf(category) + 1)
                                                        </th>

                                                        @foreach (var column in Draft.TableColumns)
                                                        {
                                                            <td @key="column.Id">
                                                                @RenderConfigurerCell(
                                                                    category,
                                                                    column)
                                                            </td>
                                                        }

                                                        <td class="table-configurer-actions table-editor-row-actions"
                                                            aria-label="@($"{category.Name} row actions")">
                                                            <button type="button"
                                                                    title="Move row up"
                                                                    aria-label="@($"Move {category.Name} row up")"
                                                                    disabled="@(Draft.Categories.IndexOf(category) == 0)"
                                                                    @onclick="() => MoveCategoryAsync(category, -1)">
                                                                ↑
                                                            </button>

                                                            <button type="button"
                                                                    title="Move row down"
                                                                    aria-label="@($"Move {category.Name} row down")"
                                                                    disabled="@(Draft.Categories.IndexOf(category) ==
                                                                                Draft.Categories.Count - 1)"
                                                                    @onclick="() => MoveCategoryAsync(category, 1)">
                                                                ↓
                                                            </button>

                                                            <button class="remove"
                                                                    type="button"
                                                                    title="Remove row"
                                                                    aria-label="@($"Remove {category.Name} row")"
                                                                    @onclick="() => RemoveCategory(category)">
                                                                Remove row
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>

                <footer class="dialog-actions">
                    <button class="button primary"
                            type="button"
                            @onclick="CloseTableConfigurer">
                        Done
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_showResetTemplateDialog)
    {
        <div class="modal-backdrop"
             role="presentation"
             @onclick="CloseResetTemplateDialog">
            <section class="confirmation-dialog"
