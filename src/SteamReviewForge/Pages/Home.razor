    private string GetGuidedStructuredHeaderStepClass(
        BuilderStep step)
    {
        if (step == CurrentStep)
        {
            return "header-progress-item active";
        }

        if (step > CurrentStep)
        {
            return CurrentStep == BuilderStep.Setup ||
                   step != BuilderStep.Setup && !SetupComplete
                ? "header-progress-item blocked"
                : "header-progress-item available";
        }

        var section = GetValidationSection(step);

        if (section.HasValue &&
            CurrentValidation.HasErrors(section.Value))
        {
            return "header-progress-item error";
        }

        if (section.HasValue &&
            CurrentValidation.HasWarnings(section.Value))
        {
            return "header-progress-item warning";
        }

        return "header-progress-item complete";
    }

