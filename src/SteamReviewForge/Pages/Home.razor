    private async Task DuplicateReviewComponentAsync(
        ReviewContentComponent component)
    {
        var sourceIndex = Draft.Components.IndexOf(component);

        if (sourceIndex < 0)
        {
            return;
        }

        var duplicate = new ReviewContentComponent
        {
            Kind = component.Kind,
            Heading = component.Heading,
            Content = component.Content,
            ContentFormat = component.ContentFormat,
            Rating = component.Rating
        };

        Draft.Components.Insert(
            sourceIndex + 1,
            duplicate);

        await SaveDraftImmediatelyAsync();
    }

    private string GetReviewComponentsClass() =>
        Draft.Components.Count == 0
            ? "structured-review-components empty"
            : "structured-review-components";

    private string GetReviewComponentClass(
        ReviewContentComponent component)
    {
        var classes = new List<string>
        {
            "structured-review-component"
        };

        if (_draggedReviewComponentId == component.Id)
        {
            classes.Add("dragging");
        }

        if (GetReviewComponentIssues(component).Any(
                issue =>
                    issue.Severity ==
                    ReviewValidationSeverity.Error))
        {
            classes.Add("has-error");
        }

        return string.Join(' ', classes);
    }

    private IEnumerable<ReviewValidationIssue>
        GetReviewComponentIssues(
            ReviewContentComponent component) =>
        GetFieldIssues(GetComponentHeadingField(component))
            .Concat(GetFieldIssues(GetComponentContentField(component)))
            .Concat(GetFieldIssues(GetComponentRatingField(component)));

    private static string GetComponentHeadingField(
        ReviewContentComponent component) =>
        $"ComponentHeading:{component.Id}";

    private static string GetComponentContentField(
        ReviewContentComponent component) =>
        $"ComponentContent:{component.Id}";

    private static string GetComponentRatingField(
        ReviewContentComponent component) =>
        $"ComponentRating:{component.Id}";

