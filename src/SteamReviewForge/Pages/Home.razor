    private RenderFragment RenderHeaderProgressPath() =>
        @<nav class="header-progress"
              aria-label="@($"{EditingModeName} review path")">
            <ol class="header-progress-list">
                @if (Draft.EditingMode ==
                     ReviewEditingMode.GuidedStructured)
                {
                    @foreach (var step in Enum.GetValues<BuilderStep>())
                    {
                        var canOpen =
                            step == BuilderStep.Setup ||
                            CurrentStep != BuilderStep.Setup &&
                            SetupComplete;

                        <li class="@GetGuidedStructuredHeaderStepClass(step)">
                            <button class="header-progress-step"
                                    type="button"
                                    disabled="@(!canOpen)"
                                    aria-current="@(step == CurrentStep
                                                       ? "step"
                                                       : null)"
                                    aria-describedby="header-progress-status"
                                    @onclick="() => GoToStep(step)">
                                <span class="header-progress-node">
                                    @GetStepMarker(step)
                                </span>
                                <span class="header-progress-label">
                                    @GetBuilderStepName(step)
                                </span>
                            </button>
                        </li>
                    }
                }
                else if (IsGuidedBbCode)
                {
                    @foreach (var step in Enum.GetValues<BbCodeStep>())
                    {
                        <li class="@GetGuidedBbCodeHeaderStepClass(step)">
                            <button class="header-progress-step"
                                    type="button"
                                    disabled="@(!CanOpenBbCodeStep(step))"
                                    aria-current="@(step == CurrentBbCodeStep
                                                       ? "step"
                                                       : null)"
                                    aria-describedby="header-progress-status"
                                    @onclick="() => GoToBbCodeStepAsync(step)">
                                <span class="header-progress-node">
                                    @(step < CurrentBbCodeStep
                                        ? "✓"
                                        : ((int)step).ToString())
                                </span>
                                <span class="header-progress-label">
                                    @GetBbCodeStepName(step)
                                </span>
                            </button>
                        </li>
                    }
                }
                else if (IsUnguidedStructured)
                {
                    @for (var stage = 1; stage <= 3; stage++)
                    {
                        var pathStage = stage;

                        <li class="@GetUnguidedStructuredHeaderStepClass(pathStage)">
                            <div class="header-progress-step"
                                 aria-current="@(pathStage == UnguidedStructuredProgressStage
                                                    ? "step"
                                                    : null)">
                                <span class="header-progress-node">
                                    @(pathStage < UnguidedStructuredProgressStage
                                        ? "✓"
                                        : pathStage.ToString())
                                </span>
                                <span class="header-progress-label">
                                    @GetUnguidedStructuredStepName(pathStage)
                                </span>
                            </div>
                        </li>
                    }
                }
                else
                {
                    @for (var stage = 1; stage <= 2; stage++)
                    {
                        var pathStage = stage;

                        <li class="@GetUnguidedBbCodeHeaderStepClass(pathStage)">
                            <div class="header-progress-step"
                                 aria-current="@(pathStage == UnguidedBbCodeProgressStage
                                                    ? "step"
                                                    : null)">
                                <span class="header-progress-node">
                                    @(pathStage < UnguidedBbCodeProgressStage
                                        ? "✓"
                                        : pathStage.ToString())
                                </span>
                                <span class="header-progress-label">
                                    @(pathStage == 1
                                        ? "Write BBCode"
                                        : "Final Preview")
                                </span>
                            </div>
                        </li>
                    }
                }
            </ol>

            <div id="header-progress-status"
                 class="@HeaderProgressStatusClass"
                 role="status"
                 aria-live="polite">
                <span aria-hidden="true">
                    @(HeaderProgressHasBlocker ? "!" : "✓")
                </span>
                <span>@HeaderProgressMessage</span>
            </div>
        </nav>;

    private RenderFragment RenderBbCodeWorkflow() =>
        @<div class="workflow-editor bbcode-workflow">
            @if (IsGuidedBbCode)
            {
                <div class="workflow-editor-heading">
                    <h2>@GetBbCodeStepName(CurrentBbCodeStep)</h2>
                    <p>@GetBbCodeStepDescription(CurrentBbCodeStep)</p>
                </div>

                @if (CurrentBbCodeStep == BbCodeStep.Setup)
                {
                    @RenderRatingSystemEditor()
                }

                @if (CurrentBbCodeStep == BbCodeStep.Setup)
                {
                    <section class="editor-section">
                        <div class="@GetFieldClass(nameof(Draft.Recommendation))">
                            <label>Recommendation</label>
                            <div class="compact-choice-row"
                                 role="radiogroup"
                                 aria-label="Recommendation"
                                 data-validation-field="@nameof(Draft.Recommendation)">
                                <button class="@GetRecommendationChoiceClass(
                                                   ReviewRecommendation.Recommended)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(Draft.Recommendation ==
                                                          ReviewRecommendation.Recommended)"
                                        @onclick="() => SelectRecommendationAsync(
                                                            ReviewRecommendation.Recommended)">
                                    Recommended
                                </button>
                                <button class="@GetRecommendationChoiceClass(
                                                   ReviewRecommendation.NotRecommended)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(Draft.Recommendation ==
                                                          ReviewRecommendation.NotRecommended)"
                                        @onclick="() => SelectRecommendationAsync(
                                                            ReviewRecommendation.NotRecommended)">
                                    Not Recommended
                                </button>
                            </div>

                            @foreach (var issue in GetFieldIssues(
                                              nameof(Draft.Recommendation)))
                            {
                                <span class="@GetIssueClass(issue)">
                                    @issue.Message
                                </span>
                            }
                        </div>

                        <div class="field">
                            <label for="bbcode-playtime">Playtime</label>
                            <input id="bbcode-playtime"
                                   type="number"
                                   min="0"
                                   max="@PlaytimeFormatter.MaximumHours"
                                   step="0.1"
                                   inputmode="decimal"
                                   value="@Draft.Playtime"
                                   @oninput="UpdatePlaytimeAsync"/>
                        </div>

                        <div class="steam-metadata-options">
                            <label class="steam-checkbox">
                                <input type="checkbox"
                                       @bind="Draft.ReceivedProductForFree"
                                       @bind:after="QueueDraftSaveAsync"/>
                                <span>Product received for free</span>
                            </label>

                            <label class="steam-checkbox">
                                <input type="checkbox"
                                       @bind="Draft.IsEarlyAccessReview"
                                       @bind:after="QueueDraftSaveAsync"/>
                                <span>Early Access Review</span>
                            </label>
                        </div>

                        <div class="section-heading bbcode-start-heading">
                            <h3>
                                Choose a starting point
                                <span class="required-badge">Required</span>
                            </h3>
                            <p>
                                Select Blank document or a template before the
                                editor can be unlocked.
                            </p>
                        </div>

                        <div class="bbcode-start-grid"
                             role="radiogroup"
                             aria-label="BBCode starting point">
                            <button class="@($"{GetBbCodeStartClass(null)} featured")"
                                    type="button"
                                    role="radio"
                                    aria-checked="@(HasSelectedBbCodeStartingPoint &&
                                                      SelectedBbCodeTemplate is null
                                                          ? "true"
                                                          : "false")"
                                    @onclick="() => SelectBbCodeStartingPoint(null)">
                                <strong>Blank document</strong>
                                <span>Start with an empty BBCode editor.</span>
                            </button>

                            @foreach (var option in TemplateOptions)
                            {
                                <button class="@GetBbCodeStartClass(option.Template)"
                                        type="button"
                                        title="@option.Description"
                                        aria-label="@($"{option.Name}. {option.Description}")"
                                        role="radio"
                                        aria-checked="@(HasSelectedBbCodeStartingPoint &&
                                                          SelectedBbCodeTemplate == option.Template
                                                              ? "true"
                                                              : "false")"
                                        @onclick="() => SelectBbCodeStartingPoint(option.Template)">
                                    <strong>@option.Name</strong>
                                    <span>@option.Description</span>
                                </button>
                            }
                        </div>

                        <div id="bbcode-setup-requirements"
                             class="@BbCodeSetupStatusClass"
                             role="status"
                             aria-live="polite">
                            <strong>
                                @(CanOpenBbCodeComposer
                                    ? "Ready to open composer"
                                    : "Composer locked")
                            </strong>
                            <span>@BbCodeSetupRequirementMessage</span>
                        </div>
                    </section>
                }
                else if (CurrentBbCodeStep == BbCodeStep.Composer)
                {
                    <section class="editor-section bbcode-block-section">
                        <div class="section-heading">
                            <h3>Insert a BBCode block</h3>
                            <p>
                                Place the cursor in the editor, then insert a
                                template and replace its example text.
                            </p>
                        </div>

                        <div class="bbcode-block-grid">
                            @foreach (var block in BbCodeBlocks)
                            {
                                <button type="button"
                                        title="@block.Description"
                                        aria-label="@($"{block.Name}. {block.Description}")"
                                        @onclick="() => InsertBbCodeBlockAsync(block)">
                                    <strong>@block.Name</strong>
                                    <span>@block.Description</span>
                                </button>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <div class="final-preview-note">
                        Review the rendered post, then copy the BBCode when it
                        looks right.
                    </div>
                }

                <div class="step-navigation">
                    <button class="button secondary"
                            type="button"
                            disabled="@(CurrentBbCodeStep == BbCodeStep.Setup)"
                            @onclick="PreviousBbCodeStep">
                        Back
                    </button>

                    @if (CurrentBbCodeStep == BbCodeStep.Setup)
                    {
                        <button class="button primary"
                                type="button"
                                disabled="@(!CanOpenBbCodeComposer)"
                                aria-describedby="bbcode-setup-requirements"
                                @onclick="ApplyBbCodeStartingPointAsync">
                            Open composer
                        </button>
                    }
                    else if (CurrentBbCodeStep != BbCodeStep.FinalPreview)
                    {
                        <button class="button primary"
                                type="button"
                                disabled="@(string.IsNullOrWhiteSpace(
                                                Draft.RawBbCode))"
                                aria-describedby="@(string.IsNullOrWhiteSpace(
                                                        Draft.RawBbCode)
                                                       ? "header-progress-status"
                                                       : null)"
                                @onclick="NextBbCodeStep">
                            Next
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="workflow-editor-heading">
                    <h2>Raw BBCode Editor</h2>
                    <p>
                        Write or paste BBCode directly. The Steam preview
                        updates as you type.
                    </p>
                </div>

                <div class="format-editing-note">
                    Use Formatting help when you need Steam tag examples.
                    There are no steps or generated sections in this mode.
                </div>
            }
        </div>;

    private RenderFragment RenderBbCodeCompatibilityWarnings(
        string titleId) =>
        @<div class="bbcode-compatibility"
              role="region"
              aria-labelledby="@titleId"
              aria-live="polite">
            <strong id="@titleId">
                BBCode compatibility warnings
                (@CurrentBbCodeAnalysis.Diagnostics.Count)
            </strong>
            <ul>
                @foreach (var diagnostic in
                    CurrentBbCodeAnalysis.Diagnostics.Take(8))
                {
                    <li>
                        Line @diagnostic.Line, column @diagnostic.Column:
                        @diagnostic.Message
                    </li>
                }
            </ul>
            @if (CurrentBbCodeAnalysis.Diagnostics.Count > 8)
            {
                <span>
                    @(CurrentBbCodeAnalysis.Diagnostics.Count - 8)
                    additional warnings are not shown.
                </span>
            }
            <small>
                Copy remains available and your BBCode will not be rewritten.
            </small>
        </div>;

    private static string GetModeButtonClass(
        bool selected) =>
        selected
            ? "editor-mode-button selected"
            : "editor-mode-button";

    private string GetBbCodeStartClass(
        ReviewTemplate? template) =>
        HasSelectedBbCodeStartingPoint &&
        SelectedBbCodeTemplate == template
            ? "bbcode-start-card selected"
            : "bbcode-start-card";

    private void SelectBbCodeStartingPoint(
        ReviewTemplate? template)
    {
        SelectedBbCodeTemplate = template;
        HasSelectedBbCodeStartingPoint = true;
    }

    private bool CanOpenBbCodeComposer =>
        SetupComplete &&
        HasSelectedBbCodeStartingPoint;

    private string BbCodeSetupStatusClass =>
        CanOpenBbCodeComposer
            ? "bbcode-setup-status ready"
            : "bbcode-setup-status blocked";

    private string BbCodeSetupRequirementMessage =>
        !HasRecommendation &&
        !HasSelectedBbCodeStartingPoint
            ? "Choose a recommendation and select a starting point to unlock the editor."
            : !HasRecommendation
                ? "Choose a recommendation to unlock the editor."
                : !HasSelectedBbCodeStartingPoint
                    ? "Select Blank document or a template to unlock the editor."
                    : !SetupComplete
                        ? "Fix the highlighted setup field to unlock the editor."
                        : "Setup is complete. Open the composer to start editing.";

    private string BbCodeEditorLockMessage =>
        CurrentBbCodeStep == BbCodeStep.Setup
            ? $"{BbCodeSetupRequirementMessage} Then use Open composer to begin editing."
            : "The editor is locked while viewing Final Preview. Go back to Composer to make changes.";

    private bool CanOpenBbCodeStep(BbCodeStep step) =>
        step switch
        {
            BbCodeStep.Setup => true,
            BbCodeStep.Composer => CanOpenBbCodeComposer,
            BbCodeStep.FinalPreview =>
                SetupComplete &&
                !string.IsNullOrWhiteSpace(Draft.RawBbCode),
            _ => false
        };

    private string GetGuidedBbCodeHeaderStepClass(
        BbCodeStep step)
    {
        if (step == CurrentBbCodeStep)
        {
            return "header-progress-item active";
        }

        if (step < CurrentBbCodeStep)
        {
            return "header-progress-item complete";
        }

        return CanOpenBbCodeStep(step)
            ? "header-progress-item available"
            : "header-progress-item blocked";
    }

    private static string GetBbCodeStepName(
        BbCodeStep step) =>
        step switch
        {
            BbCodeStep.Setup => "Setup",
            BbCodeStep.Composer => "Composer",
            BbCodeStep.FinalPreview => "Final Preview",
            _ => "BBCode Editor"
        };

    private static string GetBbCodeStepDescription(
        BbCodeStep step) =>
        step switch
        {
            BbCodeStep.Setup =>
                "Set the required metadata and choose a starting point.",
            BbCodeStep.Composer =>
                "Build the review with editable BBCode blocks.",
            BbCodeStep.FinalPreview =>
                "Inspect the finished post before copying it.",
            _ => string.Empty
        };

    private async Task UpdateTemplateFromEventAsync(
        ChangeEventArgs eventArgs)
    {
        if (Enum.TryParse<ReviewTemplate>(
                eventArgs.Value?.ToString(),
                out var template))
        {
            await SelectTemplate(template);
        }
    }

    private RenderFragment RenderRatingSystemEditor() =>
        @<section class="persistent-rating-system">
            <div class="rating-system-heading">
                <strong>Rating system</strong>
                <span>Choose how category scores will appear.</span>
            </div>

            <div class="rating-system-choice-grid"
                 role="radiogroup"
                 aria-label="Rating system">
                @foreach (var ratingSystem in
                          Enum.GetValues<ReviewRatingSystem>())
                {
                    <button class="@GetRatingSystemCardClass(ratingSystem)"
                            type="button"
                            role="radio"
                            aria-checked="@(Draft.RatingSystem == ratingSystem
                                                ? "true"
                                                : "false")"
                            aria-label="@GetRatingSystemAccessibleName(ratingSystem)"
                            @onclick="() => SetRatingSystemAsync(ratingSystem)">
                        <span class="rating-system-example"
                              aria-hidden="true">
                            @if (ratingSystem == ReviewRatingSystem.FiveStars)
                            {
                                <span class="rating-system-stars">
                                    <span>★</span><span>★</span><span>★</span><span>★</span><span>☆</span>
                                </span>
                            }
                            else
                            {
                                @GetRatingSystemExample(ratingSystem)
                            }
                        </span>
                        <strong>@GetRatingSystemName(ratingSystem)</strong>
                        <small>@GetRatingSystemDescription(ratingSystem)</small>
                    </button>
                }
            </div>

            @if (Draft.RatingSystem ==
                 ReviewRatingSystem.Text)
            {
                <div class="text-rating-options">
                    <div class="text-rating-options-heading">
                        <strong>Text rating options</strong>

                        <button class="button secondary"
                                type="button"
                                data-validation-field="@nameof(Draft.TextRatingOptions)"
                                @onclick="AddTextRatingOptionAsync">
                            Add option
                        </button>
                    </div>

                    @for (var optionIndex = 0;
                          optionIndex <
                          Draft.TextRatingOptions.Count;
                          optionIndex++)
                    {
                        var index = optionIndex;

                        <div class="text-rating-option"
                             @key="index">
                            <input type="text"
                                   data-validation-field="@($"TextRatingOption:{index}")"
                                   aria-label="@($"Text rating option {index + 1}")"
                                   aria-invalid="@HasFieldError(
                                                     $"TextRatingOption:{index}")"
                                   value="@Draft.TextRatingOptions[index]"
                                   @oninput="eventArgs =>
                                       UpdateTextRatingOptionAsync(
                                           index,
                                           eventArgs)"/>

                            <button class="button danger"
                                    type="button"
                                    disabled="@(Draft.TextRatingOptions.Count <= 1)"
                                    aria-label="@($"Remove text rating option {index + 1}")"
                                    @onclick="() =>
                                        RemoveTextRatingOptionAsync(index)">
                                −
                            </button>

                            @foreach (var issue in GetFieldIssues(
                                              $"TextRatingOption:{index}"))
                            {
                                <span class="@GetIssueClass(issue)">
                                    @issue.Message
                                </span>
                            }
                        </div>
                    }
                </div>
            }
        </section>;

    private RenderFragment RenderConfigurerCell(
        ReviewCategory category,
        ReviewTableColumn column) =>
        @<div class="table-configurer-cell">
            @switch (column.Kind)
            {
                case ReviewTableColumnKind.Category:
                    <input type="text"
                           data-validation-field="@($"CategoryName:{category.Id}")"
                           aria-label="Category name"
                           aria-invalid="@HasFieldError(
                                             $"CategoryName:{category.Id}")"
                           @bind="category.Name"
                           @bind:event="oninput"
                           @bind:after="QueueDraftSaveAsync"/>
                    break;

                case ReviewTableColumnKind.Rating:
                    @RenderRatingEditor(category)
                    break;

                case ReviewTableColumnKind.Note:
                    <input type="text"
                           data-validation-field="@($"CategoryNote:{category.Id}")"
                           aria-label="@($"{category.Name} note")"
                           @bind="category.Note"
                           @bind:event="oninput"
                           @bind:after="QueueDraftSaveAsync"/>
                    break;

                case ReviewTableColumnKind.CustomText:
                    <input type="text"
                           aria-label="@($"{column.Heading} for {category.Name}")"
                           value="@GetCustomCellValue(category, column)"
                           @oninput="eventArgs =>
                               UpdateCustomCellAsync(
                                   category,
                                   column,
                                   eventArgs)"/>
                    break;
            }
        </div>;

    private RenderFragment RenderEditableTableCell(
        ReviewCategory category,
        ReviewTableColumn column) =>
        @<div class="steam-table-cell-editor">
            @switch (column.Kind)
            {
                case ReviewTableColumnKind.Category:
                    <div class="steam-category-inline-editor">
                        <input class="steam-inline-input steam-category-name"
                               type="text"
                               data-validation-field="@($"CategoryName:{category.Id}")"
                               aria-label="Category name"
                               aria-invalid="@HasFieldError($"CategoryName:{category.Id}")"
                               @bind="category.Name"
                               @bind:event="oninput"
                               @bind:after="QueueDraftSaveAsync"/>

                        @RenderCategoryControls(category, true)
                    </div>
                    break;

                case ReviewTableColumnKind.Rating:
                    @RenderRatingEditor(category)
                    break;

                case ReviewTableColumnKind.Note:
                    <input class="steam-inline-input"
                           type="text"
                           data-validation-field="@($"CategoryNote:{category.Id}")"
                           aria-label="@($"{category.Name} note")"
                           @bind="category.Note"
                           @bind:event="oninput"
                           @bind:after="QueueDraftSaveAsync"/>
                    break;

                case ReviewTableColumnKind.CustomText:
                    <input class="steam-inline-input"
                           type="text"
                           aria-label="@($"{column.Heading} for {category.Name}")"
                           value="@GetCustomCellValue(category, column)"
                           @oninput="eventArgs =>
                               UpdateCustomCellAsync(
                                   category,
                                   column,
                                   eventArgs)"/>
                    break;
            }
        </div>;

    private static string GetEditableTableColumnClass(
        ReviewTableColumn column)
    {
        return column.Kind switch
        {
            ReviewTableColumnKind.Category =>
                "steam-category-column",
            ReviewTableColumnKind.Rating =>
                "steam-rating-column",
            _ => string.Empty
        };
    }

    private RenderFragment RenderTableCellWidthToggle(
        string context) =>
        @<button class="table-cell-width-toggle"
                 type="button"
                 role="switch"
                 aria-checked="@(Draft.TableCellWidthMode ==
                                   ReviewTableCellWidthMode.Equal
                                       ? "true"
                                       : "false")"
                 aria-label="@($"{context} cell width mode: {TableCellWidthModeName}")"
                 title="@($"Cell widths: {TableCellWidthModeName}. Toggle between equal and content-based widths.")"
                 @onclick="ToggleTableCellWidthModeAsync">
            <span>Cell widths</span>
            <strong>@TableCellWidthModeName</strong>
        </button>;

    private string TableCellWidthModeName =>
        Draft.TableCellWidthMode == ReviewTableCellWidthMode.Equal
            ? "Equal"
            : "Auto";

    private string GetEditableRatingTableClass() =>
        Draft.TableCellWidthMode == ReviewTableCellWidthMode.Equal
            ? "preview-table steam-editable-table equal-cell-width"
            : "preview-table steam-editable-table automatic-cell-width";

    private string GetTableEditorClass() =>
        Draft.TableCellWidthMode == ReviewTableCellWidthMode.Equal
            ? "preview-table table-editor equal-cell-width"
            : "preview-table table-editor automatic-cell-width";

    private async Task ToggleTableCellWidthModeAsync()
    {
        Draft.TableCellWidthMode =
            Draft.TableCellWidthMode == ReviewTableCellWidthMode.Equal
                ? ReviewTableCellWidthMode.Automatic
                : ReviewTableCellWidthMode.Equal;

        await SaveDraftImmediatelyAsync();
    }

    private RenderFragment RenderRatingEditor(
        ReviewCategory category) =>
        @<div class="steam-rating-editor"
              aria-label="@($"{category.Name} rating")">
            @if (Draft.RatingSystem ==
                 ReviewRatingSystem.Text)
            {
                <select class="steam-rating-select"
                        aria-label="@($"{category.Name} text rating")"
                        value="@category.Rating"
                        @onchange="eventArgs =>
                            SetCategoryRatingFromEventAsync(
                                category,
                                eventArgs)">
                    @foreach (var score in Enumerable.Range(
                                      1,
                                      RatingMaximum))
                    {
                        <option value="@score">
                            @GetTextRating(score)
                        </option>
                    }
                </select>
            }
            else if (Draft.RatingSystem ==
                     ReviewRatingSystem.FiveStars)
            {
                <div class="steam-rating-choices"
                     role="radiogroup"
                     aria-label="@($"{category.Name} rating")">
                    @foreach (var score in Enumerable.Range(1, 5))
                    {
                        <button class="@GetRatingChoiceClass(
                                           category.Rating,
                                           score)"
                                type="button"
                                role="radio"
                                aria-checked="@(category.Rating == score)"
                                aria-label="@($"Set {category.Name} rating to {score} out of 5")"
                                @onclick="() => SetCategoryRatingAsync(
                                                    category,
                                                    score)">
                            ★
                        </button>
                    }
                </div>
            }
            else
            {
                <input class="steam-rating-number-input"
                       type="number"
                       min="1"
                       max="@RatingMaximum"
                       step="1"
                       inputmode="numeric"
                       aria-label="@($"{category.Name} rating from 1 to {RatingMaximum}")"
                       value="@category.Rating"
                       @oninput="eventArgs =>
                           SetCategoryRatingFromEventAsync(
                               category,
                               eventArgs)"/>
            }
        </div>;

    private RenderFragment RenderComponentRatingEditor(
        ReviewContentComponent component) =>
        @<div class="steam-rating-editor"
              data-validation-field="@GetComponentRatingField(component)"
              aria-invalid="@(HasFieldError(GetComponentRatingField(component))
                                  ? "true"
                                  : "false")"
              aria-label="@($"{component.Heading} rating")">
            @if (Draft.RatingSystem == ReviewRatingSystem.Text)
            {
                <select class="steam-rating-select"
                        aria-label="@($"{component.Heading} text rating")"
                        value="@component.Rating"
                        @onchange="eventArgs => SetReviewComponentRatingFromEventAsync(component, eventArgs)">
                    @foreach (var score in Enumerable.Range(1, RatingMaximum))
                    {
                        <option value="@score">@GetTextRating(score)</option>
                    }
                </select>
            }
            else if (Draft.RatingSystem == ReviewRatingSystem.FiveStars)
            {
                <div class="steam-rating-choices"
                     role="radiogroup"
                     aria-label="@($"{component.Heading} rating")">
                    @foreach (var score in Enumerable.Range(1, 5))
                    {
                        <button class="@GetRatingChoiceClass(component.Rating, score)"
                                type="button"
                                role="radio"
                                aria-checked="@(component.Rating == score)"
                                aria-label="@($"Set {component.Heading} rating to {score} out of 5")"
                                @onclick="() => SetReviewComponentRatingAsync(component, score)">
                            ★
                        </button>
                    }
                </div>
            }
            else
            {
                <input class="steam-rating-number-input"
                       type="number"
                       min="1"
                       max="@RatingMaximum"
                       step="1"
                       inputmode="numeric"
                       aria-label="@($"{component.Heading} rating from 1 to {RatingMaximum}")"
                       value="@component.Rating"
                       @oninput="eventArgs => SetReviewComponentRatingFromEventAsync(component, eventArgs)"/>
            }
        </div>;

    private RenderFragment RenderTextFormatControls(
        string bodyKey,
        ReviewTextFormat format,
        string heading) =>
        @<div class="steam-text-format-controls"
              role="group"
              aria-label="@($"{heading} body format options")">
